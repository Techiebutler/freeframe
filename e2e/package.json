{
  "name": "freeframe-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Real-browser end-to-end tests for FreeFrame. Standalone: nothing in apps/web depends on this package.",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:webkit": "playwright test --project=webkit",
    "test:firefox": "playwright test --project=firefox",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "playwright": "1.64.1",
    "typescript": "^5.6.0"
  }
}
