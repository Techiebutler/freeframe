#!/usr/bin/env bash
# ============================================================
# freeframe: install and look after FreeFrame on this server.
#
#   sudo freeframe install     set up FreeFrame on a fresh server
#   sudo freeframe update      move to the newest release (backs up first)
#   sudo freeframe rollback    go back after an update that did not come up
#   sudo freeframe status      see whether everything is running
#   sudo freeframe uninstall   remove FreeFrame (backs up first, keeps the data)
#   sudo freeframe help        list every command
#
# Everything lives in /opt/freeframe: the compose files, the settings file
# .env.prod (private, holds generated passwords), backups/ and install.log.
#
# This file can be sourced without side effects (the tests in deploy/tests do
# that); it only runs when executed. Strict mode (set -Eeuo pipefail) is turned
# on at the bottom, only when executed, so sourcing never changes the caller's
# shell options. Every function below is written to work under strict mode.
# ============================================================

# Marks this file as the freeframe management script: `freeframe update`
# installs a download only when it carries this line (and cmd_update).
FF_SCRIPT_KIND=freeframe-management-script

# ------------------------------------------------------------
# Messages
# ------------------------------------------------------------

warn() { printf '%s\n' "$*" >&2; }

ff_root() { printf '%s' "${FF_ROOT:-/opt/freeframe}"; }

# ------------------------------------------------------------
# .env.prod reading and writing
#
# Values are written as KEY=VALUE, unquoted. The one exception is a value that
# docker compose would change when it reads the file: compose expands $NAME,
# drops " #..." as a comment and trims spaces in unquoted values. Such a value
# (typically a typed SMTP or storage password) is written single-quoted, or
# double-quoted with \ " $ escaped when it contains ' or \, so compose hands
# the container exactly what was typed (deploy/tests/compose.bats proves it
# against the real docker compose).
# ------------------------------------------------------------

_env_key_ok() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; }

# _env_decode RAW: the value compose sees for the text after "KEY=".
_env_decode() {
  local raw=$1 out="" c i=0
  raw=${raw#"${raw%%[![:space:]]*}"}
  case $raw in
    \'*)
      raw=${raw#\'}
      printf '%s' "${raw%%\'*}"
      ;;
    \"*)
      raw=${raw#\"}
      while ((i < ${#raw})); do
        c=${raw:i:1}
        if [[ $c == "\\" ]] && ((i + 1 < ${#raw})); then
          out+=${raw:i+1:1}
          i=$((i + 2))
          continue
        fi
        [[ $c == '"' ]] && break
        out+=$c
        i=$((i + 1))
      done
      printf '%s' "$out"
      ;;
    *)
      raw=${raw%%[[:space:]]#*}
      raw=${raw%"${raw##*[![:space:]]}"}
      printf '%s' "$raw"
      ;;
  esac
}

# _env_encode VALUE: the text to write after "KEY=". Single quotes are used
# only when the value has neither ' nor \: compose reads \' as an escaped
# quote even inside single quotes, so 'end\' would be unterminated. Anything
# with ' or \ is double-quoted with \ " $ escaped. Fails (2) for a value
# that also contains a backtick: compose keeps \` as two characters, so no
# escaping keeps it literal for both compose and a shell.
_env_encode() {
  local v=$1
  case $v in
    *[[:space:]\$\#\"\\\`]* | \'*) ;;
    *)
      printf '%s' "$v"
      return 0
      ;;
  esac
  if [[ $v != *\'* && $v != *\\* ]]; then
    printf "'%s'" "$v"
    return 0
  fi
  [[ $v != *\`* ]] || return 2
  v=${v//\\/\\\\}
  v=${v//\"/\\\"}
  v=${v//\$/\\\$}
  printf '"%s"' "$v"
}

# _env_key_re KEY: the pattern for a line that sets KEY. Like compose, a line
# may be indented and may start with "export " (measured: compose reads
# "export A=x" and "   B=y" as A and B).
_env_key_re() { printf '^[[:space:]]*(export[[:space:]]+)?%s=' "$1"; }

# env_get FILE KEY: print the value of KEY (empty when absent). The last line
# setting KEY wins, as in compose.
env_get() {
  local file=$1 key=$2 line re raw="" found=0
  [[ -f $file ]] || return 0
  _env_key_ok "$key" || return 0
  re=$(_env_key_re "$key")
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    if [[ $line =~ $re ]]; then
      raw=${line:${#BASH_REMATCH[0]}}
      found=1
    fi
  done <"$file"
  ((found)) || return 0
  _env_decode "$raw"
}

# _env_write FILE KEY VALUE missing|always
_env_write() {
  local file=$1 key=$2 value=$3 mode=$4 enc line re prefix="" tmp idx=-1 i=0
  local -a lines=()
  if ! _env_key_ok "$key"; then
    warn "Cannot save the setting '$key': that is not a valid setting name."
    return 1
  fi
  if [[ $value == *$'\n'* || $value == *$'\r'* ]]; then
    warn "Cannot save $key: the value contains a line break."
    warn "What to try: type the value again on a single line."
    return 1
  fi
  if ! enc=$(_env_encode "$value"); then
    warn "Cannot save $key: the value contains a backtick (\`) together with ' or \\, which the settings file cannot hold safely."
    warn "What to try: choose a value without the backtick."
    return 1
  fi
  if [[ $mode == missing ]]; then
    [[ -n $value ]] || return 0
    [[ -z $(env_get "$file" "$key") ]] || return 0
  fi
  if [[ ! -e $file ]]; then
    (umask 077 && : >"$file") || return 1
  fi
  # The settings file holds secrets: owner-only on every write, also for a
  # file that was created empty or copied in with wider permissions.
  if ! chmod 600 "$file"; then
    warn "Cannot make $file private (chmod 600 failed)."
    return 1
  fi
  re=$(_env_key_re "$key")
  while IFS= read -r line || [[ -n $line ]]; do
    lines+=("$line")
    if [[ ${line%$'\r'} =~ $re ]]; then
      idx=$i
      prefix=${BASH_REMATCH[0]}
    fi
    i=$((i + 1))
  done <"$file"
  if ((idx < 0)); then
    # Append, after making sure the last line is finished.
    if [[ -s $file && -n $(tail -c 1 "$file") ]]; then
      printf '\n' >>"$file"
    fi
    printf '%s=%s\n' "$key" "$enc" >>"$file"
    return 0
  fi
  # Keep the line's own indentation and "export " prefix.
  lines[idx]="$prefix$enc"
  # Write a copy beside the file (same mode and owner via cp -p), then rename
  # it over the original, so a crash never leaves a half-written file.
  tmp=$(mktemp "$file.tmp.XXXXXX") || return 1
  if ! { cp -p "$file" "$tmp" && printf '%s\n' "${lines[@]}" >"$tmp" && mv -f "$tmp" "$file"; }; then
    rm -f "$tmp"
    return 1
  fi
}

# env_set_if_missing FILE KEY VALUE: write only when KEY is absent or empty.
# Returns 0 when nothing needed writing or the write worked, 1 when the write
# failed. An empty VALUE writes nothing. Every write leaves FILE mode 600.
env_set_if_missing() { _env_write "$1" "$2" "$3" missing; }

# env_set FILE KEY VALUE: overwrite KEY (used only by `configure`).
env_set() { _env_write "$1" "$2" "$3" always; }

# env_backup FILE: copy FILE to FILE.<YYYYmmdd-HHMMSS> (mode 600) and print
# that path. A second backup within the same second gets a -1, -2, ... suffix.
env_backup() {
  local file=$1 stamp dest n=1
  if [[ ! -f $file ]]; then
    warn "Cannot back up $file: the file does not exist."
    return 1
  fi
  stamp=$(date +%Y%m%d-%H%M%S)
  dest="$file.$stamp"
  while [[ -e $dest ]]; do
    dest="$file.$stamp-$n"
    n=$((n + 1))
  done
  (umask 077 && cp -p "$file" "$dest") || return 1
  chmod 600 "$dest" || return 1
  printf '%s\n' "$dest"
}

# gen_secret BYTES: BYTES random bytes as lowercase hex (openssl rand -hex).
# openssl is on every supported server; the /dev/urandom fallback only keeps
# the function working where it is missing (the bats test image).
gen_secret() {
  local bytes=${1:-32}
  [[ $bytes =~ ^[1-9][0-9]*$ ]] || return 1
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$bytes"
    return
  fi
  od -An -v -tx1 -N "$bytes" /dev/urandom | tr -d ' \n'
  printf '\n'
}

# ------------------------------------------------------------
# Server facts
# ------------------------------------------------------------

# is_public_ipv4 IP: 0 for a public address. Private (10/8, 172.16/12,
# 192.168/16), loopback, link-local, CGNAT (100.64/10), "this network" (0/8),
# multicast and reserved (224/4 and up) and malformed input are not public.
is_public_ipv4() {
  local ip=${1:-} o a b
  [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  a=$((10#${BASH_REMATCH[1]}))
  b=$((10#${BASH_REMATCH[2]}))
  for o in "${BASH_REMATCH[@]:1}"; do
    # No leading zeros: 010 means 8 to some tools and 10 to others.
    [[ $o == 0 || $o != 0* ]] || return 1
    ((10#$o <= 255)) || return 1
  done
  ((a == 0 || a == 10 || a == 127 || a >= 224)) && return 1
  ((a == 100 && b >= 64 && b <= 127)) && return 1
  ((a == 169 && b == 254)) && return 1
  ((a == 172 && b >= 16 && b <= 31)) && return 1
  ((a == 192 && b == 168)) && return 1
  return 0
}

# valid_hostname NAME: 0 for a plain host name such as review.yourstudio.com:
# labels of letters, digits and hyphens (1 to 63 characters, no hyphen at
# either end) joined by single dots, at most 253 characters in all. No scheme,
# port, path, spaces, backticks or trailing dot. An IPv4 address also passes.
# The one validator for every host a person types (derive_env, prompts).
valid_hostname() {
  local name=${1:-} label='[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
  ((${#name} >= 1 && ${#name} <= 253)) || return 1
  [[ $name =~ ^$label(\.$label)*$ ]]
}

# sslip_host IP: the free automatic address for IP, 1-2-3-4.sslip.io.
sslip_host() { printf '%s.sslip.io\n' "${1//./-}"; }

# os_supported ID VERSION_ID: 0 for the systems the installer supports.
os_supported() {
  case "${1:-}:${2:-}" in
    ubuntu:22.04 | ubuntu:24.04 | ubuntu:26.04 | debian:12 | debian:13) return 0 ;;
    *) return 1 ;;
  esac
}

# dns_points_here NAME IP: 0 when NAME resolves (IPv4) to IP.
dns_points_here() {
  local name=$1 ip=$2 out addr
  out=$(getent ahostsv4 "$name" 2>/dev/null) || return 1
  while read -r addr _; do
    [[ $addr == "$ip" ]] && return 0
  done <<<"$out"
  return 1
}

# _ff_freeframe_services "SVC SVC ...": 0 when at least three FreeFrame
# service names are present (api, worker, email_worker, maintenance_worker,
# beat, web).
_ff_freeframe_services() {
  local s n=0
  for s in api worker email_worker maintenance_worker beat web; do
    [[ " $1 " == *" $s "* ]] && n=$((n + 1))
  done
  ((n >= 3))
}

# detect_foreign_install: 0 when this server runs (or holds the database of) a
# FreeFrame this script does not manage, for example a clone-and-build install.
# 1 when there is none. 2 when Docker is installed but does not answer, so the
# answer is unknown (callers must not treat that as "none").
#
# Ours: compose containers whose working directory is $FF_ROOT. Foreign:
#   - any other container running a FreeFrame image (name contains
#     "freeframe", which covers ghcr.io/techiebutler/freeframe-* and the
#     freeframe-api style names a clone named freeframe builds), or
#   - a *_pgdata volume whose project has FreeFrame services (a clone in a
#     renamed folder), or
#   - a freeframe_pgdata volume left behind by a stopped clone, when this
#     script has no settings file yet: our project is also called freeframe,
#     so installing would silently take over that database volume, or
#   - a git checkout in $FF_ROOT itself.
# FF_FOREIGN_WHY says which: git, container, clone-volume, or own-volume
# when nothing but a freeframe_pgdata volume without the settings file was
# found (which is also what an uninstall that kept the data leaves).
detect_foreign_install() {
  local root ps vols line proj wd svc image rest name own=0
  local -A ours=() services=()
  root=$(ff_root)
  FF_FOREIGN_WHY=""
  if [[ -d $root/.git ]]; then
    FF_FOREIGN_WHY=git
    return 0
  fi
  command -v docker >/dev/null 2>&1 || return 1
  local tab=$'\t'
  if ! ps=$(docker ps -a --format "{{.Label \"com.docker.compose.project\"}}${tab}{{.Label \"com.docker.compose.project.working_dir\"}}${tab}{{.Label \"com.docker.compose.service\"}}${tab}{{.Image}}" 2>/dev/null) ||
    ! vols=$(docker volume ls --format "{{.Name}}${tab}{{.Label \"com.docker.compose.project\"}}" 2>/dev/null); then
    warn "Docker is installed but did not answer, so the installer cannot check for an existing FreeFrame."
    warn "What to try: sudo systemctl start docker, then run the command again."
    return 2
  fi
  # Fields are split by hand: read with IFS=tab would merge empty fields.
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    proj=${line%%"$tab"*}
    rest=${line#*"$tab"}
    wd=${rest%%"$tab"*}
    rest=${rest#*"$tab"}
    svc=${rest%%"$tab"*}
    image=${rest#*"$tab"}
    if [[ -n $proj && $wd == "$root" ]]; then
      ours[$proj]=1
      continue
    fi
    if [[ ${image,,} == *freeframe* ]]; then
      FF_FOREIGN_WHY=container
      return 0
    fi
    [[ -n $proj ]] && services[$proj]+=" $svc"
  done <<<"$ps"
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    name=${line%%"$tab"*}
    proj=""
    [[ $line == *"$tab"* ]] && proj=${line#*"$tab"}
    [[ $name == *_pgdata ]] || continue
    proj=${proj:-${name%_pgdata}}
    [[ -n ${ours[$proj]:-} ]] && continue
    if _ff_freeframe_services "${services[$proj]:-}"; then
      FF_FOREIGN_WHY="clone-volume"
      return 0
    fi
    if [[ $proj == freeframe && ! -e $root/.env.prod ]]; then own=1; fi
  done <<<"$vols"
  if ((own)); then
    FF_FOREIGN_WHY="own-volume"
    return 0
  fi
  return 1
}

# _ff_pgdata_kept: 0 when FreeFrame's database volume (freeframe_pgdata)
# is on this server, as an uninstall that kept the data leaves it.
_ff_pgdata_kept() {
  command -v docker >/dev/null 2>&1 || return 1
  timeout -k 5 "${FF_DOCKER_INFO_TIMEOUT:-20}" docker volume inspect freeframe_pgdata >/dev/null 2>&1
}

# ------------------------------------------------------------
# Answers: flags, environment variables and prompts
# ------------------------------------------------------------

# The answers, as FF_<NAME>, each seeded from FREEFRAME_<NAME>.
_ff_answer_names() {
  printf '%s\n' DOMAIN HTTPS ACME_EMAIL STORAGE S3_ENDPOINT S3_BUCKET S3_ACCESS_KEY \
    S3_SECRET_KEY S3_REGION SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASSWORD SMTP_FROM \
    ADMIN_NAME ADMIN_EMAIL ADMIN_PASSWORD CHANNEL GPU
}

_ff_bad_usage() {
  warn "$1"
  warn "What to try: run $(_ff_help_cmd) to see the commands and options."
  exit 2
}

# _ff_cmd_installed: 0 when the freeframe command is on this server (after
# an install went ahead). Before that the person is running the one-line
# install command, and hints must name that instead.
_ff_cmd_installed() { [[ -x ${FF_BIN_DIR:-/usr/local/bin}/freeframe ]]; }

# _ff_bootstrap_cmd ARGS: the one-line install command for this run's
# channel (ff_channel: --channel, else the settings file's, else latest),
# passing ARGS on to freeframe install. It is the bash -c form, which works
# with every sudo (a piped script cannot ask questions under sudo-rs); the
# word after the script is its name, hence install. FREEFRAME_CHANNEL is
# named for any channel but latest: install.sh cannot see its own address.
# shellcheck disable=SC2016
_ff_bootstrap_cmd() {
  local ch env=""
  ch=$(ff_channel "$(ff_root)/.env.prod")
  _ff_valid_ref "$ch" || ch=latest
  [[ $ch == latest ]] || env="FREEFRAME_CHANNEL=$ch "
  printf 'sudo %sbash -c "$(curl -fsSL %s/%s/install.sh)" install %s' "$env" "$FF_RAW_BASE" "$ch" "$*"
}

# _ff_valid_ref REF: 0 for a usable branch or tag name (stable, latest,
# v1.22.0), never a path that climbs out of the repository.
_ff_valid_ref() { [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ && $1 != *..* ]]; }

# ff_channel FILE: the channel (branch or tag) this run uses, one rule for
# every command and for the freeframe command and the setup files alike:
# --channel (or FREEFRAME_CHANNEL) when given, otherwise FREEFRAME_CHANNEL in
# FILE, otherwise latest (the ref the one-line install command uses).
ff_channel() {
  local ch=${FF_CHANNEL:-}
  [[ -n $ch ]] || ch=$(env_get "$1" FREEFRAME_CHANNEL)
  printf '%s' "${ch:-latest}"
}

# _ff_check_channel CH: stop (exit 2) when CH is not a branch or tag name.
_ff_check_channel() {
  if ! _ff_valid_ref "$1"; then
    _ff_stop 2 "The channel '$1' is not a branch or tag name such as stable or latest." "use --channel stable or --channel latest."
  fi
}

# ff_channel_saved FILE: the channel FILE keeps, ignoring --channel.
ff_channel_saved() {
  local ch
  ch=$(env_get "$1" FREEFRAME_CHANNEL)
  printf '%s' "${ch:-latest}"
}

# ff_save_channel FILE CH: make CH the channel saved in FILE (an explicit
# --channel wins), backing FILE up first. Does nothing when it is already.
ff_save_channel() {
  local file=$1 ch=$2 backup
  [[ $(env_get "$file" FREEFRAME_CHANNEL) != "$ch" ]] || return 0
  backup=$(env_backup "$file") || return 1
  env_set "$file" FREEFRAME_CHANNEL "$ch" || return 1
  say "The channel is now $ch (the previous settings are saved in $backup)."
}

# _ff_help_cmd: the command that lists the commands and options.
_ff_help_cmd() {
  if _ff_cmd_installed; then printf "'freeframe help'"; else printf '%s' "$(_ff_bootstrap_cmd --help)"; fi
}

# FF_YES and the other answers are read by the subcommands, not here.
# shellcheck disable=SC2034
# parse_args "$@": sets FF_CMD (help when none), FF_ARGS (words after the
# command), FF_YES, FF_QUIET (-q/--quiet, for the nightly backup), the
# uninstall switches (FF_DRY_RUN, FF_DELETE_DATA, FF_CONFIRM_DELETE_DATA,
# FF_SKIP_BACKUP) and the FF_* answers. Flags win over FREEFRAME_* variables.
# Accepts --flag value and --flag=value. Unknown flags exit 2.
parse_args() {
  local name env arg flag val have_val
  local -a names=()
  read -ra names <<<"$(_ff_answer_names | tr '\n' ' ')"
  for name in "${names[@]}"; do
    env="FREEFRAME_$name"
    printf -v "FF_$name" '%s' "${!env:-}"
  done
  case "${FREEFRAME_YES:-}" in
    1 | [Tt]rue | TRUE | [Yy]es | YES | [Yy]) FF_YES=1 ;;
    *) FF_YES="" ;;
  esac
  FF_CMD=""
  FF_ARGS=()
  FF_QUIET=""
  FF_DRY_RUN="" FF_DELETE_DATA="" FF_CONFIRM_DELETE_DATA="" FF_SKIP_BACKUP=""
  while (($#)); do
    arg=$1
    shift
    case $arg in
      --)
        for arg in "$@"; do
          if [[ -z $FF_CMD ]]; then FF_CMD=$arg; else FF_ARGS+=("$arg"); fi
        done
        break
        ;;
      -y | --yes) FF_YES=1 ;;
      -q | --quiet) FF_QUIET=1 ;;
      -h | --help) FF_CMD=help ;;
      --dry-run) FF_DRY_RUN=1 ;;
      --delete-data) FF_DELETE_DATA=1 ;;
      --confirm-delete-data) FF_CONFIRM_DELETE_DATA=1 ;;
      --skip-backup) FF_SKIP_BACKUP=1 ;;
      --*)
        have_val=0
        if [[ $arg == *=* ]]; then
          flag=${arg%%=*}
          val=${arg#*=}
          have_val=1
        else
          flag=$arg
        fi
        name=${flag#--}
        name=${name^^}
        name=${name//-/_}
        [[ " ${names[*]} " == *" $name "* ]] || _ff_bad_usage "Unknown option: $flag"
        if ((!have_val)); then
          (($#)) || _ff_bad_usage "The option $flag needs a value, for example $flag=something"
          val=$1
          shift
        fi
        printf -v "FF_$name" '%s' "$val"
        ;;
      -*) _ff_bad_usage "Unknown option: $arg" ;;
      *)
        if [[ -z $FF_CMD ]]; then FF_CMD=$arg; else FF_ARGS+=("$arg"); fi
        ;;
    esac
  done
  [[ -n $FF_CMD ]] || FF_CMD=help
}

_ff_tty_path() { printf '%s' "${FF_TTY:-/dev/tty}"; }

# _ff_has_tty: 0 when the terminal (or FF_TTY) can be opened for reading.
_ff_has_tty() {
  local t
  t=$(_ff_tty_path)
  [[ -r $t ]] || return 1
  { true <"$t"; } 2>/dev/null
}

# _ff_tty_open: open the terminal (${FF_TTY:-/dev/tty}) once, on the fd in
# _FF_TTY_FD, and keep it open, so successive reads get successive lines.
_ff_tty_open() {
  local tty
  tty=$(_ff_tty_path)
  [[ ${_FF_TTY_OPEN:-} == "$tty" ]] && return 0
  _ff_has_tty || return 1
  { exec {_FF_TTY_FD}<"$tty"; } 2>/dev/null || return 1
  _FF_TTY_OPEN=$tty
}

# ask VAR QUESTION DEFAULT: print QUESTION, read one line from the terminal
# (${FF_TTY:-/dev/tty}), trim spaces, and store it in VAR, or DEFAULT when the
# line is empty. Fails when there is no terminal or the input has ended.
# The terminal is opened once and kept open, so successive calls read
# successive lines.
ask() {
  local var=$1 question=$2 default=${3:-} line=""
  _ff_tty_open || return 1
  if [[ -n $default ]]; then
    printf '%s %s: ' "$question" "$(_ff_style 2 "[$default]")" >&2
  else
    printf '%s: ' "$question" >&2
  fi
  if ! IFS= read -r -u "$_FF_TTY_FD" line && [[ -z $line ]]; then
    printf '\n' >&2
    return 1
  fi
  line=${line%$'\r'}
  line=${line#"${line%%[![:space:]]*}"}
  line=${line%"${line##*[![:space:]]}"}
  [[ -n $line ]] || line=$default
  printf -v "$var" '%s' "$line"
}

# ask_secret VAR QUESTION: like ask, but what is typed is not shown and not
# trimmed (spaces in a password are kept). Fails when the input has ended.
ask_secret() {
  local var=$1 question=$2 line=""
  _ff_tty_open || return 1
  printf '%s: ' "$question" >&2
  if ! IFS= read -r -s -u "$_FF_TTY_FD" line && [[ -z $line ]]; then
    printf '\n' >&2
    return 1
  fi
  printf '\n' >&2
  printf -v "$var" '%s' "${line%$'\r'}"
}

# confirm QUESTION Y|N: ask a yes/no question; Enter means the default.
# 0 for yes. The input ending counts as no.
confirm() {
  local question=$1 default=${2:-N} answer="" hint="[y/N]"
  [[ $default == Y ]] && hint="[Y/n]"
  ask answer "$question $hint" "" || return 1
  answer=${answer:-$default}
  [[ ${answer,,} == y || ${answer,,} == yes ]]
}

# require_answer VAR ENVNAME QUESTION: make sure VAR has a value. Asks on the
# terminal when there is one; with no terminal and no value, fails naming the
# environment variable to set.
require_answer() {
  local var=$1 envname=$2 question=$3
  [[ -n ${!var:-} ]] && return 0
  if _ff_has_tty; then
    while [[ -z ${!var:-} ]]; do
      ask "$var" "$question" "" || break
    done
    [[ -n ${!var:-} ]] && return 0
  fi
  warn "Missing answer: set $envname (${question#"${question%%[![:space:]]*}"})"
  warn "What to try: run the command in a terminal so it can ask you, or set $envname=... before it."
  return 1
}

# ------------------------------------------------------------
# Settings derived from the answers
# ------------------------------------------------------------

# size_workers CORES RAM_MB: worker counts for this machine.
#   TRANSCODING_CONCURRENCY = max(1, min(CORES/2, RAM_MB/2048))
#   API_WORKERS             = max(1, min(4, CORES))
#   EMAIL_CONCURRENCY=2 and MAINTENANCE_CONCURRENCY=1 (the defaults)
size_workers() {
  local cores=${1:-} ram=${2:-} t a
  [[ $cores =~ ^[0-9]+$ && $ram =~ ^[0-9]+$ ]] || return 1
  cores=$((10#$cores))
  ram=$((10#$ram))
  t=$((cores / 2))
  ((ram / 2048 < t)) && t=$((ram / 2048))
  ((t < 1)) && t=1
  a=$cores
  ((a > 4)) && a=4
  ((a < 1)) && a=1
  printf 'TRANSCODING_CONCURRENCY=%d EMAIL_CONCURRENCY=2 MAINTENANCE_CONCURRENCY=1 API_WORKERS=%d\n' "$t" "$a"
}

_ff_cores() {
  local n
  n=$(nproc 2>/dev/null) || n=2
  printf '%s' "${n:-2}"
}

_ff_ram_mb() {
  local kb=""
  [[ -r /proc/meminfo ]] && kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  if [[ $kb =~ ^[0-9]+$ ]]; then printf '%s' $((kb / 1024)); else printf '4096'; fi
}

# https_mode: own, sslip or off, from FF_HTTPS (auto when empty): auto means
# own with a domain, sslip with a public IPv4 in FF_IP, otherwise off.
https_mode() {
  case "${FF_HTTPS:-auto}" in
    own | sslip | off) printf '%s\n' "$FF_HTTPS" ;;
    auto)
      if [[ -n ${FF_DOMAIN:-} ]]; then
        printf 'own\n'
      elif is_public_ipv4 "${FF_IP:-}"; then
        printf 'sslip\n'
      else
        printf 'off\n'
      fi
      ;;
    *)
      warn "FREEFRAME_HTTPS must be auto, own, sslip or off (it is '$FF_HTTPS')."
      return 1
      ;;
  esac
}

# _ensure_secret FILE KEY BYTES: generate KEY once; never replace it. Fails
# loudly when no proper secret (BYTES*2 lowercase hex characters) comes back,
# so a URL is never built around an empty password.
_ensure_secret() {
  local file=$1 key=$2 bytes=$3 v=""
  [[ -n $(env_get "$file" "$key") ]] && return 0
  if ! v=$(gen_secret "$bytes") || [[ ! $v =~ ^[0-9a-f]+$ ]] || ((${#v} != bytes * 2)); then
    warn "Could not generate a random $key: openssl rand gave no usable result."
    warn "What to try: check that openssl works (openssl rand -hex 32), then run the command again."
    return 1
  fi
  env_set_if_missing "$file" "$key" "$v"
}

# derive_env FILE: fill FILE with every setting the stack needs, from the
# answers (FF_*, plus FF_IP, the server's address). Only missing or empty keys
# are written (env_set_if_missing); secrets are generated once and never
# replaced. When FILE already says how the server is set up (FREEFRAME_HTTPS,
# FREEFRAME_STORAGE, FRONTEND_URL), that wins over the answers, so a key added
# later (by `update`) matches what is already there. Worker counts are sized
# from FF_CORES / FF_RAM_MB, or the machine when those are unset.
derive_env() {
  local file=$1 mode storage channel host url scheme ip=${FF_IP:-}
  local s3_endpoint s3_bucket s3_access s3_secret s3_region s3_type v
  local pg_user pg_pw pg_db redis_pw pair cores ram
  local -a workers=()

  # --- Work out the shape first; write nothing until it is complete. ---
  mode=$(env_get "$file" FREEFRAME_HTTPS)
  [[ -n $mode ]] || mode=$(https_mode) || return 1
  url=$(env_get "$file" FRONTEND_URL)
  if [[ -n $url ]]; then
    host=${url#*://}
    host=${host%%/*}
    host=${host%%:*}
  else
    case $mode in
      own) host=${FF_DOMAIN:-} ;;
      sslip) [[ -z $ip ]] || host=$(sslip_host "$ip") ;;
      off) host=${FF_DOMAIN:-$ip} ;;
      *) host="" ;;
    esac
  fi
  case $mode in
    own | sslip) scheme=https ;;
    off) scheme=http ;;
    *)
      warn "FREEFRAME_HTTPS in $file must be own, sslip or off (it is '$mode')."
      return 1
      ;;
  esac
  if [[ -z $host ]]; then
    if [[ $mode == own ]]; then
      warn "Missing answer: set FREEFRAME_DOMAIN (the web address, for example review.yourstudio.com)"
    else
      warn "The server's IP address is not known, so the web address cannot be worked out."
    fi
    return 1
  fi
  # Check what was typed (a host already in the file is left as it is).
  if [[ -z $url ]]; then
    if [[ $mode == sslip ]] && ! is_public_ipv4 "$ip"; then
      warn "The automatic sslip.io address needs a public IPv4 address, and '$ip' is not one."
      warn "What to try: use your own domain (FREEFRAME_DOMAIN), or plain HTTP (FREEFRAME_HTTPS=off) on a local network."
      return 1
    fi
    if ! valid_hostname "$host"; then
      warn "The web address '$host' is not a plain name like review.yourstudio.com."
      warn "What to try: type only the name, without http://, a port, a path or spaces."
      return 1
    fi
  fi

  storage=$(env_get "$file" FREEFRAME_STORAGE)
  storage=${storage:-${FF_STORAGE:-bundled}}
  case $storage in
    bundled)
      s3_type=minio
      s3_endpoint=http://minio:9000
      s3_bucket=freeframe
      s3_region=${FF_S3_REGION:-us-east-1}
      ;;
    s3)
      s3_endpoint=${FF_S3_ENDPOINT:-$(env_get "$file" S3_ENDPOINT)}
      s3_bucket=${FF_S3_BUCKET:-$(env_get "$file" S3_BUCKET)}
      s3_access=${FF_S3_ACCESS_KEY:-$(env_get "$file" S3_ACCESS_KEY)}
      s3_secret=${FF_S3_SECRET_KEY:-$(env_get "$file" S3_SECRET_KEY)}
      s3_region=${FF_S3_REGION:-us-east-1}
      for pair in "FREEFRAME_S3_BUCKET:$s3_bucket" "FREEFRAME_S3_ACCESS_KEY:$s3_access" \
        "FREEFRAME_S3_SECRET_KEY:$s3_secret"; do
        if [[ -z ${pair#*:} ]]; then
          warn "Missing answer: set ${pair%%:*} (needed to use your own S3 bucket)"
          return 1
        fi
      done
      # Native AWS (no endpoint, or an *.amazonaws.com one) uses S3_STORAGE=s3;
      # every other S3-compatible service uses minio mode (see apps/api/config.py).
      v=${s3_endpoint#*://}
      v=${v%%[/:]*}
      v=${v,,}
      if [[ -z $s3_endpoint || $v == amazonaws.com || $v == *.amazonaws.com ]]; then
        s3_type=s3
      else
        s3_type=minio
      fi
      ;;
    *)
      warn "FREEFRAME_STORAGE must be bundled or s3 (it is '$storage')."
      return 1
      ;;
  esac
  channel=$(env_get "$file" FREEFRAME_CHANNEL)
  channel=${channel:-${FF_CHANNEL:-latest}}
  cores=${FF_CORES:-$(_ff_cores)}
  ram=${FF_RAM_MB:-$(_ff_ram_mb)}
  read -ra workers <<<"$(size_workers "$cores" "$ram")" || true
  ((${#workers[@]})) || read -ra workers <<<"$(size_workers 2 4096)"

  # --- Write. ---
  if [[ -e $file ]] && ! chmod 600 "$file"; then
    warn "Cannot make $file private (chmod 600 failed)."
    return 1
  fi
  if [[ ! -s $file ]]; then
    (umask 077 && cat >"$file" <<'EOF'
# FreeFrame settings, written by the freeframe command.
# Keep this file private: it holds the passwords for the database and storage.
# To change the answers you gave, run: sudo freeframe configure
EOF
    ) || return 1
  fi

  env_set_if_missing "$file" FRONTEND_URL "$scheme://$host" || return 1
  if [[ $scheme == https ]]; then
    env_set_if_missing "$file" DOMAIN "$host" || return 1
    env_set_if_missing "$file" ACME_EMAIL "${FF_ACME_EMAIL:-}" || return 1
  fi

  env_set_if_missing "$file" POSTGRES_USER freeframe || return 1
  env_set_if_missing "$file" POSTGRES_DB freeframe || return 1
  _ensure_secret "$file" POSTGRES_PASSWORD 32 || return 1
  pg_user=$(env_get "$file" POSTGRES_USER)
  pg_pw=$(env_get "$file" POSTGRES_PASSWORD)
  pg_db=$(env_get "$file" POSTGRES_DB)
  env_set_if_missing "$file" DATABASE_URL "postgresql://$pg_user:$pg_pw@postgres:5432/$pg_db" || return 1

  # A copied settings file whose REDIS_URL has no password keeps redis
  # without one: a new password the URL does not carry would lock the app out.
  if [[ -z $(env_get "$file" REDIS_URL) ]]; then
    _ensure_secret "$file" REDIS_PASSWORD 32 || return 1
  fi
  redis_pw=$(env_get "$file" REDIS_PASSWORD)
  if [[ -n $redis_pw ]]; then
    env_set_if_missing "$file" REDIS_URL "redis://:$redis_pw@redis:6379/0" || return 1
  else
    env_set_if_missing "$file" REDIS_URL "redis://redis:6379/0" || return 1
  fi
  _ensure_secret "$file" JWT_SECRET 64 || return 1

  env_set_if_missing "$file" S3_STORAGE "$s3_type" || return 1
  env_set_if_missing "$file" S3_ENDPOINT "$s3_endpoint" || return 1
  env_set_if_missing "$file" S3_BUCKET "$s3_bucket" || return 1
  env_set_if_missing "$file" S3_REGION "$s3_region" || return 1
  if [[ $storage == bundled ]]; then
    _ensure_secret "$file" S3_ACCESS_KEY 16 || return 1
    _ensure_secret "$file" S3_SECRET_KEY 32 || return 1
    if [[ $scheme == https ]]; then
      env_set_if_missing "$file" S3_PUBLIC_ENDPOINT "https://storage.$host" || return 1
      env_set_if_missing "$file" STORAGE_DOMAIN "storage.$host" || return 1
      env_set_if_missing "$file" STORAGE_ROUTED true || return 1
      env_set_if_missing "$file" STORAGE_PORT_BIND 127.0.0.1:9000 || return 1
    else
      env_set_if_missing "$file" S3_PUBLIC_ENDPOINT "http://$host:9000" || return 1
      env_set_if_missing "$file" STORAGE_ROUTED false || return 1
      env_set_if_missing "$file" STORAGE_PORT_BIND 0.0.0.0:9000 || return 1
    fi
  else
    env_set_if_missing "$file" S3_ACCESS_KEY "$s3_access" || return 1
    env_set_if_missing "$file" S3_SECRET_KEY "$s3_secret" || return 1
  fi

  # Always smtp: the app's default (ses) hides the "email is not set up" warning.
  env_set_if_missing "$file" MAIL_PROVIDER smtp || return 1
  if [[ -n ${FF_SMTP_HOST:-} ]]; then
    env_set_if_missing "$file" SMTP_HOST "$FF_SMTP_HOST" || return 1
    env_set_if_missing "$file" SMTP_PORT "${FF_SMTP_PORT:-587}" || return 1
    # Port 465 is TLS from the first byte; anything else upgrades with STARTTLS.
    if [[ ${FF_SMTP_PORT:-587} == 465 ]]; then
      env_set_if_missing "$file" SMTP_USE_TLS false || return 1
    else
      env_set_if_missing "$file" SMTP_USE_TLS true || return 1
    fi
    env_set_if_missing "$file" SMTP_USER "${FF_SMTP_USER:-}" || return 1
    env_set_if_missing "$file" SMTP_PASSWORD "${FF_SMTP_PASSWORD:-}" || return 1
  fi
  env_set_if_missing "$file" MAIL_FROM_ADDRESS "${FF_SMTP_FROM:-}" || return 1

  env_set_if_missing "$file" FREEFRAME_HTTPS "$mode" || return 1
  env_set_if_missing "$file" FREEFRAME_STORAGE "$storage" || return 1
  env_set_if_missing "$file" FREEFRAME_CHANNEL "$channel" || return 1
  # Only once install has decided it (_gpu_decide): an update adds nothing,
  # so a server set up before this setting existed stays on the CPU.
  case ${FF_GPU:-} in
    nvidia | off) env_set_if_missing "$file" FREEFRAME_GPU "$FF_GPU" || return 1 ;;
  esac

  for pair in "${workers[@]}"; do
    env_set_if_missing "$file" "${pair%%=*}" "${pair#*=}" || return 1
  done
}

# ------------------------------------------------------------
# Docker compose
# ------------------------------------------------------------

# compose_files ENVFILE: the -f arguments for this server, in order. The GPU
# file (FREEFRAME_GPU=nvidia) is used only when it is there: the setup files
# of a release from before it have none, and a rollback to them removes it.
# FF_GPU_SKIP=1 (_gpu_start_check: the GPU cannot be used now) leaves it out.
compose_files() {
  local file=$1 out="-f docker-compose.prod.yml -f docker-compose.images.yml"
  case "$(env_get "$file" FREEFRAME_HTTPS)" in
    own | sslip) out+=" -f docker-compose.https.yml" ;;
  esac
  if [[ $(env_get "$file" FREEFRAME_STORAGE) == bundled ]]; then
    out+=" -f docker-compose.storage.yml"
  fi
  if [[ $(env_get "$file" FREEFRAME_GPU) == nvidia && -f $(dirname "$file")/docker-compose.gpu.yml && -z ${FF_GPU_SKIP:-} ]]; then
    out+=" -f docker-compose.gpu.yml"
  fi
  printf '%s\n' "$out"
}

# dc ARGS...: docker compose for this install, run from $FF_ROOT.
dc() {
  local root
  local -a files=()
  root=$(ff_root)
  read -ra files <<<"$(compose_files "$root/.env.prod")"
  (cd "$root" && docker compose --project-name freeframe --env-file "$root/.env.prod" "${files[@]}" "$@")
}

# dc_bounded SECONDS ARGS...: dc, stopped after SECONDS (and killed 5
# seconds later if it ignores that), for a question that must not hang.
dc_bounded() {
  local secs=$1 root
  local -a files=()
  shift
  root=$(ff_root)
  read -ra files <<<"$(compose_files "$root/.env.prod")"
  (cd "$root" && timeout -k 5 "$secs" docker compose --project-name freeframe --env-file "$root/.env.prod" "${files[@]}" "$@")
}

# ------------------------------------------------------------
# Backups
# ------------------------------------------------------------

# backup_prune DIR KEEP [PROTECT...]: delete all but the newest KEEP
# freeframe-*.dump files in DIR, with their freeframe-*.env.prod settings
# copies. Backups are named freeframe-<YYYYmmdd-HHMMSS>.dump, so newest is
# last in name order. Each PROTECT (a dump path) is never deleted and not
# counted: the copy an unfinished restore can be undone with, and the
# backup a failed update is rolled back to.
backup_prune() {
  local dir=$1 keep=$2 f n i=0
  local LC_ALL=C
  local -a dumps=()
  shift 2
  local protect=" $* "
  if [[ ! $keep =~ ^[0-9]+$ ]]; then
    warn "backup_prune: the number of backups to keep must be a whole number (got '$keep')."
    return 1
  fi
  [[ -d $dir ]] || return 0
  for f in "$dir"/freeframe-*.dump; do
    [[ -f $f && $protect != *" $f "* ]] && dumps+=("$f")
  done
  n=$((${#dumps[@]} - 10#$keep))
  while ((i < n)); do
    rm -f -- "${dumps[i]}" "${dumps[i]%.dump}.env.prod"
    i=$((i + 1))
  done
}

# ------------------------------------------------------------
# Install: wrappers for everything that changes the server or reaches the
# network. Each one is a small function so the tests can replace it
# (deploy/tests/install_stubs.bash); nothing else in the install flow runs a
# side effect directly.
#
# Test-only switches, used by deploy/tests and the installer CI and never
# needed on a real server:
#   FF_SKIP_PULL=1         skip `docker compose pull` (the images are local)
#   FF_FETCH_FROM_DIR=DIR  copy the compose files from DIR instead of
#                          downloading them
#   FF_OS_RELEASE=FILE     read FILE instead of /etc/os-release
#   FF_BIN_DIR=DIR         install the freeframe command into DIR instead
#                          of /usr/local/bin
#   FF_SYSTEMD_DIR=DIR     install the nightly backup units into DIR
#                          instead of /etc/systemd/system
#   FF_ROOT_HOME=DIR       uninstall saves the backups in DIR instead of
#                          /root
#   FF_FSTAB=FILE          read FILE instead of /etc/fstab (uninstall)
# Waits, in seconds (also for unusually slow servers): FF_API_WAIT (600),
# FF_HEALTH_WAIT (300), FF_CERT_WAIT (300 per name), FF_DNS_WAIT (1800,
# unattended runs only; with a terminal the installer waits until told),
# FF_DB_WAIT (120, restore: for the database server to answer),
# FF_BACKUP_DB_WAIT (60, backup: the same, for the catch-up run at boot).
# ------------------------------------------------------------

FF_RAW_BASE=https://raw.githubusercontent.com/Techiebutler/freeframe
FF_GUIDE_URL=https://github.com/Techiebutler/freeframe/blob/main/docs/deployment.md

ff_is_root() { [[ $(id -u) == 0 ]]; }
machine_arch() { uname -m; }
_ff_kernel() { uname -s 2>/dev/null; }
ff_sleep() { sleep "$1"; }

# run_apt ARGS...: apt-get without questions, waiting for the apt lock that
# a fresh server's automatic updates often hold for the first minutes.
run_apt() {
  DEBIAN_FRONTEND=noninteractive apt-get -y -q -o DPkg::Lock::Timeout=300 \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"
}

# public_ip: this server's address as the internet sees it.
public_ip() {
  local url ip
  for url in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
    ip=$(curl -fsS4 --max-time 5 "$url" 2>/dev/null | tr -d '[:space:]') || continue
    if [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      printf '%s\n' "$ip"
      return 0
    fi
  done
  return 1
}

# local_ip: the address of the network interface that reaches the internet.
local_ip() {
  local ip=""
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null |
    awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }') || ip=""
  [[ -n $ip ]] || ip=$(hostname -I 2>/dev/null | awk '{ print $1 }') || ip=""
  [[ -n $ip ]] || return 1
  printf '%s\n' "$ip"
}

# net_reachable URL: 0 when an HTTPS connection to URL works (any HTTP status).
net_reachable() { curl -sS -o /dev/null --max-time 15 "$1" >/dev/null 2>&1; }

# _ff_free_mb PATH: free space in MB on the filesystem holding PATH (or its
# nearest existing parent, for /var/lib/docker before Docker is installed).
_ff_free_mb() {
  local p=$1
  while [[ ! -e $p && $p != / ]]; do p=$(dirname "$p"); done
  df -Pk "$p" 2>/dev/null | awk 'NR == 2 { print int($4 / 1024) }'
}

# port_holder PORT: "NAME PID" of the program listening on TCP PORT, or
# nothing when the port is free (from ss -ltnp).
port_holder() {
  local port=$1 line re='users:\(\("([^"]+)",pid=([0-9]+)'
  line=$(ss -Hltnp 2>/dev/null | awk -v p=":$port" \
    '{ a = $4; if (length(a) > length(p) && substr(a, length(a) - length(p) + 1) == p) { print; exit } }') || line=""
  [[ -n $line ]] || return 0
  if [[ $line =~ $re ]]; then
    printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  else
    printf 'unknown 0\n'
  fi
}

_ff_unit_of_pid() { ps -o unit= -p "$1" 2>/dev/null | tr -d '[:space:]'; }

swap_present() { [[ -n $(swapon --show --noheadings 2>/dev/null) ]]; }

# add_swap: a 2 GB /swapfile, the usual way; removed again if any step fails.
add_swap() {
  local f=/swapfile
  [[ ! -e $f ]] || return 1
  if install -o root -g root -m 0600 /dev/null "$f" &&
    { fallocate -l 2G "$f" 2>/dev/null || dd if=/dev/zero of="$f" bs=1M count=2048 status=none; } &&
    mkswap "$f" && swapon "$f"; then
    grep -qs "^$f " /etc/fstab || printf '%s none swap sw 0 0\n' "$f" >>/etc/fstab
    sysctl -q -w vm.swappiness=10 || true
    printf 'vm.swappiness = 10\n' >/etc/sysctl.d/30-freeframe-swap.conf
    return 0
  fi
  swapoff "$f" 2>/dev/null || true
  rm -f "$f"
  return 1
}

# LC_ALL=C: ufw translates "Status: active" on servers set to another language.
ufw_active() { command -v ufw >/dev/null 2>&1 && LC_ALL=C ufw status 2>/dev/null | grep -q '^Status: active'; }

# docker_status: one word for the Docker on this server: none, snap,
# "old VERSION", nocompose, down (installed but not answering) or ok
# (Docker 24 or newer with the compose plugin).
docker_status() {
  local path ver major
  if ! path=$(command -v docker 2>/dev/null); then
    printf 'none\n'
    return 0
  fi
  if [[ $path == /snap/* ]] || { command -v snap >/dev/null 2>&1 && snap list docker >/dev/null 2>&1; }; then
    printf 'snap\n'
    return 0
  fi
  if ! ver=$(docker version --format '{{.Server.Version}}' 2>/dev/null) || [[ -z $ver ]]; then
    printf 'down\n'
    return 0
  fi
  major=${ver%%.*}
  if [[ ! $major =~ ^[0-9]+$ ]] || ((10#$major < 24)); then
    printf 'old %s\n' "$ver"
    return 0
  fi
  if ! docker compose version >/dev/null 2>&1; then
    printf 'nocompose\n'
    return 0
  fi
  printf 'ok\n'
}

# _ff_os_field KEY: a value from /etc/os-release (or FF_OS_RELEASE).
_ff_os_field() {
  local key=$1 file=${FF_OS_RELEASE:-/etc/os-release}
  [[ -r $file ]] || return 0
  (
    # shellcheck disable=SC1090
    . "$file" >/dev/null 2>&1 || true
    printf '%s' "${!key:-}"
  )
}

# install_docker: Docker Engine and the compose plugin from Docker's own apt
# repository, following Docker's documented steps for Ubuntu and Debian (not
# the get.docker.com script, which Docker says is not for production).
install_docker() {
  local id codename arch
  id=$(_ff_os_field ID)
  codename=$(_ff_os_field UBUNTU_CODENAME)
  [[ -n $codename ]] || codename=$(_ff_os_field VERSION_CODENAME)
  run_apt update || return 1
  run_apt install ca-certificates curl || return 1
  install -m 0755 -d /etc/apt/keyrings || return 1
  curl -fsSL "https://download.docker.com/linux/$id/gpg" -o /etc/apt/keyrings/docker.asc || return 1
  chmod a+r /etc/apt/keyrings/docker.asc || return 1
  arch=$(dpkg --print-architecture) || return 1
  cat >/etc/apt/sources.list.d/docker.sources <<EOF || return 1
Types: deb
URIs: https://download.docker.com/linux/$id
Suites: $codename
Components: stable
Architectures: $arch
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  run_apt update || return 1
  run_apt install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || return 1
  systemctl enable --now docker
}

# The nightly backup units: fetched into $FF_ROOT/systemd with the compose
# files, put into systemd (FF_SYSTEMD_DIR, /etc/systemd/system) and the
# timer started. On a host where Docker uses the systemd cgroup driver,
# `systemctl daemon-reload` takes the GPU away from running containers
# (see _gpu_worker_check), so these reload only when a unit really changed,
# and never through `enable` (--no-reload): install puts the units in place
# and reloads before FreeFrame starts (backup_units_install), and starts
# the timer after (backup_timer_on); update and rollback reload only when
# the new release changed a unit. _gpu_worker_check stays the backstop.

# _backup_units_stale: 0 when systemd still holds an older definition of a
# unit than the file on disk (NeedDaemonReload=yes): a daemon-reload that
# failed after the files were copied, which cmp no longer sees. A systemd
# that cannot say, or an error, counts as no.
_backup_units_stale() {
  local out
  out=$(systemctl show -p NeedDaemonReload --value freeframe-backup.timer freeframe-backup.service 2>/dev/null) || return 1
  [[ $'\n'$out$'\n' == *$'\n'yes$'\n'* ]]
}

# backup_units_install: copy each unit that is missing or different, then
# daemon-reload, only when one was copied or systemd has not loaded the
# files on disk yet (FF_UNITS_CHANGED=1).
backup_units_install() {
  local root dir u
  root=$(ff_root)
  dir=${FF_SYSTEMD_DIR:-/etc/systemd/system}
  FF_UNITS_CHANGED=""
  for u in freeframe-backup.service freeframe-backup.timer; do
    if [[ ! -f $root/systemd/$u ]]; then
      warn "The nightly backup unit $root/systemd/$u is missing."
      return 1
    fi
    if ! cmp -s "$root/systemd/$u" "$dir/$u"; then
      install -m 644 "$root/systemd/$u" "$dir/$u" || return 1
      FF_UNITS_CHANGED=1
    fi
  done
  if [[ -z $FF_UNITS_CHANGED ]] && _backup_units_stale; then FF_UNITS_CHANGED=1; fi
  if [[ -n $FF_UNITS_CHANGED ]]; then
    systemctl daemon-reload || return 1
  fi
}

# backup_timer_on: the timer enabled and running, without a reload. Nothing
# to do when no unit changed and it is enabled and active already. Starting
# a Persistent=true timer that missed a run fires that run at once; update
# and rollback call this holding the lock, and the backup then skips itself
# (cmd_backup) instead of failing in the journal.
backup_timer_on() {
  local t=freeframe-backup.timer
  if [[ -z ${FF_UNITS_CHANGED:-} ]] && systemctl is-enabled --quiet "$t" 2>/dev/null &&
    systemctl is-active --quiet "$t" 2>/dev/null; then
    return 0
  fi
  systemctl enable --now --no-reload "$t"
}

# install_backup_timer: both, for update and rollback (FreeFrame runs).
# Safe to run again: it replaces the units with the fetched ones.
install_backup_timer() {
  backup_units_install || return 1
  backup_timer_on
}

# ------------------------------------------------------------
# GPU: whether video is processed on the GPU or the CPU
#
# detect_gpu reads the server through the small _gpu_* wrappers below and
# sets FF_GPU_VENDOR (nvidia, intel, amd or none), FF_GPU_NAME, FF_GPU_DRIVER,
# FF_GPU_STATE and FF_GPU_WSL. For NVIDIA the state is nodriver (a card, but
# nvidia-smi does not answer), notoolkit (no NVIDIA container toolkit),
# noruntime (the toolkit, but Docker has no nvidia runtime yet) or ready;
# Intel and AMD are unsupported (the published images use NVIDIA only); none
# is none. It changes nothing. FF_SYS_ROOT (test-only) is put in front of
# every /sys, /proc, /dev and /usr/lib/wsl path.
#
# Only NVIDIA is set up: the published API image already has an ffmpeg with
# NVENC, which needs the host's driver, the NVIDIA container toolkit and a
# GPU reservation on the worker (docker-compose.gpu.yml). Drivers are never
# installed or changed here; a missing driver gets a suggestion.
# ------------------------------------------------------------

FF_NVIDIA_REPO=https://nvidia.github.io/libnvidia-container
FF_GPU_GUIDE="$FF_GUIDE_URL#hardware-accelerated-transcoding-optional"

_ff_sys() { printf '%s%s' "${FF_SYS_ROOT:-}" "$1"; }

# _gpu_pci_vendors: the vendor id (0x10de) of each PCI display device.
_gpu_pci_vendors() {
  local d class
  for d in "$(_ff_sys /sys/bus/pci/devices)"/*; do
    [[ -r $d/class && -r $d/vendor ]] || continue
    class=$(<"$d/class")
    [[ $class == 0x03* ]] || continue
    printf '%s\n' "$(<"$d/vendor")"
  done
}

# _gpu_render_vendors: the vendor id of each /dev/dri/renderD* device.
_gpu_render_vendors() {
  local n v
  for n in "$(_ff_sys /dev/dri)"/renderD*; do
    [[ -e $n ]] || continue
    v=$(_ff_sys "/sys/class/drm/${n##*/}/device/vendor")
    [[ -r $v ]] && printf '%s\n' "$(<"$v")"
  done
  return 0
}

_gpu_has_proc() { [[ -e $(_ff_sys /proc/driver/nvidia) ]]; }

# _gpu_is_wsl: WSL2, where the Windows driver is shared with Linux through
# /dev/dxg and /usr/lib/wsl/lib, and there is no /proc/driver/nvidia.
_gpu_is_wsl() { [[ -e $(_ff_sys /dev/dxg) || -d $(_ff_sys /usr/lib/wsl/lib) ]]; }

# _gpu_smi: the nvidia-smi to ask: on the PATH, or WSL2's own.
_gpu_smi() {
  local p
  if p=$(command -v nvidia-smi 2>/dev/null); then
    printf '%s' "$p"
    return 0
  fi
  p=$(_ff_sys /usr/lib/wsl/lib/nvidia-smi)
  [[ -x $p ]] || return 1
  printf '%s' "$p"
}

# _gpu_query SMI: "NAME, DRIVER" for each GPU. Bounded: a wedged driver can
# leave nvidia-smi hanging.
_gpu_query() {
  timeout -k 5 "${FF_GPU_SMI_TIMEOUT:-20}" "$1" --query-gpu=name,driver_version --format=csv,noheader 2>/dev/null
}

_gpu_has_toolkit() { command -v nvidia-ctk >/dev/null 2>&1 || command -v nvidia-container-toolkit >/dev/null 2>&1; }

# _gpu_docker_runtimes: the runtimes Docker has, "io.containerd.runc.v2 nvidia
# runc " (nothing when Docker does not answer).
_gpu_docker_runtimes() {
  command -v docker >/dev/null 2>&1 || return 0
  # shellcheck disable=SC2016 # a Go template, not a shell expansion
  timeout -k 5 "${FF_DOCKER_INFO_TIMEOUT:-20}" docker info --format '{{range $k, $v := .Runtimes}}{{$k}} {{end}}' 2>/dev/null || true
}

# _gpu_other_containers: how many running containers are not FreeFrame's
# (compose project freeframe); restarting Docker stops them too.
_gpu_other_containers() {
  local out line n=0
  command -v docker >/dev/null 2>&1 || { printf 0; return 0; }
  out=$(timeout -k 5 "${FF_DOCKER_INFO_TIMEOUT:-20}" docker ps --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null) || out=""
  if [[ -n $out ]]; then
    while IFS= read -r line; do
      [[ $line == freeframe ]] || n=$((n + 1))
    done <<<"$out"
  fi
  printf '%s' "$n"
}

# _gpu_others_words: "the 2 other containers running", "the 1 other
# container running" (FF_GPU_OTHERS from _install_gpu_check).
_gpu_others_words() {
  if ((${FF_GPU_OTHERS:-0} == 1)); then
    printf 'the 1 other container running'
  else
    printf 'the %s other containers running' "${FF_GPU_OTHERS:-0}"
  fi
}

# FF_GPU_VENDOR is for the tests and anyone reading the result; the script
# itself goes by FF_GPU_STATE.
# shellcheck disable=SC2034
detect_gpu() {
  local pci render smi out line nvidia=""
  FF_GPU_VENDOR=none FF_GPU_NAME="" FF_GPU_DRIVER="" FF_GPU_STATE=none FF_GPU_WSL="" FF_GPU_SMI_LINE=""
  if _gpu_is_wsl; then FF_GPU_WSL=1; fi
  pci=$(_gpu_pci_vendors) || pci=""
  render=$(_gpu_render_vendors) || render=""
  pci=${pci,,} render=${render,,}
  if [[ $'\n'$pci$'\n'$render$'\n' == *$'\n0x10de\n'* ]] || _gpu_has_proc; then nvidia=1; fi
  if smi=$(_gpu_smi); then
    out=$(_gpu_query "$smi") || out=""
    line=${out%%$'\n'*}
    line=${line%$'\r'}
    if [[ $line == *", "* && -n ${line%, *} && ${line##*, } =~ ^[0-9][0-9.]*$ ]]; then
      FF_GPU_VENDOR=nvidia FF_GPU_NAME=${line%, *} FF_GPU_DRIVER=${line##*, } FF_GPU_SMI_LINE=$line
      if ! _gpu_has_toolkit; then
        FF_GPU_STATE=notoolkit
      elif [[ " $(_gpu_docker_runtimes) " == *" nvidia "* ]]; then
        FF_GPU_STATE=ready
      else
        FF_GPU_STATE=noruntime
      fi
      return 0
    fi
    # The WSL2 nvidia-smi is there with every Windows driver, so it says
    # nothing about a card on its own.
    if [[ $smi != "$(_ff_sys /usr/lib/wsl/lib/nvidia-smi)" ]]; then nvidia=1; fi
  fi
  if [[ -n $nvidia ]]; then
    FF_GPU_VENDOR=nvidia FF_GPU_NAME=NVIDIA FF_GPU_STATE=nodriver
  elif [[ $'\n'$render$'\n'$pci$'\n' == *$'\n0x8086\n'* ]]; then
    FF_GPU_VENDOR=intel FF_GPU_NAME=Intel FF_GPU_STATE=unsupported
  elif [[ $'\n'$render$'\n'$pci$'\n' == *$'\n0x1002\n'* ]]; then
    FF_GPU_VENDOR=amd FF_GPU_NAME=AMD FF_GPU_STATE=unsupported
  fi
  return 0
}

# _gpu_usable: 0 when detect_gpu found an NVIDIA GPU whose driver works.
_gpu_usable() { [[ ${FF_GPU_STATE:-} == ready || ${FF_GPU_STATE:-} == notoolkit || ${FF_GPU_STATE:-} == noruntime ]]; }

# _gpu_line: the result, as the server check shows it.
_gpu_line() {
  case ${FF_GPU_STATE:-none} in
    ready | notoolkit | noruntime) printf 'GPU: %s (driver %s)' "$FF_GPU_NAME" "$FF_GPU_DRIVER" ;;
    nodriver) printf 'GPU: NVIDIA (no working driver)' ;;
    unsupported) printf 'GPU: %s (not used with the published images)' "$FF_GPU_NAME" ;;
    *) printf 'GPU: none found' ;;
  esac
}

# _gpu_driver_hint AGAIN: what to do about an NVIDIA card without a working
# driver, ending with AGAIN (the command to run afterwards). The command to
# type has a line of its own. Drivers are never installed here.
_gpu_driver_hint() {
  local again=$1
  if [[ -n ${FF_GPU_WSL:-} ]]; then
    printf 'install or update the NVIDIA driver on Windows (WSL uses the Windows driver), run wsl --shutdown in Windows, then start WSL and %s.' "$again"
  elif [[ $(_ff_os_field ID) == debian ]]; then
    printf 'install the NVIDIA driver as Debian describes at https://wiki.debian.org/NvidiaGraphicsDrivers, reboot, then %s.' "$again"
  else
    printf 'install the NVIDIA driver, reboot, then %s:\nsudo ubuntu-drivers install' "$again"
  fi
}

# _gpu_unsupported_text: why an Intel or AMD GPU is not used.
_gpu_unsupported_text() {
  printf 'This server has an %s GPU. The published FreeFrame images use only NVIDIA GPUs, so video is processed on the CPU. To use this GPU, build the images yourself as the guide explains: %s' \
    "$FF_GPU_NAME" "$FF_GPU_GUIDE"
}

# _gpu_decide FILE: after detect_gpu, whether this install processes video
# on the GPU. Sets FF_GPU (nvidia or off), FF_GPU_SETUP (1: the toolkit is to
# be set up first), FF_GPU_ASK (1: the Video processing question decides),
# FF_GPU_NOTE (a note for the server check), FF_GPU_WHY (why the CPU, for
# the summary) and FF_GPU_FORCE_OFF (1: FILE says nvidia, which this server
# cannot do). FILE's FREEFRAME_GPU wins (a re-run keeps its answer); then
# --gpu (FREEFRAME_GPU); then: a ready GPU is used, a working one without
# the toolkit is asked about (unattended: the CPU, with a note).
_gpu_decide() {
  local file=$1 saved given=${FF_GPU:-}
  FF_GPU_SETUP="" FF_GPU_ASK="" FF_GPU_NOTE="" FF_GPU_WHY="" FF_GPU_FORCE_OFF=""
  case $given in
    "" | auto | nvidia | off) ;;
    *) _ff_answer_error "FREEFRAME_GPU (--gpu) must be nvidia or off; it is '$given'." "use --gpu nvidia to process video on an NVIDIA GPU, or --gpu off for the CPU." ;;
  esac
  saved=$(env_get "$file" FREEFRAME_GPU)
  FF_GPU=off
  case ${saved:-$given} in
    off)
      if [[ -n $saved ]]; then FF_GPU_WHY="as in the existing settings"; else FF_GPU_WHY="chosen with --gpu off"; fi
      return 0
      ;;
    nvidia)
      if _gpu_usable; then
        FF_GPU=nvidia
        [[ $FF_GPU_STATE == ready ]] || FF_GPU_SETUP=1
        return 0
      fi
      _gpu_cpu_reason
      if [[ -n $saved ]]; then
        FF_GPU_FORCE_OFF=1
        FF_GPU_NOTE="The settings in $file say FREEFRAME_GPU=nvidia, but $(_gpu_no_nvidia_text), so it is set to off and video is processed on the CPU."
      else
        FF_GPU_NOTE="--gpu nvidia was given, but $(_gpu_no_nvidia_text), so video is processed on the CPU."
      fi
      if [[ $FF_GPU_STATE == nodriver ]]; then
        FF_GPU_NOTE+=" To use the GPU, $(_gpu_driver_hint "run the installer again")"
      fi
      return 0
      ;;
  esac
  case $FF_GPU_STATE in
    ready) FF_GPU=nvidia ;;
    notoolkit | noruntime)
      if _ff_interactive; then
        FF_GPU_ASK=1
      else
        FF_GPU_WHY="the NVIDIA container toolkit is not set up"
        FF_GPU_NOTE="This server has an NVIDIA GPU ($FF_GPU_NAME), but the NVIDIA container toolkit that lets Docker use it is not set up, so video is processed on the CPU. To set it up and use the GPU, add --gpu nvidia to the install command, or later run:
sudo freeframe configure"
      fi
      ;;
    nodriver)
      _gpu_cpu_reason
      FF_GPU_NOTE="This server has an NVIDIA GPU, but its driver does not answer (nvidia-smi), so video is processed on the CPU. To use the GPU, $(_gpu_driver_hint "run the installer again")"
      ;;
    unsupported)
      _gpu_cpu_reason
      FF_GPU_NOTE=$(_gpu_unsupported_text)
      ;;
    *) _gpu_cpu_reason ;;
  esac
}

# _gpu_no_nvidia_text: "this server has no NVIDIA GPU", or that its driver
# does not work.
_gpu_no_nvidia_text() {
  if [[ ${FF_GPU_STATE:-} == nodriver ]]; then
    printf "this server's NVIDIA GPU has no working driver"
  else
    printf 'this server has no NVIDIA GPU'
  fi
}

# _gpu_cpu_reason: FF_GPU_WHY from the detection.
_gpu_cpu_reason() {
  case ${FF_GPU_STATE:-none} in
    nodriver) FF_GPU_WHY="the NVIDIA driver is not working" ;;
    unsupported) FF_GPU_WHY="the $FF_GPU_NAME GPU is not used with the published images" ;;
    notoolkit | noruntime) FF_GPU_WHY="the NVIDIA container toolkit is not set up" ;;
    *) FF_GPU_WHY="no GPU found" ;;
  esac
}

# _gpu_summary: the summary's Video row.
_gpu_summary() {
  if [[ ${FF_GPU:-off} == nvidia ]]; then
    printf 'processed on the GPU (%s), with the CPU as a fallback' "$FF_GPU_NAME"
    if [[ -n ${FF_GPU_SETUP:-} ]]; then
      printf "; the NVIDIA container toolkit is set up first, from NVIDIA's repository, and Docker is restarted once"
      if ((${FF_GPU_OTHERS:-0} > 0)); then
        printf ', which stops %s on this server for a moment (any without a restart policy stay stopped)' "$(_gpu_others_words)"
      fi
    fi
  else
    printf 'processed on the CPU (%s)' "${FF_GPU_WHY:-no GPU found}"
  fi
}

# _gpu_ready_line: the closing message's line. With the GPU chosen, what
# the worker said after the start (_gpu_worker_check) decides, not the plan.
_gpu_ready_line() {
  if [[ ${FF_GPU:-off} == nvidia && ${FF_GPU_WORKER:-} == unseen ]]; then
    printf 'Video processing: CPU for now: the worker could not use the GPU%s.' "$(_gpu_worker_named)"
  elif [[ ${FF_GPU:-off} == nvidia && ${FF_GPU_WORKER:-} == down ]]; then
    printf 'Video processing: stopped: the worker that processes video is not running.'
  elif [[ ${FF_GPU:-off} == nvidia ]]; then
    printf 'Video processing: GPU (%s)' "${FF_GPU_NAME:-${FF_GPU_WORKER_NAME:-NVIDIA}}"
  else
    printf 'Video processing: CPU (%s)' "${FF_GPU_WHY:-no GPU found}"
  fi
}

# install_nvidia_toolkit: the NVIDIA container toolkit from NVIDIA's apt
# repository, as NVIDIA's install guide does it (the keyring, the sources
# list, apt install nvidia-container-toolkit), then Docker set up for it
# (nvidia-ctk runtime configure) and restarted. When the toolkit is already
# installed only Docker is set up. A failure after the sources list is
# written puts the list back as it was (removed, or someone's own list from
# before), so a broken list never blocks apt and no one's file is lost. Docker's
# daemon.json is copied aside before nvidia-ctk changes it
# (FF_GPU_DAEMON_BACKUP; empty when there was none), for _gpu_daemon_undo.
install_nvidia_toolkit() {
  # FF_NVIDIA_KEYRING and FF_NVIDIA_LIST are for the tests.
  local key=${FF_NVIDIA_KEYRING:-/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg}
  local list=${FF_NVIDIA_LIST:-/etc/apt/sources.list.d/nvidia-container-toolkit.list} tmp saved=""
  if ! command -v nvidia-ctk >/dev/null 2>&1; then
    run_apt update || return 1
    # NVIDIA's guide names gnupg2, a transitional name for gnupg.
    run_apt install --no-install-recommends ca-certificates curl gnupg || return 1
    tmp=$(mktemp -d) || return 1
    if ! { curl -fsSL --retry 3 "$FF_NVIDIA_REPO/gpgkey" -o "$tmp/gpgkey" &&
      install -m 0755 -d "$(dirname "$key")" &&
      gpg --batch --yes --dearmor -o "$key" "$tmp/gpgkey" && chmod a+r "$key" &&
      curl -fsSL --retry 3 "$FF_NVIDIA_REPO/stable/deb/nvidia-container-toolkit.list" -o "$tmp/list" &&
      grep -q '^deb https://' "$tmp/list"; }; then
      rm -rf "$tmp"
      return 1
    fi
    # A list that is already there is someone's own: kept aside (outside
    # sources.list.d, where apt would read it), and put back on failure.
    if [[ -e $list ]]; then
      saved="$(dirname "$(dirname "$list")")/${list##*/}.before-freeframe-$(date +%Y%m%d-%H%M%S)"
      if ! cp -p "$list" "$saved"; then
        rm -rf "$tmp"
        return 1
      fi
      printf 'The NVIDIA sources list from before is kept at %s\n' "$saved"
    fi
    if ! sed "s#deb https://#deb [signed-by=$key] https://#g" "$tmp/list" >"$list"; then
      rm -rf "$tmp"
      _gpu_list_undo "$list" "$saved"
      return 1
    fi
    rm -rf "$tmp"
    if ! { run_apt update && run_apt install nvidia-container-toolkit; }; then
      _gpu_list_undo "$list" "$saved"
      return 1
    fi
  fi
  # FF_DOCKER_DAEMON_JSON is for the tests.
  local json=${FF_DOCKER_DAEMON_JSON:-/etc/docker/daemon.json}
  FF_GPU_DAEMON_JSON=$json FF_GPU_DAEMON_BACKUP=""
  if [[ -e $json ]]; then
    FF_GPU_DAEMON_BACKUP="$json.before-freeframe-nvidia-$(date +%Y%m%d-%H%M%S)"
    if ! cp -p "$json" "$FF_GPU_DAEMON_BACKUP"; then
      FF_GPU_DAEMON_JSON="" FF_GPU_DAEMON_BACKUP=""
      return 1
    fi
  fi
  nvidia-ctk runtime configure --runtime=docker || return 1
  systemctl restart docker
}

# _gpu_list_undo LIST SAVED: after a failed set-up, the sources list as it
# was: SAVED put back, or the list this run wrote removed.
_gpu_list_undo() {
  if [[ -n $2 ]]; then mv -f "$2" "$1"; else rm -f "$1"; fi
}

# _gpu_daemon_undo: the command that puts Docker's settings back as they
# were before nvidia-ctk changed them, and restarts Docker.
_gpu_daemon_undo() {
  if [[ -n ${FF_GPU_DAEMON_BACKUP:-} ]]; then
    printf 'sudo cp %s %s && sudo systemctl restart docker' "$FF_GPU_DAEMON_BACKUP" "$FF_GPU_DAEMON_JSON"
  elif [[ -n ${FF_GPU_DAEMON_JSON:-} ]]; then
    printf 'sudo rm -f %s && sudo systemctl restart docker' "$FF_GPU_DAEMON_JSON"
  else
    printf 'sudo systemctl restart docker'
  fi
}

_ff_docker_ok() { [[ $(docker_status) == ok ]]; }

# _gpu_docker_back AGAIN: after a toolkit set-up that failed, Docker must
# answer before anything else runs: restarted once more when it does not,
# and when it still does not, a stop with the way back (AGAIN is the
# command to run afterwards). Nothing is pulled or started with Docker down.
_gpu_docker_back() {
  _ff_docker_ok && return 0
  _ff_logged systemctl restart docker || true
  _ff_wait_for "${FF_DOCKER_WAIT:-60}" 3 _ff_docker_ok && return 0
  install_fail "Docker did not come back after the NVIDIA change: nvidia-ctk changed Docker's settings in ${FF_GPU_DAEMON_JSON:-/etc/docker/daemon.json}, and Docker does not answer since it was restarted." \
    "put Docker's settings from before back and start it again: $(_gpu_daemon_undo). Then run $1 again; it stays on the CPU unless you choose the GPU again."
}

# _gpu_now_ready: detect again; 0 when Docker can use the GPU.
_gpu_now_ready() {
  detect_gpu
  [[ $FF_GPU_STATE == ready ]]
}

# _gpu_start_check: before update, restart, configure or rollback starts
# FreeFrame. With FREEFRAME_GPU=nvidia and a GPU Docker cannot use now (a
# driver broken by a kernel upgrade, a toolkit removed), the worker would
# not start with the GPU file, so this start leaves it out (FF_GPU_SKIP)
# and says video is processed on the CPU. The setting is kept, so a later
# start uses the GPU again once it works.
_gpu_start_check() {
  local root
  root=$(ff_root)
  FF_GPU_SKIP=""
  [[ $(env_get "$root/.env.prod" FREEFRAME_GPU) == nvidia && -f $root/docker-compose.gpu.yml ]] || return 0
  detect_gpu
  [[ $FF_GPU_STATE != ready ]] || return 0
  FF_GPU_SKIP=1
  _gpu_cpu_reason
  warn "The NVIDIA GPU cannot be used now ($FF_GPU_WHY), so FreeFrame starts with video processing on the CPU until that is fixed."
  warn "FREEFRAME_GPU=nvidia is kept: once the GPU works again, run: sudo freeframe restart"
}

# --- After a start: does the worker see the GPU? A worker created with the
# GPU reservation can lose it while it runs: on a host where Docker uses the
# systemd cgroup driver, `systemctl daemon-reload` takes the GPU devices
# away from running containers, NVIDIA's known "Failed to initialize NVML"
# issue (on WSL2: "GPU access blocked by the operating system"). A
# container created again has them back. FreeFrame's own commands reload
# only before a start or when the backup units changed (backup_units_install);
# this check is the backstop, after the last reload of each command. The
# transcoder falls back to the CPU on its own, so the check never fails a
# command: it starts the worker again once, and the messages say what is
# true.

FF_GPU_HELP="$FF_GUIDE_URL#troubleshooting-the-installer"

# _gpu_worker_log TEXT: one line of the check, into the log only, on a
# line of its own (the health check's curl leaves no newline).
_gpu_worker_log() {
  local pre=""
  [[ -n ${FF_LOG:-} ]] || return 0
  if [[ -n $(tail -c 1 "$FF_LOG" 2>/dev/null) ]]; then pre=$'\n'; fi
  { printf '%sGPU self-check: %s\n' "$pre" "$1" >>"$FF_LOG"; } 2>/dev/null || true
}

# _gpu_list_name TEXT: the GPU's name in the first line of nvidia-smi -L
# ("GPU 0: NVIDIA L4 (UUID: GPU-...)" gives "NVIDIA L4").
_gpu_list_name() {
  local name=${1%%$'\n'*}
  name=${name%$'\r'}
  name=${name#GPU *: }
  printf '%s' "${name% (UUID:*}"
}

_gpu_worker_running() { [[ -n $(dc_bounded 30 ps -q --status running worker 2>/dev/null) ]]; }

# _gpu_worker_sees: ask the worker as status does (nvidia-smi -L, whose
# first line starts with "GPU "). Its answer goes to the log; the name to
# FF_GPU_WORKER_NAME.
_gpu_worker_sees() {
  local out="" rc=0 line said=""
  out=$(dc_bounded 30 exec -T worker nvidia-smi -L 2>>"${FF_LOG:-/dev/null}") || rc=$?
  while IFS= read -r line; do
    line=${line%$'\r'}
    if [[ -n $line ]]; then said+="${said:+; }$line"; fi
  done <<<"$out"
  _gpu_worker_log "the worker's nvidia-smi -L said: ${said:-nothing} (exit $rc)"
  ((rc == 0)) && [[ $out == "GPU "* ]] || return 1
  FF_GPU_WORKER_NAME=$(_gpu_list_name "$out")
}

# _gpu_worker_wait: give the worker a moment to be running, bounded by the
# clock: FF_GPU_WORKER_WAIT seconds (60 by default) in all, counting each
# look (one can take up to 30 s), not only the pauses between them. 1 when
# it is still not running then; the caller asks it either way.
_gpu_worker_wait() {
  local max=${FF_GPU_WORKER_WAIT:-60} start=$SECONDS waited=0
  until _gpu_worker_running; do
    # The pauses are counted too, so the wait ends where the clock does not
    # move (the tests, where ff_sleep returns at once).
    if ((SECONDS - start >= max || waited >= max)); then
      _gpu_worker_log "the worker is not running after $((SECONDS - start)) seconds"
      return 1
    fi
    ff_sleep 2
    waited=$((waited + 2))
  done
}

# _gpu_worker_check [norecreate]: after a start that gave the worker the
# GPU (the GPU file in this start's compose files: FREEFRAME_GPU=nvidia,
# the file there and not left out by _gpu_start_check). Nothing at all
# otherwise. Asks the worker; when it does not see the GPU, creates it
# again once (a new container gets the reservation from the compose files
# as they are now, as freeframe restart does) and asks again. With
# norecreate (restart, which has just created every container and runs no
# reload) it only asks. Sets FF_GPU_WORKER: seen, unseen, down (the worker
# is not running at all, so no video is processed: saying "the CPU" would
# not be true), or empty (not checked); FF_GPU_WORKER_AGAIN=1 when it was
# created again. FREEFRAME_GPU is never changed, so a later start can use
# the GPU.
_gpu_worker_check() {
  local root running=1
  root=$(ff_root)
  FF_GPU_WORKER="" FF_GPU_WORKER_NAME="" FF_GPU_WORKER_AGAIN=""
  [[ $(compose_files "$root/.env.prod") == *"-f docker-compose.gpu.yml"* ]] || return 0
  _gpu_worker_wait || running=""
  if _gpu_worker_sees; then
    FF_GPU_WORKER=seen
    _gpu_worker_log "the worker sees the GPU ($FF_GPU_WORKER_NAME)"
    return 0
  fi
  if [[ ${1:-} != norecreate ]]; then
    _gpu_worker_log "the worker does not see the GPU; creating it again (docker compose up -d --no-build --no-deps --force-recreate worker)"
    FF_GPU_WORKER_AGAIN=1 running=1
    _ff_logged dc up -d --no-build --no-deps --force-recreate worker ||
      _gpu_worker_log "the worker could not be created again"
    _gpu_worker_wait || running=""
    if _gpu_worker_sees; then
      FF_GPU_WORKER=seen
      _gpu_worker_log "created again, the worker sees the GPU ($FF_GPU_WORKER_NAME)"
      return 0
    fi
  fi
  if [[ -z $running ]]; then
    FF_GPU_WORKER=down
    _gpu_worker_log "the worker is not running, so no video is processed until it starts (see: sudo freeframe logs worker)"
    return 0
  fi
  FF_GPU_WORKER=unseen
  _gpu_worker_log "the worker does not see the GPU: video is processed on the CPU for now (FREEFRAME_GPU=nvidia is kept)"
}

# _gpu_worker_named: " (NAME)" for the messages, or nothing when the name
# is not known.
_gpu_worker_named() {
  local n=${FF_GPU_WORKER_NAME:-${FF_GPU_NAME:-}}
  if [[ -n $n && $n != NVIDIA ]]; then printf ' (%s)' "$n"; fi
}

# _gpu_worker_try: what to do when the worker could not use the GPU
# (restart is only suggested where this run did not just do one).
_gpu_worker_try() {
  if [[ ${FF_CMD:-} == restart ]]; then
    printf 'FREEFRAME_GPU=nvidia is kept. If video stays on the CPU, see %s' "$FF_GPU_HELP"
  else
    printf 'FREEFRAME_GPU=nvidia is kept. To try the GPU again, run: sudo freeframe restart. If video stays on the CPU, see %s' "$FF_GPU_HELP"
  fi
}

# _gpu_worker_down_text: the worker is not running at all.
_gpu_worker_down_text() {
  printf 'The worker that processes video is not running, so no video is processed until it starts. See why with: sudo freeframe logs worker'
}

# _gpu_worker_said: where nvidia-smi's answer is (nothing without a log).
_gpu_worker_said() {
  if [[ -n ${FF_LOG:-} ]]; then printf ' What nvidia-smi said is in %s.' "$FF_LOG"; fi
}

# _gpu_worker_say: what _gpu_worker_check found, for update, rollback,
# restore, restart and configure.
_gpu_worker_say() {
  case ${FF_GPU_WORKER:-} in
    seen)
      if [[ -n ${FF_GPU_WORKER_AGAIN:-} ]]; then
        say "The worker did not see the GPU at first, so it was started again; it uses the GPU now."
      fi
      ;;
    unseen)
      if [[ -n ${FF_GPU_WORKER_AGAIN:-} ]]; then
        warn "The worker could not use the NVIDIA GPU$(_gpu_worker_named), even after it was started again, so video is processed on the CPU for now.$(_gpu_worker_said)"
      else
        warn "The worker could not use the NVIDIA GPU$(_gpu_worker_named), so video is processed on the CPU for now.$(_gpu_worker_said)"
      fi
      warn "$(_gpu_worker_try)"
      ;;
    down) warn "$(_gpu_worker_down_text)" ;;
  esac
  return 0
}

# _gpu_setup: set the toolkit up (its output goes to the log), then wait for
# Docker to come back with the nvidia runtime. 0 when the GPU is ready.
_gpu_setup() {
  _ff_logged install_nvidia_toolkit || return 1
  _ff_wait_for "${FF_DOCKER_WAIT:-60}" 3 _gpu_now_ready
}

# fetch REF PATH DEST: download PATH from the repository at REF (a branch or
# tag) to DEST. The old DEST stays in place unless the download completes.
# Returns 4 when REF does not have PATH (HTTP 404), 1 for any other failure.
# With FF_FETCH_FROM_DIR (test-only) PATH is copied from that folder instead,
# and a file missing there counts as one REF does not have.
fetch() {
  local ref=$1 path=$2 dest=$3 tmp code="" rc=0
  tmp=$(mktemp "$dest.tmp.XXXXXX") || return 1
  if [[ -n ${FF_FETCH_FROM_DIR:-} ]]; then
    if [[ ! -e $FF_FETCH_FROM_DIR/$path ]]; then
      rm -f "$tmp"
      return 4
    fi
    cp "$FF_FETCH_FROM_DIR/$path" "$tmp" || rc=1
  else
    code=$(curl -fsSL --retry 3 --max-time 60 -w '%{http_code}' "$FF_RAW_BASE/$ref/$path" -o "$tmp") || rc=1
  fi
  if ((rc)); then
    rm -f "$tmp"
    [[ $code != 404 ]] || return 4
    return 1
  fi
  chmod 644 "$tmp" && mv -f "$tmp" "$dest"
}

# probe_health MODE HOST: 0 when FreeFrame's API answers through Traefik on
# this server. HTTPS is checked with HOST sent to 127.0.0.1, so it works
# before outside DNS or hairpin routing does, and with -k because the
# certificate is checked separately (cert_issued).
probe_health() {
  local mode=$1 host=$2
  # Retries are expected while it starts: curl's complaints go to the log.
  if [[ $mode == off ]]; then
    curl -fsS --max-time 10 -o /dev/null http://127.0.0.1/api/health 2>>"${FF_LOG:-/dev/null}"
  else
    curl -fsSk --max-time 10 -o /dev/null --resolve "$host:443:127.0.0.1" "https://$host/api/health" \
      2>>"${FF_LOG:-/dev/null}"
  fi
}

# cert_issued HOST: 0 when Traefik serves a real certificate for HOST, not
# its self-signed TRAEFIK DEFAULT CERT.
cert_issued() {
  local host=$1 issuer
  issuer=$({ timeout 20 openssl s_client -connect 127.0.0.1:443 -servername "$host" </dev/null 2>/dev/null || true; } |
    openssl x509 -noout -issuer 2>/dev/null) || return 1
  [[ -n $issuer && $issuer != *"TRAEFIK DEFAULT CERT"* ]]
}

# ------------------------------------------------------------
# Install: messages and small helpers
# ------------------------------------------------------------

say() { printf '%s\n' "$*"; }

# _ff_logged CMD...: run CMD with its output going to install.log only.
_ff_logged() { "$@" >>"${FF_LOG:-/dev/null}" 2>&1; }

# --- How the install looks on the screen. _ff_screen_setup decides, while
# the output still goes straight to the terminal, whether to use colour
# (FF_COLOR) and how wide to wrap text (FF_WIDTH; 0 means no wrapping).
# Without a terminal (cloud-init, CI, the tests) there is no colour and no
# wrapping, so every line is printed whole. The other commands never call
# it, so their output does not change.

# _ff_utf8: 0 when the locale can show the line and dot characters.
_ff_utf8() {
  case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
    *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) return 0 ;;
  esac
  return 1
}

# _ff_term_cols: the terminal's width in columns, when it can be read.
_ff_term_cols() {
  local size
  size=$({ stty size <"$(_ff_tty_path)"; } 2>/dev/null) || size=""
  if [[ $size =~ ^[0-9]+\ ([0-9]+)$ ]] && ((BASH_REMATCH[1] > 0)); then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  tput cols 2>/dev/null
}

# _ff_screen_setup: colour only on a terminal, with NO_COLOR unset and TERM
# not dumb (FF_FORCE_COLOR=1, for the tests, stands in for the terminal),
# and only when perl is there to keep the colour codes out of install.log.
# Text wraps to the terminal's width (or COLUMNS), at most 78 columns; when
# the width cannot be read it is 78.
_ff_screen_setup() {
  local cols=""
  FF_COLOR=""
  if [[ -z ${NO_COLOR:-} && ${TERM:-} != dumb ]] && { [[ -n ${FF_FORCE_COLOR:-} ]] || [[ -t 1 ]]; } &&
    command -v perl >/dev/null 2>&1; then
    FF_COLOR=1
  fi
  if [[ ${COLUMNS:-} =~ ^[0-9]+$ ]]; then
    cols=$((10#$COLUMNS))
  elif [[ -t 1 ]]; then
    cols=$(_ff_term_cols) || cols=""
    [[ $cols =~ ^[0-9]+$ ]] || cols=79
  fi
  FF_WIDTH=0
  if [[ -n $cols ]] && ((cols > 0)); then
    FF_WIDTH=$((cols - 1))
    ((FF_WIDTH <= 78)) || FF_WIDTH=78
    ((FF_WIDTH >= 30)) || FF_WIDTH=30
  fi
  if _ff_utf8; then FF_DOT="·" FF_RULE="─"; else FF_DOT="-" FF_RULE="-"; fi
}

# _ff_style SGR TEXT: TEXT in a style (1 bold, 2 dim, 32 green, 31 red)
# when colour is on, otherwise as it is.
_ff_style() {
  if [[ -n ${FF_COLOR:-} && -n $1 ]]; then printf '\e[%sm%s\e[0m' "$1" "$2"; else printf '%s' "$2"; fi
}

# _ff_lines FIRST REST SGR TEXT: TEXT wrapped to FF_WIDTH columns. The first
# line starts with FIRST and the others with REST, and the text is in style
# SGR. Lines break only between words; a word longer than a line gets a
# line to itself. With FF_WIDTH 0, each line of TEXT is printed whole.
_ff_lines() {
  local first=$1 rest=$2 sgr=$3 text=$4 width=${FF_WIDTH:-0} pre line="" word part
  local -a words=()
  # Several lines: each is wrapped on its own, and the breaks (and empty
  # lines) are kept; the lines after the first start with REST.
  if [[ $text == *$'\n'* ]]; then
    pre=$first
    while IFS= read -r part; do
      if [[ -z $part ]]; then printf '\n'; else _ff_lines "$pre" "$rest" "$sgr" "$part"; fi
      pre=$rest
    done <<<"$text"
    return 0
  fi
  if ((width <= 0)); then
    printf '%s%s\n' "$first" "$(_ff_style "$sgr" "$text")"
    return 0
  fi
  read -ra words <<<"$text"
  pre=$first
  for word in ${words[@]+"${words[@]}"}; do
    if [[ -z $line ]]; then
      line=$word
    elif ((${#pre} + ${#line} + 1 + ${#word} <= width)); then
      line+=" $word"
    else
      printf '%s%s\n' "$pre" "$(_ff_style "$sgr" "$line")"
      pre=$rest
      line=$word
    fi
  done
  printf '%s%s\n' "$pre" "$(_ff_style "$sgr" "$line")"
}

# _ff_p TEXT: a paragraph, one space in from the edge. _ff_pw: on stderr.
_ff_p() { _ff_lines " " " " "" "$*"; }
_ff_pw() { _ff_lines " " " " "" "$*" >&2; }

# _ff_hint N TEXT: a dim note, N spaces in.
_ff_hint() {
  local pad
  printf -v pad '%*s' "$1" ''
  _ff_lines "$pad" "$pad" 2 "$2"
}

# _ff_msg TEXT: a message line on stderr, wrapped unless it holds a command
# to copy (sudo, curl or freeframe), which must stay on one line.
_ff_msg() {
  case $1 in
    *"sudo "* | *"curl "* | *"freeframe "*) warn "$1" ;;
    *) _ff_lines "" "" "" "$1" >&2 ;;
  esac
}

# _ff_heading TITLE: a bold heading line, "── TITLE ────", after a blank line.
_ff_heading() {
  local title=$1 width=${FF_WIDTH:-0} r=${FF_RULE:--} line
  ((width > 0)) || width=62
  line="$r$r $title "
  while ((${#line} < width - 1)); do line+=$r; done
  say ""
  say " $(_ff_style 1 "$line")"
}

# _ff_menu_item N LABEL [VALUE] [HINT]: one numbered choice. VALUE (an
# address, say) sits in a column after the label, or on the next line when
# it does not fit; HINT is a dim line under it.
_ff_menu_item() {
  local n=$1 label=$2 value=${3:-} hint=${4:-} width=${FF_WIDTH:-0} line
  printf -v line '   %s) %-37s%s' "$n" "$label" "$value"
  line=${line%"${line##*[! ]}"}
  if ((width <= 0 || ${#line} <= width)); then
    say "$line"
  else
    _ff_lines "   $n) " "      " "" "$label"
    if [[ -n $value ]]; then _ff_lines "      " "      " "" "$value"; fi
  fi
  if [[ -n $hint ]]; then _ff_hint 6 "$hint"; fi
}

# _ff_choices N: "1 or 2", "1, 2 or 3".
_ff_choices() {
  local i out=""
  for ((i = 1; i < $1; i++)); do out+="${out:+, }$i"; done
  printf '%s or %s' "$out" "$1"
}

# _ff_open TEXT: start a line that a check finishes (_ff_line_close).
_ff_open() {
  printf '%s' "$1"
  FF_LINE_OPEN=1
}

# _ff_line_close [WORD]: finish a line _ff_open started, with WORD (in red)
# when the check stopped there, so later messages start on a line of their
# own.
_ff_line_close() {
  [[ -n ${FF_LINE_OPEN:-} ]] || return 0
  FF_LINE_OPEN=""
  if [[ -n ${1:-} ]]; then printf ' %s\n' "$(_ff_style 31 "$1")"; else printf '\n'; fi
}

# _ff_stop CODE MESSAGE [WHAT_TO_TRY]: print the message and exit with CODE.
# Once install.log exists, also say what was already done and where the log
# is.
_ff_stop() {
  _ff_line_close stopped
  warn ""
  _ff_msg "$2"
  if [[ -n ${3:-} ]]; then _ff_msg "What to try: $3"; fi
  _ff_already_done
  if [[ -n ${FF_LOG:-} ]]; then warn "Everything ${FF_ACTOR:-the installer} did is written to $FF_LOG."; fi
  exit "$1"
}

# _ff_already_done: name each program the installer stopped to free a port,
# with the command that starts it again.
_ff_already_done() {
  local entry
  for entry in ${FF_STOPPED[@]+"${FF_STOPPED[@]}"}; do
    warn "Already done: stopped ${entry%%|*} to free a port for FreeFrame. To start it again: sudo systemctl enable --now ${entry#*|}"
  done
}

# _ff_term_say LINE...: print to the terminal only, never into install.log
# (for the generated admin password). Waits a moment first so tee has
# written what came before.
_ff_term_say() {
  local fd=${FF_TERM_ERR:-2}
  sleep 0.2 2>/dev/null || true
  printf '%s\n' "$@" >&"$fd"
}

# _install_tell_password: the generated admin password, on the terminal.
_install_tell_password() {
  _ff_term_say "" "The admin password made for you: $FF_ADMIN_PASSWORD" \
    "Write it down now: it is shown on the screen only and saved nowhere." ""
}

# _install_done WHAT: note a change the install has made to the server, so
# that a later failure says what is already in place (FF_STATE), not that
# only the log was written.
_install_done() {
  local list="" item
  FF_DONE+=("$1")
  for item in "${FF_DONE[@]}"; do list+="${list:+; }$item"; done
  FF_STATE="Already done: $list. FreeFrame itself is not set up yet; running ${FF_RERUN:-the install command} again keeps this and continues from here."
}

# install_fail MESSAGE WHAT_TO_TRY: a step failed. Says what state the
# server is in and where the log is, then exits 1. When this run created the
# admin account with a generated password, the password is repeated (on the
# terminal only), because a re-run cannot create the account again.
install_fail() {
  _ff_line_close stopped
  warn ""
  _ff_msg "$1"
  if [[ -n ${2:-} ]]; then _ff_msg "What to try: $2"; fi
  # FF_STATE_PREFIX: the state of a larger job this step belongs to (the
  # rollback around its restore).
  if [[ -n ${FF_STATE_PREFIX:-} ]]; then warn "$FF_STATE_PREFIX"; fi
  if [[ -n ${FF_STATE:-} ]]; then warn "$FF_STATE"; fi
  _ff_already_done
  if [[ -n ${FF_LOG:-} ]]; then warn "Everything ${FF_ACTOR:-the installer} did is written to $FF_LOG."; fi
  if [[ -n ${FF_ADMIN_CREATED:-} && -n ${FF_PW_GENERATED:-} ]]; then
    _ff_term_say "" "The admin account for $FF_ADMIN_EMAIL was created, with the password made for you:" \
      "  $FF_ADMIN_PASSWORD" "Write it down now: it is shown on the screen only and saved nowhere."
  fi
  # Let tee finish writing, so every line is on the screen before the
  # prompt comes back. Bounded: when this runs inside a redirection (a trap
  # during `_ff_logged ...`), bash still holds a saved copy of the pipe, so
  # tee only ends when this script does.
  if [[ -n ${FF_TERM_OUT:-} ]]; then
    exec 1>&"$FF_TERM_OUT" 2>&"$FF_TERM_ERR"
    _ff_wait_tee 20
  fi
  exit 1
}

# _ff_wait_tee TENTHS: wait up to TENTHS tenths of a second for tee to end.
_ff_wait_tee() {
  local i=0
  while ((i < $1)) && kill -0 "${FF_TEE_PID:-0}" 2>/dev/null; do
    sleep 0.1
    i=$((i + 1))
  done
  return 0
}

# _ff_answer_error MESSAGE WHAT_TO_TRY: an answer given ahead of time is not
# usable (exit 2, like any other usage error).
_ff_answer_error() { _ff_stop 2 "$1" "$2"; }

# _ff_answer_missing: after require_answer has said which answer is
# missing, exit 2 the same way as every other stop (log named, programs
# already stopped listed).
_ff_answer_missing() {
  # FF_ANSWER_STATE: what is already in place, when the answer is found
  # missing after the server was changed (_install_admin_later).
  if [[ -n ${FF_ANSWER_STATE:-} ]]; then warn "$FF_ANSWER_STATE"; fi
  _ff_already_done
  if [[ -n ${FF_LOG:-} ]]; then warn "Everything the installer did is written to $FF_LOG."; fi
  if [[ -n ${FF_ANSWER_STATE:-} && -n ${FF_TERM_OUT:-} ]]; then
    exec 1>&"$FF_TERM_OUT" 2>&"$FF_TERM_ERR"
    _ff_wait_tee 20
  fi
  exit 2
}

_ff_input_ended() {
  if [[ ${FF_CMD:-install} == configure ]]; then
    _ff_stop 2 "The answers ended before every question was answered, so nothing was changed." \
      "run sudo freeframe configure in a terminal, or give the new answers as options with --yes (to see them all, run: $(_ff_help_cmd))."
  fi
  _ff_stop 2 "The answers ended before every question was answered, so nothing was installed." \
    "run the installer in a terminal, or give every answer ahead of time with --yes (to see them all, run: $(_ff_help_cmd))."
}

# _install_on_error: the ERR trap. A command failed that the installer did
# not expect to fail; say so in plain words instead of stopping silently.
_install_on_error() {
  local code=$?
  if ((BASH_SUBSHELL > 0)); then exit "$code"; fi
  trap - ERR
  install_fail "The installer stopped unexpectedly while ${FF_STEP:-checking the server} (error $code)." \
    "look at the end of ${FF_LOG:-the output above} for the reason, then run ${FF_RERUN:-the install command} again."
}

_ff_interactive() { [[ -z ${FF_YES:-} ]] && _ff_has_tty; }

_ff_is_ipv4() { [[ ${1:-} =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; }

valid_email() {
  local re='^[^@[:space:]]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$'
  [[ ${1:-} =~ $re ]]
}

# _ff_password_ok PW: 8 to 72 bytes, what the API accepts.
_ff_password_ok() {
  local LC_ALL=C
  ((${#1} >= 8 && ${#1} <= 72))
}

# _ff_clean_host TEXT: forgive a pasted https:// or a trailing slash.
_ff_clean_host() {
  local h=${1,,}
  h=${h#"${h%%[![:space:]]*}"}
  h=${h%"${h##*[![:space:]]}"}
  h=${h#http://}
  h=${h#https://}
  h=${h%/}
  printf '%s' "$h"
}

# _ff_json_str TEXT: TEXT as a JSON string: \ and " escaped, and every
# control character below 0x20 written as \u00XX, so the result is always
# valid JSON.
_ff_json_str() {
  local s=$1 c rep i
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  for ((i = 1; i < 32; i++)); do
    printf -v c '%b' "\\0$(printf '%o' "$i")"
    [[ $s == *"$c"* ]] || continue
    printf -v rep '\\u%04x' "$i"
    s=${s//"$c"/"$rep"}
  done
  printf '"%s"' "$s"
}

# _ff_api_detail BODY: the human part of a FastAPI error response.
_ff_api_detail() {
  local body=$1 re_msg='"msg":"([^"]*)"' re_detail='"detail":"([^"]*)"'
  if [[ $body =~ $re_msg ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  elif [[ $body =~ $re_detail ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

# _ff_wait_for MAX STEP CMD...: run CMD every STEP seconds until it works,
# for at most MAX seconds. 1 when it never worked.
_ff_wait_for() {
  local max=$1 step=$2 waited=0
  shift 2
  until "$@"; do
    ((waited < max)) || return 1
    ff_sleep "$step"
    waited=$((waited + step))
  done
}

_ff_scheme() { if [[ $1 == off ]]; then printf 'http'; else printf 'https'; fi; }

# _ff_dns_label NAME: what most registrars want in the "name" box:
# review.yourstudio.com becomes review, the bare domain becomes @.
_ff_dns_label() {
  local name=$1 rest
  rest=${name#*.}
  if [[ $rest == *.* ]]; then
    printf '%s' "${name%.*.*}"
  else
    printf '@'
  fi
}

# switch_to_http_mode FILE ADDRESS: move an HTTPS install to plain HTTP on
# ADDRESS (usually the server's IP). Backs up FILE first, then changes only
# the keys tied to the web address (FREEFRAME_HTTPS, FRONTEND_URL, DOMAIN and,
# with bundled storage, S3_PUBLIC_ENDPOINT, STORAGE_DOMAIN, STORAGE_ROUTED,
# STORAGE_PORT_BIND), and restarts FreeFrame so every service picks them up.
# Secrets and every other answer stay as they are. Used by install when the
# automatic address cannot get a certificate, and by configure.
switch_to_http_mode() {
  local file=$1 address=$2 backup
  if ! valid_hostname "$address"; then
    warn "Cannot switch to plain HTTP: '$address' is not a usable address."
    return 1
  fi
  backup=$(env_backup "$file") || return 1
  env_set "$file" FREEFRAME_HTTPS off || return 1
  env_set "$file" FRONTEND_URL "http://$address" || return 1
  env_set "$file" DOMAIN "" || return 1
  if [[ $(env_get "$file" FREEFRAME_STORAGE) == bundled ]]; then
    env_set "$file" S3_PUBLIC_ENDPOINT "http://$address:9000" || return 1
    env_set "$file" STORAGE_DOMAIN "" || return 1
    env_set "$file" STORAGE_ROUTED false || return 1
    env_set "$file" STORAGE_PORT_BIND 0.0.0.0:9000 || return 1
  fi
  say "FreeFrame now uses plain HTTP at http://$address. The previous settings are saved in $backup."
  if ! _ff_logged dc up -d --no-build --force-recreate; then
    warn "FreeFrame could not be restarted with the new settings."
    return 1
  fi
}

# ------------------------------------------------------------
# Install: the steps, in the order cmd_install runs them
# ------------------------------------------------------------

# _install_self: put this script at /usr/local/bin/freeframe (mode 755), so
# the other commands exist afterwards. install.sh runs a downloaded copy and
# writes nothing itself; this runs only once the install is going ahead, so
# a refused or cancelled run leaves no command behind, and an installed
# server's command is replaced only by `freeframe update`.
_install_self() {
  local src=${BASH_SOURCE[0]} dir=${FF_BIN_DIR:-/usr/local/bin}
  [[ -f $src ]] || install_fail "Cannot find the freeframe script that is running ($src)." "run the install command again."
  if [[ -e $dir/freeframe ]] && cmp -s "$src" "$dir/freeframe"; then
    FF_RERUN="sudo freeframe install"
    return 0
  fi
  if ! { mkdir -p "$dir" && install -m 755 "$src" "$dir/freeframe"; }; then
    install_fail "Could not install the freeframe command into $dir." "check that the disk is not full or read-only, then run the install command again."
  fi
  FF_RERUN="sudo freeframe install"
  _install_done "installed the freeframe command at $dir/freeframe"
}

_install_check_system() {
  local id ver pretty arch
  if ! ff_is_root; then
    _ff_stop 2 "Please run the installer as root." \
      "put sudo in front of the command: sudo freeframe install (in the one-line install command: sudo bash -c \"\$(curl ...)\")."
  fi
  id=$(_ff_os_field ID)
  ver=$(_ff_os_field VERSION_ID)
  pretty=$(_ff_os_field PRETTY_NAME)
  if [[ -z $id ]]; then
    case $(_ff_kernel) in
      Darwin) pretty="macOS" ;;
      Linux | "") pretty="a Linux system the installer cannot identify (it has no /etc/os-release)" ;;
      *) pretty=$(_ff_kernel) ;;
    esac
    _ff_stop 3 "This computer runs $pretty, and the installer is for Linux servers only, so nothing was changed." \
      "use a server with Ubuntu 22.04, 24.04 or 26.04, or Debian 12 or 13, on amd64 or arm64. Elsewhere (a Mac with Docker Desktop, or another Linux), set FreeFrame up by hand as the guide explains: $FF_GUIDE_URL#quick-setup"
  fi
  if ! os_supported "$id" "$ver"; then
    _ff_stop 3 "This server runs ${pretty:-an unknown system} (${id:-unknown} ${ver:-}), which is not supported yet, so nothing was changed." \
      "use a server with Ubuntu 22.04, 24.04 or 26.04, or Debian 12 or 13. To set FreeFrame up by hand on another system, follow the guide: $FF_GUIDE_URL"
  fi
  arch=$(machine_arch)
  case $arch in
    x86_64 | amd64 | aarch64 | arm64) ;;
    *)
      _ff_stop 3 "This server's processor type ($arch) is not supported yet, so nothing was changed. FreeFrame runs on amd64 (x86_64) and arm64 servers." \
        "choose a server with an amd64 or arm64 processor."
      ;;
  esac
}

_install_check_foreign() {
  local rc=0 saved
  detect_foreign_install || rc=$?
  case $rc in
    0)
      # FreeFrame's volumes without the settings file, and nothing else, are
      # also what an uninstall that kept the data leaves: point at the
      # settings it saved. A git checkout or a clone's container never is.
      saved=$(_uninstall_saved_settings)
      if [[ ${FF_FOREIGN_WHY:-} == own-volume && -n $saved && ! -e $(ff_root)/.env.prod ]]; then
        _ff_stop 3 "This server has FreeFrame's data (its Docker volumes) but not this installer's settings file, so nothing was changed." \
          "if a freeframe uninstall kept that data, put the settings it saved back, then run the install command again: sudo mkdir -p $(_ff_q "$(ff_root)") && sudo install -m 600 $(_ff_q "$saved") $(_ff_q "$(ff_root)/.env.prod"). If the data belongs to a FreeFrame set up by hand instead, the installer will not touch it: keep updating that one with the manual steps in the guide: $FF_GUIDE_URL"
      fi
      _ff_stop 3 "This server already runs FreeFrame that was set up by hand, not with this installer. The installer will not touch it, so nothing was changed." \
        "keep updating that FreeFrame with the manual steps in the guide: $FF_GUIDE_URL"
      ;;
    1) ;;
    *) _ff_stop 1 "The installer could not check this server for an existing FreeFrame, so it stopped before changing anything." ;;
  esac
}

# FF_TEE_PLAIN: a tee for coloured output (perl, which every Debian and
# Ubuntu has): standard input goes to standard output unchanged, and to the
# file named first without its colour codes. A code cut in two by a read is
# held back until the rest arrives. Writing to the screen may fail (a closed
# terminal); the file is still written, as tee does.
# shellcheck disable=SC2016
FF_TEE_PLAIN='
sub put { my ($fh, $s) = @_; while (length $s) { my $w = syswrite($fh, $s); return unless defined $w; substr($s, 0, $w) = ""; } }
open(my $log, ">>", $ARGV[0]) or die "cannot open $ARGV[0]: $!\n";
my $held = "";
while (1) {
  my $n = sysread(STDIN, my $buf, 65536);
  if (!defined $n) { next if $!{EINTR}; last; }
  last if $n == 0;
  put(\*STDOUT, $buf);
  $buf = $held . $buf;
  $held = ($buf =~ s/(\e(?:\[[0-9;]*)?)\z//) ? $1 : "";
  $buf =~ s/\e\[[0-9;]*[A-Za-z]//g;
  put($log, $buf);
}
put($log, $held);
'

# _install_log_start [COMMAND]: from here on, everything printed also goes
# to install.log (mode 600), under a header naming COMMAND (install).
_install_log_start() {
  local root what=${1:-install}
  root=$(ff_root)
  # Created as 755; an existing folder keeps its own (possibly stricter) mode.
  if ! { { [[ -d $root ]] || { mkdir -p "$(dirname "$root")" && mkdir -m 755 "$root"; }; } &&
    (umask 077 && : >>"$root/install.log") &&
    chmod 600 "$root/install.log"; }; then
    _ff_stop 1 "Cannot create $root for FreeFrame's files." "check that the disk is not full or read-only, then run the installer again."
  fi
  FF_LOG="$root/install.log"
  printf '\n===== freeframe %s, %s =====\n' "$what" "$(date '+%Y-%m-%d %H:%M:%S %z')" >>"$FF_LOG"
  # Everything printed from here on goes to the terminal and to install.log.
  # The terminal's own fds are kept, for the one line the log must not hold.
  exec {FF_TERM_OUT}>&1 {FF_TERM_ERR}>&2
  # tee ignores Ctrl-C, a closed terminal and TERM, which reach the whole
  # process group: it must outlive this script so the message that says
  # what was interrupted still reaches the screen and the log (a dead tee
  # would end the script with SIGPIPE at its next line instead). It ends
  # when this script does.
  # With colour on, perl stands in for tee: the screen gets every byte as
  # it comes (a question has no newline yet), install.log the same text
  # without the colour codes.
  if [[ -n ${FF_COLOR:-} ]]; then
    exec > >(trap '' INT TERM HUP; exec perl -e "$FF_TEE_PLAIN" "$FF_LOG") 2>&1
  else
    exec > >(trap '' INT TERM HUP; exec tee -a "$FF_LOG") 2>&1
  fi
  FF_TEE_PID=$!
}

# _install_log_stop: back to the plain terminal, once tee has written
# everything, so what follows comes after it on the screen.
_install_log_stop() {
  [[ -n ${FF_TERM_OUT:-} ]] || return 0
  exec 1>&"$FF_TERM_OUT" 2>&"$FF_TERM_ERR"
  wait "$FF_TEE_PID" 2>/dev/null || true
}

# install_find_ip: FF_IP, the address the DNS records and the automatic
# sslip.io address use, and FF_LOCAL_IP, the interface address (the source
# of the default route). A public interface address is used as both. When
# the interface address is private and the internet sees a different public
# one, the server is behind NAT (FF_NAT=1): an office server behind a
# router, or a cloud server behind a gateway. Plain HTTP then uses the
# interface address (_install_http_ip).
install_find_ip() {
  local pub=""
  FF_NAT=""
  FF_LOCAL_IP=$(local_ip) || FF_LOCAL_IP=""
  if is_public_ipv4 "$FF_LOCAL_IP"; then
    FF_IP=$FF_LOCAL_IP
    return 0
  fi
  pub=$(public_ip) || pub=""
  if is_public_ipv4 "$pub"; then
    FF_IP=$pub
    if [[ -n $FF_LOCAL_IP && $FF_LOCAL_IP != "$pub" ]]; then FF_NAT=1; fi
  else
    FF_IP=$FF_LOCAL_IP
  fi
  if [[ -z $FF_IP ]]; then
    install_fail "Could not find this server's IP address." "check the server's network connection, then run the installer again."
  fi
}

# _install_check_port PORT SERVICE NEED: make sure PORT is free (or held by
# this install's own SERVICE from an earlier attempt). Offers to stop the
# program holding it when there is a terminal.
_install_check_port() {
  local port=$1 service=$2 need=$3 holder name pid unit=""
  holder=$(port_holder "$port")
  [[ -n $holder ]] || return 0
  name=${holder% *}
  pid=${holder##* }
  [[ $name != unknown ]] || name="another program"
  if [[ $name == docker-proxy ]]; then
    if [[ -f "$(ff_root)/.env.prod" && -n $(dc ps -q "$service" 2>/dev/null) ]]; then
      return 0
    fi
    install_fail "Port $port is used by another program running in Docker. $need" \
      "stop that program (sudo docker ps lists what runs in Docker), then run the installer again."
  fi
  unit=$(_ff_unit_of_pid "$pid") || unit=""
  if [[ $unit == *.service ]] && _ff_interactive; then
    _ff_line_close
    say "Port $port is used by $name ($unit). $need"
    if confirm "Stop $name now and keep it from starting again?" N; then
      if ! _ff_logged systemctl disable --now "$unit"; then
        install_fail "Could not stop $name." "stop it yourself (sudo systemctl disable --now $unit), then run the installer again."
      fi
      # Listed as stopped (with the command that starts it again) only once
      # it really was.
      FF_STOPPED+=("$name|$unit")
      if [[ -n $(port_holder "$port") ]]; then
        install_fail "Port $port is still in use after stopping $name." "find what holds it with: sudo ss -ltnp, stop it, then run the installer again."
      fi
      say "Stopped $name."
      return 0
    fi
  fi
  if [[ $unit == *.service ]]; then
    install_fail "Port $port is used by $name. $need" "stop $name (sudo systemctl disable --now $unit), then run the installer again."
  fi
  install_fail "Port $port is used by $name. $need" "stop $name, then run the installer again."
}

install_preflight() {
  local cores ram free path last="" docker_free=""
  FF_STEP="checking the server"
  FF_NOTES=()
  # Detected before the welcome (_install_gpu_check), shown here.
  FF_CHECK_GPU=$(_gpu_line)
  if [[ -n ${FF_GPU_NOTE:-} ]]; then FF_NOTES+=("$FF_GPU_NOTE"); fi
  _ff_open " Checking this server ..."
  cores=${FF_CORES:-$(_ff_cores)}
  ram=${FF_RAM_MB:-$(_ff_ram_mb)}
  if ((ram < 1800)); then
    _ff_stop 3 "This server has $ram MB of memory. FreeFrame needs at least 2 GB (4 GB is recommended), so the installer stopped before installing anything." \
      "choose a server with 4 GB of memory or more."
  elif ((ram < 3600)); then
    FF_NOTES+=("This server has about $(((ram + 512) / 1024)) GB of memory. FreeFrame runs, but 4 GB or more is recommended: large videos will be slow to prepare.")
  fi
  if ((cores < 2)); then
    FF_NOTES+=("This server has 1 processor core. FreeFrame runs, but 2 or more are recommended.")
  fi
  for path in /opt /var/lib/docker; do
    free=$(_ff_free_mb "$path") || free=""
    [[ $path != /var/lib/docker ]] || docker_free=$free
    # Usually one filesystem holds both: warn once.
    [[ $free != "$last" ]] || continue
    last=$free
    if [[ $free =~ ^[0-9]+$ ]] && ((free < 20480)); then
      FF_NOTES+=("There is only about $((free / 1024)) GB of free disk space for $path. 20 GB or more is recommended, and much more when footage is kept on this server.")
    fi
  done
  local dot=${FF_DOT:--}
  FF_CHECK_FOUND="$(_install_os_name) $dot $cores core$( ((cores == 1)) || printf s) $dot $(((ram + 512) / 1024)) GB memory"
  if [[ $docker_free =~ ^[0-9]+$ ]]; then FF_CHECK_FOUND+=" $dot $((docker_free / 1024)) GB free"; fi

  FF_DOCKER=$(docker_status)
  case $FF_DOCKER in
    ok | none) ;;
    snap)
      _ff_stop 3 "Docker on this server was installed with snap, which FreeFrame cannot use, so the installer stopped before installing anything." \
        "if nothing else on this server uses Docker, remove it with: sudo snap remove --purge docker. Then run the installer again: it installs Docker from Docker's own repository."
      ;;
    old*)
      _ff_stop 3 "This server has Docker ${FF_DOCKER#old }, but FreeFrame needs Docker 24 or newer, so the installer stopped before installing anything." \
        "update Docker (https://docs.docker.com/engine/install/), or if nothing else on this server uses it, remove it and run the installer again: it then installs a current Docker itself."
      ;;
    nocompose)
      _ff_stop 3 "Docker is installed without its compose plugin, which FreeFrame needs, so the installer stopped before installing anything." \
        "install the plugin (sudo apt-get install docker-compose-plugin, or docker-compose-v2 for Ubuntu's own Docker), then run the installer again."
      ;;
    *)
      install_fail "Docker is installed but does not answer." "run: sudo systemctl start docker, then run the installer again."
      ;;
  esac

  _install_check_port 80 traefik "FreeFrame needs ports 80 and 443 for its web address."
  _install_check_port 443 traefik "FreeFrame needs ports 80 and 443 for its web address."

  if ! net_reachable https://ghcr.io/v2/; then
    install_fail "This server cannot reach ghcr.io, where FreeFrame is downloaded from." \
      "check the server's internet connection, and that the provider's firewall allows outgoing HTTPS (port 443), then run the installer again."
  fi
  if [[ $FF_DOCKER == none ]] && ! net_reachable "https://download.docker.com/linux/"; then
    install_fail "This server cannot reach download.docker.com, where Docker is downloaded from." \
      "check the server's internet connection, and that the provider's firewall allows outgoing HTTPS (port 443), then run the installer again."
  fi
  install_find_ip
  _install_check_done
}

# _install_os_name: this server's system, as "Ubuntu 26.04".
_install_os_name() {
  local name ver
  name=$(_ff_os_field NAME)
  [[ -n $name ]] || name=$(_ff_os_field ID)
  ver=$(_ff_os_field VERSION_ID)
  printf '%s' "${name:-Linux}${ver:+ $ver}"
}

# _install_check_done: finish the server check line with what was found,
# then the GPU line, then the notes (low memory or disk space, the GPU)
# under it.
_install_check_done() {
  local ok note width=${FF_WIDTH:-0}
  ok=$(_ff_style 32 ok)
  if [[ -n ${FF_LINE_OPEN:-} ]]; then
    FF_LINE_OPEN=""
  else
    printf ' Checking this server ...'
  fi
  if ((width <= 0 || 31 + ${#FF_CHECK_FOUND} + 1 <= width)); then
    printf ' %s  (%s)\n' "$ok" "$FF_CHECK_FOUND"
  else
    printf ' %s\n' "$ok"
    _ff_lines "   (" "    " "" "$FF_CHECK_FOUND)"
  fi
  if [[ -n ${FF_CHECK_GPU:-} ]]; then _ff_lines "   " "     " "" "$FF_CHECK_GPU"; fi
  for note in ${FF_NOTES[@]+"${FF_NOTES[@]}"}; do
    _ff_lines "   Note: " "         " "" "$note" >&2
  done
}

# --- Questions (spec goal 3). Each one is skipped when the answer was given
# ahead of time or is already in the settings file (settings copied from
# another server, or an earlier attempt).

# The channel follows ff_channel: --channel (install.sh always passes the
# ref it downloaded this script from) wins over the settings file's, so the
# script and the setup files come from the same ref. The settings step
# saves it.
_install_ask_channel() {
  local file=$1 ref
  ref=$(ff_channel "$file")
  if ! _ff_valid_ref "$ref"; then
    _ff_answer_error "The channel '$ref' is not a branch or tag name such as stable or latest." "use --channel stable or --channel latest."
  fi
  FF_CHANNEL=$ref
}

# _install_http_ip: the address plain HTTP uses when no name was given: the
# interface (LAN) address behind NAT, otherwise FF_IP. Needs install_find_ip
# first; configure uses the pair to pick the address for switch_to_http_mode.
_install_http_ip() {
  if [[ -n ${FF_NAT:-} ]]; then printf '%s' "$FF_LOCAL_IP"; else printf '%s' "$FF_IP"; fi
}

# --- The question steps. Each is "Step N of M" (_install_step); M counts
# only the steps this run asks (_install_count_steps, worked out before the
# welcome), so the numbers always run 1, 2, 3 without a gap. The
# certificate email belongs to the web address step.

# _install_step TITLE: the next step's heading.
_install_step() {
  local total
  FF_QNUM=$((${FF_QNUM:-0} + 1))
  total=${FF_QTOTAL:-0}
  ((total >= FF_QNUM)) || total=$FF_QNUM
  _ff_heading "Step $FF_QNUM of $total ${FF_DOT:--} $1"
}

# _install_mode_ahead FILE: the HTTPS mode (own, sslip, off) already known
# before any question: from the settings file or the answers given ahead of
# time. Empty when the web address question decides it.
_install_mode_ahead() {
  local file=$1 url mode
  url=$(env_get "$file" FRONTEND_URL)
  if [[ -n $url ]]; then
    mode=$(env_get "$file" FREEFRAME_HTTPS)
    if [[ -z $mode ]]; then
      if [[ $url == https://* ]]; then mode=own; else mode=off; fi
    fi
    printf '%s' "$mode"
    return 0
  fi
  case ${FF_HTTPS:-auto} in
    own | sslip | off) printf '%s' "$FF_HTTPS" ;;
    *)
      if [[ -z ${FF_DOMAIN:-} ]]; then return 0; fi
      if _ff_is_ipv4 "$(_ff_clean_host "$FF_DOMAIN")"; then printf off; else printf own; fi
      ;;
  esac
}

# _install_address_menu_wanted FILE: 0 when the web address menu is shown.
_install_address_menu_wanted() {
  [[ -z $(env_get "$1" FRONTEND_URL) && -z ${FF_DOMAIN:-} && ${FF_HTTPS:-auto} == auto ]] && _ff_interactive
}

# _install_count_steps FILE: FF_QTOTAL, the number of steps this run asks.
_install_count_steps() {
  local file=$1 n=0 mode
  FF_QNUM=0
  FF_QTOTAL=0
  _ff_interactive || return 0
  mode=$(_install_mode_ahead "$file")
  if _install_address_menu_wanted "$file"; then
    n=$((n + 1))
  elif [[ -z $(env_get "$file" FRONTEND_URL) && $mode == own && -z ${FF_DOMAIN:-} ]]; then
    n=$((n + 1))
  elif [[ ($mode == own || $mode == sslip) && -z $(env_get "$file" ACME_EMAIL) && -z ${FF_ACME_EMAIL:-} ]]; then
    n=$((n + 1))
  fi
  if [[ -z $(env_get "$file" FREEFRAME_STORAGE) ]]; then
    if [[ -z ${FF_STORAGE:-} ]]; then
      n=$((n + 1))
    elif [[ $FF_STORAGE == s3 && (-z ${FF_S3_ENDPOINT:-} || -z ${FF_S3_BUCKET:-} || -z ${FF_S3_ACCESS_KEY:-} ||
      -z ${FF_S3_SECRET_KEY:-} || -z ${FF_S3_REGION:-}) ]]; then
      n=$((n + 1))
    fi
  fi
  if [[ -z $(env_get "$file" MAIL_PROVIDER) && -z ${FF_SMTP_HOST:-} ]]; then n=$((n + 1)); fi
  if [[ -z ${FF_ADMIN_NAME:-} || -z ${FF_ADMIN_EMAIL:-} || -z ${FF_ADMIN_PASSWORD:-} ]]; then n=$((n + 1)); fi
  if [[ -n ${FF_GPU_ASK:-} ]]; then n=$((n + 1)); fi
  FF_QTOTAL=$n
}

# _ff_typed_name NAME: 0 when NAME, typed at a menu or at "Domain:" or
# "Mail server:", is an address: a name with a dot and a letter in it
# (review.yourstudio.com), or an IPv4 address. A number such as 12, or 1.5,
# is a mistyped choice, not a name.
_ff_typed_name() {
  _ff_is_ipv4 "$1" && return 0
  [[ $1 == *.* && $1 == *[a-z]* ]] && valid_hostname "$1"
}

# _install_banner: the FreeFrame name in large letters, and what it is.
_install_banner() {
  local line
  local -a art=()
  mapfile -t art <<'ART'
  ___            ___
 | __| _ ___ ___| __| _ __ _ _ __  ___
 | _| '_/ -_) -_) _| '_/ _` | '  \/ -_)
 |_||_| \___\___|_||_| \__,_|_|_|_\___|
ART
  say ""
  for line in "${art[@]}"; do say "$(_ff_style 1 "$line")"; done
  _ff_lines " " " " 2 "Self-hosted review for your team's video, images and audio"
}

# _install_welcome: what is about to happen, after the banner. Interactive
# installs only, before the server check.
_install_welcome() {
  local n=${FF_QTOTAL:-0} count
  case $n in
    1) count="One short question" ;;
    2) count="Two short questions" ;;
    3) count="Three short questions" ;;
    4) count="Four short questions" ;;
    5) count="Five short questions" ;;
    *) count="$n short questions" ;;
  esac
  say ""
  _ff_p "Welcome! This sets up FreeFrame on this server."
  say ""
  _ff_p "$(_ff_style 1 "What happens:")"
  _ff_lines "   1. " "      " "" "A quick check of this server (nothing changes yet)"
  if ((n > 0)); then
    _ff_lines "   2. " "      " "" "$count. Press Enter to take the suggestion in [brackets]"
    _ff_lines "   3. " "      " "" "A summary to confirm, then about 5 minutes of installing"
  else
    _ff_lines "   2. " "      " "" "A summary of the answers you gave, to confirm, then about 5 minutes of installing"
  fi
  _ff_p "Nothing is installed until you confirm. Press Ctrl+C any time to stop."
  say ""
}

# _install_menu_network N IP: the plain HTTP choice, named for where it is
# reached from: this network only when the address is private.
_install_menu_network() {
  local n=$1 ip=$2
  if [[ -n ${FF_NAT:-} ]]; then
    _ff_menu_item "$n" "This network only, plain HTTP" "http://$ip" \
      "Behind a router, so only people on this network can reach it."
  elif ! is_public_ipv4 "$ip"; then
    _ff_menu_item "$n" "This network only, plain HTTP" "http://$ip" "Only people on this network can reach it."
  else
    _ff_menu_item "$n" "Plain HTTP on this server's address" "http://$ip" \
      "No certificate, so browsers mark it \"Not secure\"."
  fi
}

# _install_prompt_address: the web address menu. With a public IP: the free
# temporary address (the default), your own domain, plain HTTP. Without
# one: this network only (the default), your own domain. A domain typed at
# the menu is taken as your own domain; local or "this network only" as
# plain HTTP.
_install_prompt_address() {
  local answer="" sslip_n="" net_n count def=1 http_ip
  http_ip=$(_install_http_ip)
  _install_step "Web address"
  FF_ADDR_STEP=1
  _ff_p "How will your team open FreeFrame in the browser?"
  say ""
  if is_public_ipv4 "$FF_IP"; then
    sslip_n=1 net_n=3 count=3
    _ff_menu_item 1 "Free temporary address, with HTTPS" "$(sslip_host "$FF_IP")" \
      "Good for trying FreeFrame. Use your own domain for production."
    _ff_menu_item 2 "Your own domain" "for example review.yourstudio.com"
    _install_menu_network 3 "$http_ip"
  else
    net_n=1 count=2
    _install_menu_network 1 "$http_ip"
    _ff_menu_item 2 "Your own domain" "for example review.yourstudio.com" \
      "Its HTTPS certificate needs the server to be reachable from the internet."
  fi
  say ""
  while :; do
    ask answer " Choose $(_ff_choices "$count")" "$def" || _ff_input_ended
    answer=$(_ff_clean_host "$answer")
    case $answer in
      "$sslip_n")
        FF_HTTPS=sslip
        return 0
        ;;
      "$net_n" | local | "this network only")
        FF_HTTPS=off
        return 0
        ;;
      2)
        while :; do
          ask answer " Domain" "" || _ff_input_ended
          answer=$(_ff_clean_host "$answer")
          [[ -n $answer ]] || break
          if _ff_typed_name "$answer"; then
            FF_DOMAIN=$answer
            return 0
          fi
          _ff_hint 3 "'$answer' is not a domain name like review.yourstudio.com. Type only the name, without a port, a path or spaces, or press Enter to go back."
        done
        continue
        ;;
    esac
    if _ff_typed_name "$answer"; then
      FF_DOMAIN=$answer
      return 0
    fi
    _ff_hint 3 "Type $(_ff_choices "$count"), or a domain such as review.yourstudio.com."
  done
}

_install_ask_address() {
  local file=$1 url mode
  url=$(env_get "$file" FRONTEND_URL)
  if [[ -n $url ]]; then
    FF_ADDR_FROM_FILE=1
    mode=$(env_get "$file" FREEFRAME_HTTPS)
    if [[ -z $mode ]]; then
      if [[ $url == https://* ]]; then mode=own; else mode=off; fi
    fi
    FF_MODE=$mode
    FF_HTTPS=$mode
    FF_HOST=${url#*://}
    FF_HOST=${FF_HOST%%/*}
    FF_HOST=${FF_HOST%%:*}
    _ff_p "Web address: $url (from the existing settings in $file)"
    return 0
  fi
  case ${FF_HTTPS:-auto} in
    auto | own | sslip | off) ;;
    *) _ff_answer_error "FREEFRAME_HTTPS (--https) must be auto, own, sslip or off; it is '$FF_HTTPS'." "use one of those four words." ;;
  esac
  if [[ -n ${FF_DOMAIN:-} ]]; then
    FF_DOMAIN=$(_ff_clean_host "$FF_DOMAIN")
    if ! valid_hostname "$FF_DOMAIN"; then
      _ff_answer_error "The web address '$FF_DOMAIN' is not a plain name like review.yourstudio.com." \
        "give only the name, without a port, a path or spaces."
    fi
  elif [[ ${FF_HTTPS:-auto} == auto ]] && _ff_interactive; then
    _install_prompt_address
  fi
  if [[ -n ${FF_DOMAIN:-} ]] && _ff_is_ipv4 "$FF_DOMAIN"; then
    case ${FF_HTTPS:-auto} in
      auto | off) FF_HTTPS=off ;;
      *) _ff_answer_error "A certificate needs a name, not an IP address ($FF_DOMAIN)." "use a domain name, or plain HTTP with --https off." ;;
    esac
  fi
  if [[ ${FF_HTTPS:-auto} == sslip && -n ${FF_DOMAIN:-} ]]; then
    _ff_answer_error "Both a domain ($FF_DOMAIN) and the automatic sslip.io address were asked for." \
      "choose one: --domain for your own address, or --https sslip for the automatic one."
  fi
  if [[ ${FF_HTTPS:-auto} == own && -z ${FF_DOMAIN:-} ]]; then
    if _ff_interactive; then
      _install_step "Web address"
      FF_ADDR_STEP=1
      _ff_p "Your own domain, for example review.yourstudio.com."
      require_answer FF_DOMAIN FREEFRAME_DOMAIN " Domain" || _ff_answer_missing
    else
      require_answer FF_DOMAIN FREEFRAME_DOMAIN "the web address, for example review.yourstudio.com" || _ff_answer_missing
    fi
    FF_DOMAIN=$(_ff_clean_host "$FF_DOMAIN")
    valid_hostname "$FF_DOMAIN" || _ff_answer_error "The web address '$FF_DOMAIN' is not a plain name like review.yourstudio.com." \
      "give only the name, without a port, a path or spaces."
  fi
  FF_MODE=$(https_mode) || _ff_answer_missing
  case $FF_MODE in
    own) FF_HOST=$FF_DOMAIN ;;
    sslip)
      if ! is_public_ipv4 "$FF_IP"; then
        _ff_answer_error "The automatic sslip.io address needs a public IPv4 address, and this server's is '$FF_IP'." \
          "use your own domain (--domain), or plain HTTP (--https off) on an office network."
      fi
      FF_HOST=$(sslip_host "$FF_IP")
      ;;
    *)
      # derive_env uses FF_DOMAIN (or FF_IP) as the plain HTTP address.
      if [[ -z ${FF_DOMAIN:-} ]]; then FF_DOMAIN=$(_install_http_ip); fi
      FF_HOST=$FF_DOMAIN
      ;;
  esac
  FF_HTTPS=$FF_MODE
}

# _ff_ask_email VAR QUESTION DEFAULT: ask until an email address is typed.
_ff_ask_email() {
  local var=$1 question=$2 default=$3 answer=""
  while :; do
    ask answer "$question" "$default" || _ff_input_ended
    if valid_email "$answer"; then
      printf -v "$var" '%s' "$answer"
      return 0
    fi
    _ff_hint 3 "That does not look like an email address."
  done
}

_install_ask_acme_email() {
  local file=$1
  [[ $FF_MODE == own || $FF_MODE == sslip ]] || return 0
  [[ -z $(env_get "$file" ACME_EMAIL) ]] || return 0
  if [[ -z ${FF_ACME_EMAIL:-} ]]; then
    if _ff_interactive; then
      if [[ -z ${FF_ADDR_STEP:-} ]]; then _install_step "Certificate email"; fi
      say ""
      _ff_p "The HTTPS certificate is free, from Let's Encrypt. They write to this address if it needs attention."
      _ff_ask_email FF_ACME_EMAIL " Email for certificate notices" "${FF_ADMIN_EMAIL:-}"
    else
      FF_ACME_EMAIL=${FF_ADMIN_EMAIL:-}
      require_answer FF_ACME_EMAIL FREEFRAME_ACME_EMAIL "the email for certificate notices" || _ff_answer_missing
    fi
  fi
  if ! valid_email "$FF_ACME_EMAIL"; then
    _ff_answer_error "'$FF_ACME_EMAIL' does not look like an email address (the email for certificate notices)." "give an address such as you@yourstudio.com."
  fi
}

_install_ask_s3() {
  local interactive=0 re_bucket='^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$'
  _ff_interactive && interactive=1
  if ((interactive)); then
    say ""
    _ff_p "Your bucket's details come from your storage provider."
    if [[ -z ${FF_S3_ENDPOINT:-} ]]; then
      _ff_hint 1 "The endpoint is the bucket's S3 address, for example https://<account>.r2.cloudflarestorage.com."
      ask FF_S3_ENDPOINT " Endpoint (press Enter for AWS S3)" "" || _ff_input_ended
    fi
  fi
  require_answer FF_S3_BUCKET FREEFRAME_S3_BUCKET " Bucket name" || _ff_answer_missing
  require_answer FF_S3_ACCESS_KEY FREEFRAME_S3_ACCESS_KEY " Access key" || _ff_answer_missing
  if [[ -z ${FF_S3_SECRET_KEY:-} ]]; then
    if ((interactive)); then
      while [[ -z ${FF_S3_SECRET_KEY:-} ]]; do
        ask_secret FF_S3_SECRET_KEY " Secret key" || _ff_input_ended
      done
    else
      require_answer FF_S3_SECRET_KEY FREEFRAME_S3_SECRET_KEY "the bucket's secret key" || _ff_answer_missing
    fi
  fi
  if ((interactive)) && [[ -z ${FF_S3_REGION:-} ]]; then
    ask FF_S3_REGION " Region (for Cloudflare R2 type auto)" us-east-1 || _ff_input_ended
  fi
  if [[ -n ${FF_S3_ENDPOINT:-} && ! $FF_S3_ENDPOINT =~ ^https?://[^[:space:]]+$ ]]; then
    _ff_answer_error "The storage endpoint '$FF_S3_ENDPOINT' must be a web address starting with https:// (or http:// for storage on your own network)." "copy the endpoint address exactly as your storage provider shows it."
  fi
  if [[ ! $FF_S3_BUCKET =~ $re_bucket ]]; then
    _ff_answer_error "The bucket name '$FF_S3_BUCKET' can only hold lowercase letters, digits, dots and hyphens." "check the bucket name at your storage provider."
  fi
}

_install_ask_storage() {
  local file=$1 s answer="" hours room=""
  s=$(env_get "$file" FREEFRAME_STORAGE)
  if [[ -n $s ]]; then
    FF_STORAGE=$s
    return 0
  fi
  if [[ -z ${FF_STORAGE:-} ]] && _ff_interactive; then
    _install_step "Storage"
    _ff_p "Where should uploaded footage be kept?"
    say ""
    if hours=$(_install_footage_hours); then room="room for about $hours hours of 1080p"; fi
    _ff_menu_item 1 "On this server" "$room" "The simplest choice. It needs enough free disk space."
    _ff_menu_item 2 "In an S3 bucket you already have" "" \
      "AWS S3, Cloudflare R2, Backblaze B2 or DigitalOcean Spaces."
    say ""
    while :; do
      ask answer " Choose 1 or 2" 1 || _ff_input_ended
      case ${answer,,} in
        1 | bundled) FF_STORAGE=bundled && break ;;
        2 | s3) FF_STORAGE=s3 && break ;;
      esac
      _ff_hint 3 "Type 1 or 2."
    done
  elif [[ ${FF_STORAGE:-} == s3 ]] && _ff_interactive &&
    [[ -z ${FF_S3_ENDPOINT:-} || -z ${FF_S3_BUCKET:-} || -z ${FF_S3_ACCESS_KEY:-} || -z ${FF_S3_SECRET_KEY:-} || -z ${FF_S3_REGION:-} ]]; then
    _install_step "Storage"
  fi
  FF_STORAGE=${FF_STORAGE:-bundled}
  case $FF_STORAGE in
    bundled) ;;
    s3) _install_ask_s3 ;;
    *) _ff_answer_error "FREEFRAME_STORAGE (--storage) must be bundled or s3; it is '$FF_STORAGE'." "use bundled (on this server) or s3 (your own bucket)." ;;
  esac
}

_install_no_email_note() {
  _ff_lines " " " " "" "Without email, sign-in codes and invitation emails are not sent, and there is no other way to recover a forgotten password. Invitation links can still be copied from the admin page." >&2
  warn " To add email later, run: sudo freeframe configure"
}

_install_ask_smtp() {
  local file=$1 def="" answer=""
  if [[ -n $(env_get "$file" MAIL_PROVIDER) ]]; then
    FF_SMTP_FROM_FILE=1
    return 0
  fi
  if [[ -z ${FF_SMTP_HOST:-} ]] && _ff_interactive; then
    _install_step "Email"
    _ff_p "FreeFrame emails sign-in codes and invitations through a mail server (SMTP) you already use, such as Postmark, Mailgun or your company's own."
    say ""
    _ff_menu_item 1 "Skip for now, and add it later" "" "Until then, sign-in codes and invitations are not sent."
    _ff_menu_item 2 "Set up a mail server now" "for example smtp.postmarkapp.com"
    say ""
    while :; do
      ask answer " Choose 1 or 2" 1 || _ff_input_ended
      answer=$(_ff_clean_host "$answer")
      case $answer in
        1 | skip)
          say ""
          _install_no_email_note
          return 0
          ;;
        2)
          # Enter goes back to the choices, as at "Domain:".
          while :; do
            ask answer " Mail server" "" || _ff_input_ended
            answer=$(_ff_clean_host "$answer")
            [[ -n $answer ]] || break
            if _ff_typed_name "$answer"; then
              FF_SMTP_HOST=$answer
              break
            fi
            _ff_hint 3 "'$answer' is not a mail server name like smtp.postmarkapp.com. Type only the server's name, or press Enter to go back."
          done
          if [[ -n ${FF_SMTP_HOST:-} ]]; then break; fi
          continue
          ;;
      esac
      # A mail server typed at the menu: the same as 2, then that name.
      if _ff_typed_name "$answer"; then
        FF_SMTP_HOST=$answer
        break
      fi
      _ff_hint 3 "Type 1 or 2, or the mail server's name."
    done
    ask FF_SMTP_PORT " Port" "${FF_SMTP_PORT:-587}" || _ff_input_ended
    ask FF_SMTP_USER " User name" "${FF_SMTP_USER:-}" || _ff_input_ended
    if [[ -z ${FF_SMTP_PASSWORD:-} ]]; then
      ask_secret FF_SMTP_PASSWORD " Password" || _ff_input_ended
    fi
    def=${FF_SMTP_FROM:-}
    if [[ -z $def ]] && valid_email "${FF_SMTP_USER:-}"; then def=$FF_SMTP_USER; fi
    _ff_ask_email FF_SMTP_FROM " Send emails from (address)" "$def"
  fi
  [[ -n ${FF_SMTP_HOST:-} ]] || return 0
  FF_SMTP_HOST=$(_ff_clean_host "$FF_SMTP_HOST")
  if ! valid_hostname "$FF_SMTP_HOST"; then
    _ff_answer_error "The mail server '$FF_SMTP_HOST' is not a plain name like smtp.postmarkapp.com." "give only the server's name."
  fi
  FF_SMTP_PORT=${FF_SMTP_PORT:-587}
  if [[ ! $FF_SMTP_PORT =~ ^[0-9]{1,5}$ ]] || ((10#$FF_SMTP_PORT < 1 || 10#$FF_SMTP_PORT > 65535)); then
    _ff_answer_error "The mail server port '$FF_SMTP_PORT' is not a port number." "use the port your email provider gives, usually 587 or 465."
  fi
  if [[ -z ${FF_SMTP_FROM:-} ]] && valid_email "${FF_SMTP_USER:-}"; then FF_SMTP_FROM=$FF_SMTP_USER; fi
  require_answer FF_SMTP_FROM FREEFRAME_SMTP_FROM "the address emails are sent from" || _ff_answer_missing
  if ! valid_email "$FF_SMTP_FROM"; then
    _ff_answer_error "'$FF_SMTP_FROM' does not look like an email address (the address emails are sent from)." "give an address such as noreply@yourstudio.com."
  fi
}

_install_ask_admin() {
  local again=""
  FF_PW_GENERATED=""
  if _ff_interactive && [[ -z ${FF_ADMIN_NAME:-} || -z ${FF_ADMIN_EMAIL:-} || -z ${FF_ADMIN_PASSWORD:-} ]]; then
    _install_step "Admin account"
    _ff_p "You sign in with this account, and invite your team from it."
    if [[ -f $(ff_root)/.env.prod ]] && _ff_pgdata_kept; then
      _ff_p "This server keeps FreeFrame's database from before. If it already has an admin account, these answers are not used: sign in with that account."
    fi
    say ""
  fi
  if [[ -z ${FF_ADMIN_NAME:-} ]]; then
    if _ff_interactive; then
      require_answer FF_ADMIN_NAME FREEFRAME_ADMIN_NAME " Your name" || _ff_answer_missing
    else
      FF_ADMIN_NAME=Admin
    fi
  fi
  # Putting FreeFrame back unattended (the settings and the database's
  # volume kept, by an uninstall or a move): the database most likely has
  # its admin already, so no email is needed up front. Once FreeFrame runs,
  # _install_admin_later asks the database, and asks for the email only
  # when there is no admin.
  if [[ -z ${FF_ADMIN_EMAIL:-} && -n ${FF_YES:-} && -z ${FF_ADMIN_ASK_NOW:-} && -f $(ff_root)/.env.prod ]] && _ff_pgdata_kept; then
    FF_ADMIN_LATER=1
    if [[ -n ${FF_ADMIN_PASSWORD:-} ]] && ! _ff_password_ok "$FF_ADMIN_PASSWORD"; then
      _ff_answer_error "The admin password must be 8 to 72 characters long." "choose another FREEFRAME_ADMIN_PASSWORD, or leave it out to have one made for you."
    fi
    return 0
  fi
  if [[ -z ${FF_ADMIN_EMAIL:-} ]]; then
    if _ff_interactive; then
      _ff_ask_email FF_ADMIN_EMAIL " Your email" ""
    else
      require_answer FF_ADMIN_EMAIL FREEFRAME_ADMIN_EMAIL "the admin account's email" || _ff_answer_missing
    fi
  fi
  if ! valid_email "$FF_ADMIN_EMAIL"; then
    _ff_answer_error "'$FF_ADMIN_EMAIL' does not look like an email address (the admin account's email)." "give an address such as you@yourstudio.com."
  fi
  if [[ -n ${FF_ADMIN_PASSWORD:-} ]]; then
    if ! _ff_password_ok "$FF_ADMIN_PASSWORD"; then
      _ff_answer_error "The admin password must be 8 to 72 characters long." "choose another FREEFRAME_ADMIN_PASSWORD, or leave it out to have one made for you."
    fi
    return 0
  fi
  if _ff_interactive; then
    _ff_hint 1 "Choose a password of 8 characters or more, or press Enter to have one made for you."
    while :; do
      ask_secret FF_ADMIN_PASSWORD " Password" || _ff_input_ended
      [[ -n $FF_ADMIN_PASSWORD ]] || break
      if ! _ff_password_ok "$FF_ADMIN_PASSWORD"; then
        _ff_hint 3 "The password must be 8 to 72 characters long."
        continue
      fi
      ask_secret again " Type it again" || _ff_input_ended
      [[ $again != "$FF_ADMIN_PASSWORD" ]] || return 0
      _ff_hint 3 "The two passwords did not match. Please type them again."
    done
  fi
  FF_ADMIN_PASSWORD=$(gen_secret 12) || FF_ADMIN_PASSWORD=""
  if [[ ! $FF_ADMIN_PASSWORD =~ ^[0-9a-f]{24}$ ]]; then
    install_fail "Could not make up a password for the admin account." "check that openssl works (openssl rand -hex 12), or give one with FREEFRAME_ADMIN_PASSWORD."
  fi
  FF_PW_GENERATED=1
}

# _install_gpu_check FILE: detect the GPU and decide (_gpu_decide), before
# the welcome, so the Video processing question is counted. Changes nothing.
_install_gpu_check() {
  detect_gpu
  _gpu_decide "$1"
  FF_GPU_OTHERS=0
  if [[ -n ${FF_GPU_ASK:-}${FF_GPU_SETUP:-} ]]; then FF_GPU_OTHERS=$(_gpu_other_containers); fi
}

# _install_gpu_log: what the GPU check found and decided, into install.log
# only (the check runs before the log starts). It holds no secret.
_install_gpu_log() {
  local line="GPU check: state ${FF_GPU_STATE:-none}" what
  if _gpu_usable; then line+=" ($FF_GPU_NAME, driver $FF_GPU_DRIVER)"; fi
  line+=", nvidia-smi: ${FF_GPU_SMI_LINE:-no answer}"
  if [[ -n ${FF_GPU_ASK:-} ]]; then
    what="asked at the Video processing step"
  elif [[ ${FF_GPU:-off} == nvidia && -n ${FF_GPU_SETUP:-} ]]; then
    what="video on the GPU, once the NVIDIA container toolkit is set up"
  elif [[ ${FF_GPU:-off} == nvidia ]]; then
    what="video on the GPU"
  else
    what="video on the CPU"
  fi
  [[ -n ${FF_LOG:-} ]] && printf '%s; %s\n' "$line" "$what" >>"$FF_LOG"
  return 0
}

# _install_ask_gpu: the Video processing step, asked only for an NVIDIA GPU
# whose driver works when Docker cannot use it yet (FF_GPU_ASK).
_install_ask_gpu() {
  local answer=""
  [[ -n ${FF_GPU_ASK:-} ]] || return 0
  _install_step "Video processing"
  _ff_p "This server has an NVIDIA GPU: $FF_GPU_NAME (driver $FF_GPU_DRIVER). FreeFrame can use it to prepare uploaded videos for review, much faster than the processor (CPU) can."
  say ""
  _ff_p "Docker needs the NVIDIA container toolkit for that. The installer sets it up from NVIDIA's own repository and restarts Docker once; the driver is left as it is. Without it, video is processed on the CPU."
  if ((${FF_GPU_OTHERS:-0} > 0)); then
    say ""
    if ((FF_GPU_OTHERS == 1)); then
      _ff_p "1 other container is running on this server. Restarting Docker means every container on this server stops for a moment; any without a restart policy stays stopped until you start it again."
    else
      _ff_p "$FF_GPU_OTHERS other containers are running on this server. Restarting Docker means every container on this server stops for a moment; any without a restart policy stays stopped until you start it again."
    fi
  fi
  say ""
  while :; do
    ask answer " Use the NVIDIA GPU for video processing? [Y/n]" "" || _ff_input_ended
    case ${answer,,} in
      "" | y | yes)
        FF_GPU=nvidia FF_GPU_SETUP=1
        return 0
        ;;
      n | no)
        FF_GPU=off FF_GPU_WHY="you chose the CPU"
        return 0
        ;;
    esac
    _ff_hint 3 "Type y or n, or press Enter for yes."
  done
}

# _install_gpu_step: set up the NVIDIA container toolkit when the GPU was
# chosen and Docker cannot use it yet. Never fails the install: when it
# does not work, video is processed on the CPU (FREEFRAME_GPU=off).
_install_gpu_step() {
  [[ ${FF_GPU:-off} == nvidia && -n ${FF_GPU_SETUP:-} ]] || return 0
  FF_STEP="setting up the NVIDIA container toolkit"
  _ff_p "Setting up the NVIDIA container toolkit, so Docker can use the GPU, and restarting Docker (a minute or two)..."
  if _gpu_setup; then
    FF_GPU_SETUP=""
    _install_done "installed the NVIDIA container toolkit and set Docker up for the GPU"
    return 0
  fi
  _gpu_docker_back "sudo freeframe install"
  FF_GPU=off FF_GPU_FAILED=1 FF_GPU_FORCE_OFF=1 FF_GPU_WHY="the NVIDIA container toolkit could not be set up"
  _ff_pw "The NVIDIA container toolkit could not be set up, so FreeFrame processes video on the CPU. The reason is at the end of the log; the install goes on."
}

# _install_footage_hours: roughly how many hours of 1080p footage fit in the
# free space Docker's volumes will use (about 20 GB an hour, counting the
# original and the review copies FreeFrame makes).
_install_footage_hours() {
  local free
  free=$(_ff_free_mb /var/lib/docker) || free=""
  [[ $free =~ ^[0-9]+$ ]] || return 1
  printf '%s' $((free / 20480))
}

# _install_row KEY VALUE: one row of a summary: the key in a column, the
# value wrapped beside it.
_install_row() {
  local pre
  printf -v pre '   %-14s' "$1"
  _ff_lines "$pre" "                 " "" "$2"
}

_install_show_summary() {
  local file=$1 scheme hours acme
  scheme=$(_ff_scheme "$FF_MODE")
  _ff_heading "Ready to install"
  case $FF_MODE in
    sslip) _install_row "Web address" "$scheme://$FF_HOST (a free temporary address)" ;;
    off) _install_row "Web address" "$scheme://$FF_HOST (plain HTTP)" ;;
    *) _install_row "Web address" "$scheme://$FF_HOST" ;;
  esac
  if [[ $FF_MODE != off ]]; then
    acme=$(env_get "$file" ACME_EMAIL)
    _install_row "Certificates" "notices go to ${acme:-${FF_ACME_EMAIL:-}}"
  fi
  if [[ $FF_STORAGE == bundled ]]; then
    if hours=$(_install_footage_hours); then
      _install_row "Footage" "kept on this server; about $hours hours of 1080p footage fit in the free space (less for 4K or ProRes)"
    else
      _install_row "Footage" "kept on this server"
    fi
  else
    _install_row "Footage" "in your S3 bucket ${FF_S3_BUCKET:-$(env_get "$file" S3_BUCKET)}"
  fi
  if [[ -n ${FF_SMTP_FROM_FILE:-} ]]; then
    _install_row "Email" "as in the existing settings"
  elif [[ -n ${FF_SMTP_HOST:-} ]]; then
    _install_row "Email" "sent through $FF_SMTP_HOST, port $FF_SMTP_PORT, from $FF_SMTP_FROM"
  else
    _install_row "Email" "not set up"
  fi
  if [[ -n ${FF_ADMIN_LATER:-} ]]; then
    _install_row "Admin" "the one already in the database kept on this server; if it has none, the install stops before opening FreeFrame and asks for FREEFRAME_ADMIN_EMAIL"
  elif [[ -n $FF_PW_GENERATED ]]; then
    _install_row "Admin" "$FF_ADMIN_NAME <$FF_ADMIN_EMAIL>, with a password made for you (shown at the end)"
  else
    _install_row "Admin" "$FF_ADMIN_NAME <$FF_ADMIN_EMAIL>"
  fi
  _install_row "Video" "$(_gpu_summary)"
  # Interactive runs showed the note when email was skipped.
  if [[ -z ${FF_SMTP_FROM_FILE:-} && -z ${FF_SMTP_HOST:-} ]] && ! _ff_interactive; then
    say ""
    _install_no_email_note
  fi
  say ""
}

_install_questions() {
  local file=$1
  FF_STEP="asking the questions"
  FF_ADDR_STEP=""
  _install_ask_channel "$file"
  _install_ask_address "$file"
  _install_ask_acme_email "$file"
  _install_ask_storage "$file"
  if [[ $FF_STORAGE == bundled ]]; then
    _install_check_port 9000 minio "FreeFrame needs port 9000 to keep footage on this server."
  fi
  _install_ask_smtp "$file"
  _install_ask_admin
  _install_ask_gpu
  _install_show_summary "$file"
  if _ff_interactive && ! confirm " Install now?" Y; then
    _ff_stop 1 "Install cancelled. Nothing was installed." "run the install command again when you are ready."
  fi
  _ff_heading "Installing (about 5 minutes)"
}

_install_docker_step() {
  FF_STEP="installing Docker"
  if [[ $FF_DOCKER == ok ]]; then
    _ff_p "Docker is already installed; using it."
    return 0
  fi
  _ff_p "Installing Docker from Docker's own repository (a few minutes)..."
  if ! _ff_logged install_docker; then
    install_fail "Docker could not be installed." "check the server's internet connection, then run sudo freeframe install again. The reason is at the end of the log."
  fi
  if [[ $(docker_status) != ok ]]; then
    install_fail "Docker was installed but does not answer." "run: sudo systemctl start docker, then sudo freeframe install again."
  fi
  _install_done "installed Docker"
}

_install_swap_step() {
  local ram free
  ram=${FF_RAM_MB:-$(_ff_ram_mb)}
  ((ram < 4096)) || return 0
  ! swap_present || return 0
  FF_STEP="adding a swap file"
  free=$(_ff_free_mb /) || free=""
  if [[ $free =~ ^[0-9]+$ ]] && ((free < 4096)); then
    _ff_pw "This server has less than 4 GB of memory and no swap, and too little free disk space to add a swap file."
    return 0
  fi
  _ff_p "Adding a 2 GB swap file, because this server has less than 4 GB of memory..."
  if _ff_logged add_swap; then
    _install_done "added a 2 GB swap file (/swapfile)"
  else
    _ff_pw "Could not add a swap file; continuing without one (the reason is in the log)."
  fi
}

_install_ufw_step() {
  ufw_active || return 0
  FF_STEP="opening the firewall"
  _ff_p "The ufw firewall is on: allowing web traffic (ports 80 and 443) and SSH."
  local added=0
  if _ff_logged ufw app info OpenSSH; then
    if _ff_logged ufw allow OpenSSH; then added=1; else warn "Could not add the ufw rule for SSH."; fi
  fi
  if _ff_logged ufw allow 80/tcp; then added=1; else warn "Could not add the ufw rule for port 80."; fi
  if _ff_logged ufw allow 443/tcp; then added=1; else warn "Could not add the ufw rule for port 443."; fi
  if ((added)); then _install_done "allowed SSH and web traffic (ports 80 and 443) in the ufw firewall"; fi
  if [[ $FF_MODE == off && $FF_STORAGE == bundled ]]; then
    _ff_p "Note: ports that Docker opens skip ufw's rules. FreeFrame opens only 80 and 443, and 9000 for uploads in plain HTTP mode."
  else
    _ff_p "Note: ports that Docker opens skip ufw's rules. FreeFrame opens only 80 and 443."
  fi
}

_install_dns_ok() {
  local n
  for n in "$@"; do
    dns_points_here "$n" "$FF_IP" || return 1
  done
}

# For an own domain: show the DNS records, then wait until they point here,
# so a typo never burns Let's Encrypt attempts. With a terminal the person
# can switch to the automatic address or continue anyway.
_install_dns_step() {
  local -a names=()
  local n waited=0 max=${FF_DNS_WAIT:-1800} answer rc interactive=0 can_switch=0
  [[ $FF_MODE == own ]] || return 0
  FF_STEP="checking the DNS records"
  names=("$FF_HOST")
  if [[ $FF_STORAGE == bundled ]]; then names+=("storage.$FF_HOST"); fi
  if _install_dns_ok "${names[@]}"; then
    _ff_p "The DNS records for $FF_HOST point at this server."
    return 0
  fi
  _ff_heading "DNS records"
  _ff_p "Your web address must point at this server before HTTPS can be set up. Add these DNS records where you manage your domain (at the company you bought it from, look for \"DNS\" or \"DNS records\"):"
  say ""
  for n in "${names[@]}"; do
    _ff_lines "   " "     " "" "Add an A record with the name $(_ff_dns_label "$n") and the value $FF_IP (for $n)"
  done
  say ""
  _ff_p "If there is an AAAA record for these names, remove it unless it points at this server. New records usually work within a few minutes, sometimes up to an hour."
  if [[ -z ${FF_ADDR_FROM_FILE:-} ]] && is_public_ipv4 "$FF_IP"; then can_switch=1; fi
  if _ff_interactive && _ff_tty_open; then
    interactive=1
    say ""
    _ff_p "Checking every 15 seconds. Press Enter to check now, or type c and Enter to continue anyway."
    if ((can_switch)); then
      _ff_p "Or type s and Enter to use the free temporary address $(sslip_host "$FF_IP") instead."
    fi
  fi
  while ! _install_dns_ok "${names[@]}"; do
    if ((interactive)); then
      answer=""
      rc=0
      IFS= read -r -t 15 -u "$_FF_TTY_FD" answer || rc=$?
      ((rc <= 128)) || continue
      if ((rc != 0)) && [[ -z $answer ]]; then
        interactive=0
        continue
      fi
      case ${answer,,} in
        s)
          if ((can_switch)); then
            FF_HTTPS=sslip FF_MODE=sslip FF_DOMAIN="" FF_HOST=$(sslip_host "$FF_IP")
            if [[ ${FF_CMD:-install} == configure ]]; then
              _ff_p "Using the temporary address $FF_HOST instead."
            else
              _ff_p "Using the temporary address $FF_HOST instead. Change it later with:"
              say "   sudo freeframe configure"
            fi
            return 0
          fi
          ;;
        c)
          _ff_pw "Continuing before the records point here. The HTTPS certificate cannot be issued until they do."
          return 0
          ;;
      esac
    else
      if ((waited >= max)); then
        if [[ ${FF_CMD:-install} == configure ]]; then
          install_fail "The DNS records for $FF_HOST do not point at this server ($FF_IP) yet, so the web address was not changed." \
            "add the records shown above, then run sudo freeframe configure again once they work."
        fi
        install_fail "The DNS records for $FF_HOST do not point at this server ($FF_IP) yet." \
          "add the records shown above and run sudo freeframe install again once they work, or install now with the temporary address instead: leave out the domain and set FREEFRAME_HTTPS=sslip."
      fi
      ff_sleep 15
      waited=$((waited + 15))
    fi
  done
  _ff_p "The DNS records point at this server."
}

FF_SETUP_FILES=(docker-compose.prod.yml docker-compose.images.yml docker-compose.https.yml docker-compose.storage.yml
  docker-compose.gpu.yml deploy/systemd/freeframe-backup.service deploy/systemd/freeframe-backup.timer)

# _ff_setup_optional PATH: 0 for a setup file a release may lack (it came
# later): a ref that does not have it (fetch returns 4) leaves it out of the
# set instead of failing. Only the GPU compose file is.
_ff_setup_optional() { [[ $1 == docker-compose.gpu.yml ]]; }

# _ff_setup_dest PATH: where the setup file PATH (as in the repository) lives
# on this server: the compose files in $FF_ROOT, the units in $FF_ROOT/systemd.
_ff_setup_dest() {
  local root
  root=$(ff_root)
  if [[ $1 == deploy/systemd/* ]]; then printf '%s/systemd/%s' "$root" "${1##*/}"; else printf '%s/%s' "$root" "$1"; fi
}

# fetch_setup_files REF: download the compose files and the nightly backup
# units from REF into $FF_ROOT (the units into $FF_ROOT/systemd, where
# install_backup_timer takes them from). All or nothing: every file is
# downloaded first, and when moving one into place fails, those already
# moved are put back, so the old set stays whole. On failure it returns 1,
# FF_FETCH_FAILED names the file, FF_FETCH_STAGE is download or move, and
# FF_FETCH_MIXED=1 says the old set could not be put back completely.
fetch_setup_files() {
  local ref=$1 root stage f dest name i rc
  local -a moved=()
  local -A absent=()
  root=$(ff_root)
  FF_FETCH_FAILED="" FF_FETCH_STAGE=download FF_FETCH_MIXED=""
  mkdir -p "$root/systemd" || return 1
  stage=$(mktemp -d "$root/.download.XXXXXX") || return 1
  for f in "${FF_SETUP_FILES[@]}"; do
    rc=0
    _ff_logged fetch "$ref" "$f" "$stage/${f##*/}" || rc=$?
    if ((rc == 4)) && _ff_setup_optional "$f"; then
      absent[$f]=1
      continue
    fi
    if ((rc)); then
      FF_FETCH_FAILED=$f
      rm -rf "$stage"
      return 1
    fi
  done
  FF_FETCH_STAGE=move
  mkdir "$stage/old" || {
    rm -rf "$stage"
    return 1
  }
  # The replace takes a moment and must not be cut in half: a Ctrl-C, a
  # closed SSH session or a TERM is held until it is done, then delivered.
  _ff_hold_signals
  for f in "${FF_SETUP_FILES[@]}"; do
    dest=$(_ff_setup_dest "$f")
    name=${f##*/}
    # A file REF does not have is taken out of the set (and put back below,
    # like the others, when a later one fails).
    if [[ -n ${absent[$f]:-} ]]; then
      if [[ ! -e $dest ]]; then continue; fi
      if cp -p "$dest" "$stage/old/$name" && rm -f "$dest"; then
        moved+=("$f")
        continue
      fi
    elif { [[ ! -e $dest ]] || cp -p "$dest" "$stage/old/$name"; } && mv -f "$stage/$name" "$dest"; then
      moved+=("$f")
      continue
    fi
    FF_FETCH_FAILED=$f
    # Put back what was already replaced (a file that was not there before
    # is removed again).
    for ((i = ${#moved[@]} - 1; i >= 0; i--)); do
      dest=$(_ff_setup_dest "${moved[i]}")
      name=${moved[i]##*/}
      if [[ -e $stage/old/$name ]]; then
        mv -f "$stage/old/$name" "$dest" || FF_FETCH_MIXED=1
      else
        rm -f "$dest" || FF_FETCH_MIXED=1
      fi
    done
    rm -rf "$stage"
    _ff_release_signals
    return 1
  done
  rm -rf "$stage"
  _ff_release_signals
}

# _ff_hold_signals / _ff_release_signals: hold INT, TERM and HUP during a
# short step that must finish once begun; afterwards the traps that were
# set come back, and a signal that arrived meanwhile is delivered then.
_ff_hold_signals() {
  FF_HELD_TRAPS=$(trap -p INT TERM HUP)
  FF_SIG_PENDING=""
  trap 'FF_SIG_PENDING=INT' INT
  trap 'FF_SIG_PENDING=TERM' TERM
  trap 'FF_SIG_PENDING=HUP' HUP
}

_ff_release_signals() {
  local sig=${FF_SIG_PENDING:-}
  trap - INT TERM HUP
  eval "${FF_HELD_TRAPS:-}"
  FF_SIG_PENDING="" FF_HELD_TRAPS=""
  if [[ -n $sig ]]; then kill -s "$sig" "$$"; fi
  return 0
}

# _ff_fetch_failure CHANNEL_WORDS: the message for a failed fetch_setup_files.
_ff_fetch_failure() {
  if [[ $FF_FETCH_STAGE == download ]]; then
    printf 'Could not download %s for %s, so none of the setup files was replaced.' "${FF_FETCH_FAILED:-the setup files}" "$1"
  elif [[ -n $FF_FETCH_MIXED ]]; then
    printf 'The new %s could not be put in place, and some of the setup files from before could not be put back either.' "${FF_FETCH_FAILED:-setup files}"
  else
    printf 'The new %s could not be put in place, so none of the setup files was replaced.' "${FF_FETCH_FAILED:-setup files}"
  fi
}

_install_fetch_step() {
  local root
  root=$(ff_root)
  FF_STEP="downloading the setup files"
  _ff_p "Downloading the setup files for the $FF_CHANNEL channel..."
  if ! fetch_setup_files "$FF_CHANNEL"; then
    local try="check that this server can reach raw.githubusercontent.com, then run sudo freeframe install again."
    if [[ $FF_CHANNEL == latest ]]; then
      try+=" If it can, the latest release may not have this file yet (the installer needs a release after v1.21.0): wait for the next release."
    else
      try+=" If it can, the $FF_CHANNEL channel may not have this file yet (the installer needs a release after v1.21.0): try --channel latest."
    fi
    install_fail "$(_ff_fetch_failure "the $FF_CHANNEL channel")" "$try"
  fi
  _install_done "downloaded the setup files into $root"
}

# Fill the settings file. An existing file (copied from another server, or
# an earlier attempt) is only completed, never changed, and it is backed up
# first whenever something is added.
# fill_settings FILE [CHANNEL]: complete FILE with derive_env: only missing
# or empty keys are added and secrets are never replaced (spec goal 6). With
# CHANNEL, FREEFRAME_CHANNEL is set to it first (an explicit --channel). The
# work happens on a copy: when the copy differs, FILE is backed up
# (env_backup) and the copy moved over it; otherwise FILE stays byte for byte
# as it was. FILE always ends mode 600. 1 on failure (with a message).
fill_settings() {
  local file=$1 ch=${2:-} tmp
  if ! tmp=$(mktemp "$file.new.XXXXXX"); then
    warn "Cannot write next to $file."
    return 1
  fi
  if ! cp -p "$file" "$tmp"; then
    rm -f "$tmp"
    warn "Cannot copy $file."
    return 1
  fi
  if [[ -n $ch && $(env_get "$tmp" FREEFRAME_CHANNEL) != "$ch" ]] && ! env_set "$tmp" FREEFRAME_CHANNEL "$ch"; then
    rm -f "$tmp"
    return 1
  fi
  if ! derive_env "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if cmp -s "$file" "$tmp"; then
    rm -f "$tmp"
  elif ! env_backup "$file" >/dev/null; then
    rm -f "$tmp"
    warn "Could not back up $file."
    return 1
  elif ! mv -f "$tmp" "$file"; then
    rm -f "$tmp"
    return 1
  fi
  chmod 600 "$file"
}

_install_settings_step() {
  local file=$1
  FF_STEP="writing the settings"
  if [[ -f $file ]]; then
    if ! fill_settings "$file" "$FF_CHANNEL"; then
      install_fail "The settings could not be completed." "fix what the message above says, then run sudo freeframe install again."
    fi
  elif ! derive_env "$file"; then
    install_fail "The settings could not be written." "fix what the message above says, then run sudo freeframe install again."
  fi
  # Settings that ask for a GPU this server cannot use (or whose toolkit
  # could not be set up) would stop the worker from starting.
  if [[ -n ${FF_GPU_FORCE_OFF:-} && $(env_get "$file" FREEFRAME_GPU) != off ]]; then
    if ! { env_backup "$file" >/dev/null && env_set "$file" FREEFRAME_GPU off; }; then
      install_fail "FREEFRAME_GPU could not be set to off in $file." "check that the disk is not full, then run sudo freeframe install again."
    fi
  fi
  # Also when nothing had to be added: a file copied in with wider
  # permissions still holds the passwords.
  chmod 600 "$file" || install_fail "Cannot make $file private (chmod 600 failed)." "check the disk, then run sudo freeframe install again."
  FF_STATE="Your settings are saved in $file. Running sudo freeframe install again keeps them and continues from here."
}

_install_wait_api() {
  local max=${FF_API_WAIT:-600}
  FF_STEP="waiting for FreeFrame to start"
  _ff_p "Waiting for FreeFrame to finish starting (the first start prepares the database)..."
  if ! _ff_wait_for "$max" 5 _ff_logged dc exec -T api curl -fsS http://localhost:8000/health; then
    install_fail "FreeFrame did not finish starting within $(((max + 59) / 60)) minutes." \
      "see why with: sudo freeframe logs, then run sudo freeframe install again."
  fi
}

# _install_admin_later: putting FreeFrame back with --yes and no admin
# email (_install_ask_admin set FF_ADMIN_LATER). Asks the kept database
# whether it has an admin (GET /setup/status, inside the compose network,
# before Traefik opens anything). It has one: nothing is made, as when the
# setup endpoint answers 403. It has none (an empty database), or there is
# no clear answer: the admin answers are needed after all, so a missing
# email stops here, with FreeFrame still closed to the outside, and a
# re-run with FREEFRAME_ADMIN_EMAIL set continues.
_install_admin_later() {
  local out=""
  FF_STEP="checking the kept database for an admin account"
  out=$(dc exec -T api curl -fsS http://localhost:8000/setup/status 2>>"${FF_LOG:-/dev/null}") || out=""
  if [[ $out =~ \"needs_setup\"[[:space:]]*:[[:space:]]*false ]]; then
    FF_ADMIN_EXISTED=1
    _ff_p "An admin account already exists, so no new one was made. Sign in with the existing admin account."
    return 0
  fi
  if [[ $out =~ \"needs_setup\"[[:space:]]*:[[:space:]]*true ]]; then
    FF_ANSWER_STATE="FreeFrame is running but cannot be reached from outside yet, and its database has no admin account."
  else
    FF_ANSWER_STATE="FreeFrame is running but cannot be reached from outside yet, and the installer could not tell whether its database has an admin account."
  fi
  FF_ANSWER_STATE+=" Running the install command again with FREEFRAME_ADMIN_EMAIL set creates it and continues from here."
  FF_ADMIN_LATER="" FF_ADMIN_ASK_NOW=1
  _install_ask_admin
  FF_ANSWER_STATE=""
  _install_create_admin
}

# Create the admin account through the API inside the compose network,
# before Traefik makes anything reachable from outside. The answers go as
# JSON on stdin, never on a command line, and the response (which holds
# sign-in tokens) is never logged.
_install_create_admin() {
  local json out code="" body="" detail
  FF_STEP="creating the admin account"
  json="{\"email\":$(_ff_json_str "$FF_ADMIN_EMAIL"),\"name\":$(_ff_json_str "$FF_ADMIN_NAME"),\"password\":$(_ff_json_str "$FF_ADMIN_PASSWORD")}"
  out=$(printf '%s' "$json" | dc exec -T api curl -sS -X POST -H 'Content-Type: application/json' \
    --data-binary @- -w '\n%{http_code}' http://localhost:8000/setup/create-superadmin 2>>"$FF_LOG") || true
  if [[ $out == *$'\n'* ]]; then
    code=${out##*$'\n'}
    body=${out%$'\n'*}
  fi
  case $code in
    201)
      FF_ADMIN_CREATED=1
      _ff_p "Admin account created for $FF_ADMIN_EMAIL."
      # Shown right away, on the terminal only: if a later step fails, a
      # re-run cannot create the account again (403), so this must not wait
      # for the closing summary.
      if [[ -n ${FF_PW_GENERATED:-} ]]; then _install_tell_password; fi
      ;;
    "" | 000)
      install_fail "FreeFrame's API could not be reached to create the admin account." \
        "the reason is at the end of $FF_LOG. Then run sudo freeframe install again."
      ;;
    403)
      FF_ADMIN_EXISTED=1
      _ff_p "An admin account already exists, so no new one was made. Sign in with the existing admin account."
      ;;
    429)
      install_fail "The admin account could not be created yet: FreeFrame allows only 3 tries in 10 minutes." \
        "wait 10 minutes, then run sudo freeframe install again."
      ;;
    *)
      detail=$(_ff_api_detail "$body")
      install_fail "The admin account could not be created${detail:+: $detail}." \
        "check the admin email and password, then run sudo freeframe install again."
      ;;
  esac
}

# _install_traefik_closed: make sure Traefik is not running before the admin
# account is created, so the setup endpoint is never reachable from outside.
# An earlier attempt may have left it running: stop it. Fails closed when
# that cannot be confirmed.
_install_traefik_closed() {
  local running
  FF_STEP="checking that FreeFrame is still closed to the outside"
  running=$(dc ps -q traefik 2>>"$FF_LOG") ||
    install_fail "Could not check whether FreeFrame's web entrance (Traefik) is running, so the installer stopped before creating the admin account." \
      "run sudo freeframe install again; the reason is at the end of the log."
  [[ -n $running ]] || return 0
  _ff_p "Closing FreeFrame to the outside until the admin account exists (an earlier attempt left it open)..."
  _ff_logged dc stop traefik || true
  running=$(dc ps -q traefik 2>>"$FF_LOG") || running=unknown
  if [[ -n $running ]]; then
    install_fail "FreeFrame's web entrance (Traefik) is still running, so the installer stopped before creating the admin account, to keep the setup page private." \
      "run: sudo docker compose --project-name freeframe stop traefik (in /opt/freeframe), then run sudo freeframe install again."
  fi
}

# _ff_pull_failure_kind OUTPUT: why `docker compose pull` failed, from what it
# printed: missing (the release is not published, or its images are not
# public), network (ghcr.io cannot be reached), disk (the disk is full) or
# other. Pure: prints one word and nothing else.
#
# The order matters. A full disk is checked first, since it can show up next
# to the other messages. The network comes before "denied" on purpose: a
# network failure is transient and a real "denied" shows again on the next
# run, so when both appear, "check the network" is the advice that cannot
# mislead for long. Docker's own permission errors ("permission denied" on
# its socket or its storage), a missing program, or a credentials helper that
# fails are not a missing release, so they are `other`.
_ff_pull_failure_kind() {
  local o=${1,,}
  if [[ $o == *"no space left on device"* ]]; then
    printf 'disk'
    return 0
  fi
  if [[ $o == *"dial tcp"* || $o == *"no such host"* || $o == *"i/o timeout"* ||
    $o == *"connection refused"* || $o == *"tls handshake timeout"* ||
    $o == *"network is unreachable"* ]]; then
    printf 'network'
    return 0
  fi
  o=${o//permission denied/}
  if [[ $o == *"command not found"* || $o == *"no such file"* ||
    $o == *"executable file not found"* || $o == *"error getting credentials"* ||
    $o == *"cannot connect to the docker daemon"* ]]; then
    printf 'other'
  elif [[ $o == *"not found"* || $o == *"manifest unknown"* || $o == *"denied"* ||
    $o == *"unauthorized"* ]]; then
    printf 'missing'
  else
    printf 'other'
  fi
}

# _ff_pull_logged: `dc pull`, with its output (both streams) written straight
# to install.log as it arrives, so a hard kill loses nothing. What decides
# why it failed is the end of what this pull wrote (at most 64 KiB, read from
# the log's size before the pull), kept in FF_PULL_OUT; it is only
# classified, never shown. Without a log file, the output is held in memory.
_ff_pull_logged() {
  local rc=0 before=0
  FF_PULL_OUT=""
  if [[ -n ${FF_LOG:-} && -f $FF_LOG ]]; then
    before=$(wc -c <"$FF_LOG") || before=0
    before=${before//[[:space:]]/}
    dc pull >>"$FF_LOG" 2>&1 || rc=$?
    ((rc == 0)) || FF_PULL_OUT=$(tail -c "+$((before + 1))" "$FF_LOG" 2>/dev/null | tail -c 65536) || FF_PULL_OUT=""
  else
    FF_PULL_OUT=$(dc pull 2>&1) || rc=$?
    if [[ -n ${FF_LOG:-} && -n $FF_PULL_OUT ]]; then printf '%s\n' "$FF_PULL_OUT" >>"$FF_LOG"; fi
  fi
  return "$rc"
}

# _ff_pull_failure_text COMMAND VERSION: sets FF_PULL_MSG and FF_PULL_TRY for
# the download that just failed (COMMAND is install or update), from the
# output _ff_pull_logged kept. In an update nothing has changed yet, which
# the advice says.
_ff_pull_failure_text() {
  local cmd=$1 v=$2 subj="FreeFrame" again kind
  [[ -z $v || $v == unknown ]] || subj="FreeFrame $v"
  again="then run sudo freeframe $cmd again."
  kind=$(_ff_pull_failure_kind "${FF_PULL_OUT:-}")
  case $kind in
    missing)
      if [[ -z $v || $v == unknown ]]; then subj="This release of FreeFrame"; fi
      FF_PULL_MSG="$subj is not available on ghcr.io yet (the release may not be published, or its images are not public)."
      if [[ $cmd == update ]]; then
        FF_PULL_TRY="check https://github.com/Techiebutler/freeframe/releases for a newer release, then run sudo freeframe update again later; $(_update_unchanged), so running it again is safe."
      else
        FF_PULL_TRY="check https://github.com/Techiebutler/freeframe/releases for a newer release; to pin a release that is published, set FREEFRAME_VERSION in $(ff_root)/.env.prod, $again"
      fi
      # A stale login makes ghcr.io refuse an image that is public.
      FF_PULL_TRY+=" If this server was logged in to ghcr.io with docker login, run sudo docker logout ghcr.io and try again."
      ;;
    network)
      FF_PULL_MSG="$subj could not be downloaded."
      FF_PULL_TRY="check that this server can reach ghcr.io, $again"
      ;;
    disk)
      FF_PULL_MSG="The disk is full, so $subj could not be downloaded."
      FF_PULL_TRY="free some space (see how much is left with: df -h /var/lib/docker), $again"
      ;;
    *)
      FF_PULL_MSG="The download of $subj from ghcr.io failed."
      FF_PULL_TRY="read the end of ${FF_LOG:-$(ff_root)/install.log} to see what Docker said, $again"
      ;;
  esac
}

_install_start_step() {
  local out s
  local -a all=() svcs=()
  if [[ ${FF_SKIP_PULL:-} != 1 ]]; then
    FF_STEP="downloading FreeFrame"
    _ff_p "Downloading FreeFrame (about 2 GB; this can take a few minutes)..."
    if ! _ff_pull_logged; then
      _ff_pull_failure_text install "$(ff_version)"
      install_fail "$FF_PULL_MSG" "$FF_PULL_TRY"
    fi
  fi
  FF_STEP="starting FreeFrame"
  out=$(dc config --services 2>>"$FF_LOG") ||
    install_fail "The setup files could not be read." "run sudo freeframe install again; the reason is at the end of the log."
  mapfile -t all <<<"$out"
  for s in "${all[@]}"; do
    if [[ -n $s && $s != traefik ]]; then svcs+=("$s"); fi
  done
  # Fail closed: the first start must include the API and must not include
  # Traefik, whatever the downloaded compose files say.
  if ((${#svcs[@]} == 0)) || [[ " ${svcs[*]} " != *" api "* || " ${svcs[*]} " == *" traefik "* ]]; then
    install_fail "The downloaded setup files do not describe FreeFrame as expected (services: ${all[*]:-none})." \
      "run sudo freeframe install again to download them again. If it keeps happening, report it at https://github.com/Techiebutler/freeframe/issues"
  fi
  _ff_p "Starting FreeFrame (not reachable from outside yet)..."
  if ! _ff_logged dc up -d --no-build "${svcs[@]}"; then
    install_fail "FreeFrame could not be started." "run sudo freeframe install again; the reason is at the end of the log."
  fi
  FF_STATE="FreeFrame is running but cannot be reached from outside yet. Running sudo freeframe install again keeps your settings and continues from here."
  _install_wait_api
  _install_traefik_closed
  if [[ -n ${FF_ADMIN_LATER:-} ]]; then
    _install_admin_later
  else
    _install_create_admin
  fi
  FF_STEP="opening FreeFrame to the outside"
  if ! _ff_logged dc up -d --no-build traefik; then
    install_fail "FreeFrame's web entrance (Traefik) could not be started." "run sudo freeframe install again; the reason is at the end of the log."
  fi
  FF_STATE="FreeFrame is running. Running sudo freeframe install again keeps your settings and finishes the remaining checks."
}

# _install_gpu_worker_step: with the GPU chosen, check that the worker the
# start created can use it (_gpu_worker_check). Never fails the install.
_install_gpu_worker_step() {
  FF_GPU_WORKER=""
  [[ ${FF_GPU:-off} == nvidia ]] || return 0
  FF_STEP="checking that the worker can use the GPU"
  _ff_p "Checking that video processing can use the GPU..."
  _gpu_worker_check
  case ${FF_GPU_WORKER:-} in
    seen)
      if [[ -n ${FF_GPU_WORKER_AGAIN:-} ]]; then
        _ff_p "The worker did not see the GPU at first, so it was started again; it uses the GPU now."
      fi
      ;;
    unseen)
      _ff_pw "The worker could not use the NVIDIA GPU$(_gpu_worker_named), even after it was started again, so video is processed on the CPU for now. What nvidia-smi said is in the log; the install goes on."
      ;;
    down) _ff_pw "The worker that processes video is not running, so no video is processed until it starts. The install goes on; how to see why is at the end." ;;
  esac
  return 0
}

_install_verify_step() {
  local file=$1 h ok=1 http_ip
  local -a hosts=()
  FF_STEP="checking that FreeFrame answers"
  _ff_p "Checking that FreeFrame answers at $(_ff_scheme "$FF_MODE")://$FF_HOST ..."
  if ! _ff_wait_for "${FF_HEALTH_WAIT:-300}" 5 probe_health "$FF_MODE" "$FF_HOST"; then
    install_fail "FreeFrame is running but does not answer on its web address." \
      "see why with: sudo freeframe logs, then run sudo freeframe install again."
  fi
  [[ $FF_MODE != off ]] || return 0
  FF_STEP="waiting for the HTTPS certificate"
  hosts=("$FF_HOST")
  if [[ $(env_get "$file" FREEFRAME_STORAGE) == bundled ]]; then hosts+=("storage.$FF_HOST"); fi
  _ff_p "Waiting for the HTTPS certificate from Let's Encrypt (usually under a minute)..."
  for h in "${hosts[@]}"; do
    if ! _ff_wait_for "${FF_CERT_WAIT:-300}" 10 cert_issued "$h"; then
      ok=0
      break
    fi
  done
  if ((ok)); then
    _ff_p "The certificate is in place."
    return 0
  fi
  if [[ $FF_MODE == sslip ]]; then
    _ff_pw "The certificate for the temporary address $h did not arrive in time. This happens when the free sslip.io service or Let's Encrypt is busy."
    FF_STEP="switching to plain HTTP"
    http_ip=$(_install_http_ip)
    if [[ -n ${FF_NAT:-} ]]; then
      _ff_p "This server reaches the internet through a router, so FreeFrame switches to plain HTTP on the server's own network address, http://$http_ip. It works from this network only."
    else
      _ff_p "Switching to plain HTTP on this server's IP address instead..."
    fi
    if ! switch_to_http_mode "$file" "$http_ip"; then
      install_fail "Could not switch to plain HTTP." "run sudo freeframe install again; the reason is at the end of the log."
    fi
    FF_MODE=off FF_HOST=$http_ip FF_FELL_BACK=1
    if ! _ff_wait_for "${FF_HEALTH_WAIT:-300}" 5 probe_health off "$http_ip"; then
      install_fail "FreeFrame does not answer on http://$http_ip." "see why with: sudo freeframe logs, then run sudo freeframe install again."
    fi
  else
    FF_CERT_PENDING=$h
  fi
}

# Nightly backups (spec goal 11), in two parts. The units go into systemd,
# with the one daemon-reload, before FreeFrame starts, so the reload cannot
# take the GPU from the worker (backup_units_install). The timer is enabled
# and started once FreeFrame runs and the admin exists (backup_timer_on),
# so a failed install leaves no timer that would back up a FreeFrame that
# is not there. A failure stops before the install is marked complete, so a
# re-run finishes it.
_install_backup_units_step() {
  FF_STEP="setting up the nightly backups"
  if ! _ff_logged backup_units_install; then
    install_fail "The nightly database backups could not be set up." \
      "run sudo freeframe install again; the reason is at the end of the log."
  fi
}

_install_backup_timer_step() {
  FF_STEP="setting up the nightly backups"
  _ff_p "Setting up the nightly database backups..."
  if ! _ff_logged backup_timer_on; then
    install_fail "The nightly database backups could not be set up." \
      "run sudo freeframe install again; the reason is at the end of the log."
  fi
}

# _install_summary_lines WITH_PASSWORD: the closing message (spec goal 8).
# The generated password is only printed with WITH_PASSWORD=1 (the terminal),
# never into install.log. The ready line stays whole and starts the line:
# scripts read it ("FreeFrame is ready: URL").
_install_summary_lines() {
  local file=$1 with_pw=$2 root url origin rule="" width=${FF_WIDTH:-0}
  root=$(ff_root)
  url="$(_ff_scheme "$FF_MODE")://$FF_HOST"
  ((width > 0)) || width=60
  while ((${#rule} < width)); do rule+="="; done
  say ""
  say "$rule"
  if [[ -n ${FF_CERT_PENDING:-} ]]; then
    say "$(_ff_style 1 "FreeFrame is running at $url, but its HTTPS certificate has not arrived yet.")"
  else
    say "$(_ff_style "1;32" "FreeFrame is ready: $url")"
  fi
  if [[ -n ${FF_ADMIN_EXISTED:-} ]]; then
    say "Sign in with the admin account that already existed."
  else
    say "Sign in as $FF_ADMIN_EMAIL"
    if [[ -n ${FF_PW_GENERATED:-} ]]; then
      if [[ $with_pw == 1 ]]; then
        say "Password: $(_ff_style 1 "$FF_ADMIN_PASSWORD")"
        say "(made for you and shown only this once: write it down now)"
      else
        say "Password: made for you and shown on the screen only, not in this log."
      fi
    fi
  fi
  say "$rule"
  say ""
  _ff_p "$(_gpu_ready_line)"
  if [[ ${FF_GPU:-off} == nvidia && ${FF_GPU_WORKER:-} == unseen ]]; then
    _ff_p "FREEFRAME_GPU=nvidia is kept, so a later start can use the GPU. To try it again, run the command below; if video stays on the CPU, see $FF_GPU_HELP"
    say "   sudo freeframe restart"
  elif [[ ${FF_GPU:-off} == nvidia && ${FF_GPU_WORKER:-} == down ]]; then
    _ff_p "Uploaded videos wait to be processed until it starts. See why with:"
    say "   sudo freeframe logs worker"
  fi
  if [[ -n ${FF_GPU_FAILED:-} ]]; then
    _ff_p "To try setting up the GPU again, run:"
    say "   sudo freeframe configure"
  fi
  if [[ -n ${FF_CERT_PENDING:-} ]]; then
    say ""
    _ff_p "The HTTPS certificate for $FF_CERT_PENDING has not arrived yet, so browsers show a warning until it does. Check that the DNS records point at $FF_IP and that ports 80 and 443 are open to the internet, then run:"
    say "   sudo freeframe restart"
  fi
  if [[ $FF_MODE == sslip ]]; then
    say ""
    _ff_p "This is a free temporary address. For production, use your own domain:"
    say "   sudo freeframe configure"
  fi
  if [[ -n ${FF_FELL_BACK:-} ]]; then
    say ""
    _ff_p "HTTPS could not be set up for the temporary address, so FreeFrame uses plain HTTP for now and browsers mark it \"Not secure\". To use HTTPS, point a domain at this server and run:"
    say "   sudo freeframe configure"
  fi
  if [[ -z $(env_get "$file" SMTP_HOST) && $(env_get "$file" MAIL_PROVIDER) != ses ]]; then
    say ""
    _ff_p "Email is not set up. Without it, sign-in codes and invitation emails are not sent, and there is no other way to recover a forgotten password. Invitation links can still be copied from the admin page. To add email later, run:"
    say "   sudo freeframe configure"
  fi
  if [[ $FF_MODE == off && $(env_get "$file" FREEFRAME_STORAGE) == bundled ]]; then
    say ""
    _ff_p "Browsers upload footage to port 9000 on this server. If your provider has a firewall in front of the server, open ports 80 and 9000 there."
  fi
  if [[ $(env_get "$file" S3_STORAGE) == s3 ]]; then
    origin=$url
    say ""
    _ff_p "Your AWS S3 bucket needs these CORS rules so browsers can upload to it (AWS does not get them set automatically). In the AWS console: the bucket, Permissions, Cross-origin resource sharing (CORS):"
    say "[{\"AllowedOrigins\":[\"$origin\"],\"AllowedMethods\":[\"GET\",\"PUT\",\"POST\",\"HEAD\"],"
    say " \"AllowedHeaders\":[\"content-type\",\"content-md5\",\"x-amz-content-sha256\",\"x-amz-date\",\"x-amz-decoded-content-length\"],"
    say " \"ExposeHeaders\":[\"ETag\"],\"MaxAgeSeconds\":3000}]"
  fi
  say ""
  _ff_p "$(_ff_style 1 "Where things are:")"
  _install_row "Settings" "$file"
  _ff_hint 17 "Private: it holds the passwords. Keep a copy somewhere safe."
  _install_row "Backups" "$root/backups"
  _ff_hint 17 "The database, every night at 3:00; the newest $FF_BACKUP_KEEP are kept."
  _install_row "Install log" "$root/install.log"
  say ""
  _ff_p "The backups are on this server only, so they do not survive losing it. Copy them somewhere else now and then; the guide explains how: $FF_GUIDE_URL"
  _ff_p "Uploaded media is not in these backups."
  say ""
  _ff_p "$(_ff_style 1 "Commands you will need:")"
  say "   sudo freeframe status    see whether everything is running"
  say "   sudo freeframe update    move to the newest release"
  say "   sudo freeframe backup    save a copy of the database now"
}

_install_final_summary() {
  local file=$1
  _install_log_stop
  _install_summary_lines "$file" 1
  FF_COLOR="" _install_summary_lines "$file" 0 >>"$FF_LOG" 2>&1
}

# cmd_install: `freeframe install` (spec goals 1 to 10).
cmd_install() {
  local root file
  root=$(ff_root)
  file="$root/.env.prod"
  FF_STATE="Nothing on this server has been changed yet."
  FF_LOG=""
  FF_STOPPED=()
  FF_ADDR_FROM_FILE="" FF_SMTP_FROM_FILE="" FF_ADMIN_EXISTED="" FF_CERT_PENDING="" FF_FELL_BACK=""
  FF_ADMIN_CREATED="" FF_PW_GENERATED="" FF_RERUN="the install command"
  FF_ADMIN_LATER="" FF_ADMIN_ASK_NOW="" FF_ANSWER_STATE=""
  FF_DONE=()
  FF_GPU_FAILED=""

  # Refusals first: nothing is written before these pass.
  _install_check_system
  _install_check_foreign
  if [[ -f $file && -f $root/.installed ]]; then
    say "FreeFrame is already installed on this server, so nothing was changed."
    say "Its settings are in $file."
    say "To move to the newest release, run: sudo freeframe update"
    say "To change the web address, email or storage, run: sudo freeframe configure"
    return 0
  fi
  if [[ -z ${FF_YES:-} ]] && ! _ff_has_tty; then
    local example="sudo freeframe install --yes --admin-email you@yourstudio.com"
    _ff_cmd_installed || example=$(_ff_bootstrap_cmd --yes --admin-email you@yourstudio.com)
    _ff_stop 2 "There is no terminal here to answer the installer's questions." \
      "add --yes and give the answers ahead of time, for example: $example (to see every option, run: $(_ff_help_cmd))."
  fi

  _ff_screen_setup
  # The banner (or the one-line header) first, before anything that can
  # take a moment: the GPU check waits for nvidia-smi and docker info.
  if _ff_interactive; then
    _install_banner
  else
    say "FreeFrame installer (--yes: no questions; every answer is given ahead of time)"
  fi
  _install_gpu_check "$file"
  if _ff_interactive; then
    _install_count_steps "$file"
    _install_welcome
  fi
  _install_log_start
  _install_gpu_log
  FF_STATE="Nothing has been installed yet; the installer has only written its log."
  trap _install_on_error ERR
  install_preflight
  _install_questions "$file"

  # From here on the server is changed.
  _install_self
  _install_docker_step
  _install_gpu_step
  _install_swap_step
  _install_ufw_step
  _install_dns_step
  _install_fetch_step
  _install_settings_step "$file"
  _install_backup_units_step
  _install_start_step
  _uninstall_marker_cancel
  _install_verify_step "$file"
  _install_backup_timer_step
  _install_gpu_worker_step

  printf 'FreeFrame installed %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" >"$root/.installed"
  trap - ERR
  _install_final_summary "$file"
}

# ------------------------------------------------------------
# Backups and restore (spec goals 11 and 13)
#
# A backup is two files in $FF_ROOT/backups: freeframe-<YYYYmmdd-HHMMSS>.dump
# (pg_dump -Fc of the database, written under a .partial name and renamed
# only when complete) and freeframe-<same stamp>.env.prod (a copy of the
# settings). Both are mode 600 in a 700 folder: they hold the passwords.
# backup_prune keeps the newest FF_BACKUP_KEEP by name. Media in the bucket
# is not part of a backup.
#
# backup and restore take a lock ($FF_ROOT/.freeframe.lock), so the nightly
# backup never runs in the middle of a restore.
# ------------------------------------------------------------

FF_BACKUP_KEEP=7

# _ff_q PATH: PATH in single quotes, for a command printed for the reader to
# copy and paste: a space or other special character in the path then
# cannot split or change it.
_ff_q() {
  local q="'\\''"
  printf "'%s'" "${1//\'/$q}"
}

# _ff_size_bytes FILE: the size of FILE in bytes.
_ff_size_bytes() { wc -c <"$1" | tr -d '[:space:]'; }

# _ff_human_size BYTES: 512 bytes, 2 KB, 12.4 MB, 3.0 GB.
_ff_human_size() {
  awk -v b="${1:-0}" 'BEGIN {
    if (b >= 1073741824) printf "%.1f GB", b / 1073741824
    else if (b >= 1048576) printf "%.1f MB", b / 1048576
    else if (b >= 1024) printf "%d KB", b / 1024
    else printf "%d bytes", b
  }'
}

# _ff_stamp: the time stamp in a backup's name.
_ff_stamp() { date +%Y%m%d-%H%M%S; }

# _ff_stamp_date NAME: "2026-10-26 03:04:12" for freeframe-20261026-030412.dump,
# nothing for a name without a stamp. The name, not the file's time, says
# when a backup was made: copying a file between servers changes its time.
_ff_stamp_date() {
  local re='freeframe-([0-9]{4})([0-9]{2})([0-9]{2})-([0-9]{2})([0-9]{2})([0-9]{2})(-before-rollback)?\.dump$'
  [[ ${1:-} =~ $re ]] || return 0
  printf '%s-%s-%s %s:%s:%s' "${BASH_REMATCH[@]:1:6}"
}

# _ff_backup_dumps DIR: the backups in DIR, oldest first (name order), one
# path per line.
_ff_backup_dumps() {
  local f
  local LC_ALL=C
  for f in "$1"/freeframe-*.dump; do
    if [[ -f $f ]]; then printf '%s\n' "$f"; fi
  done
}

# _ff_backup_pick DIR...: the newest backup across DIRs, by the stamp in its
# name (freeframe-<YYYYmmdd-HHMMSS>.dump, compared byte by byte), never a
# rollback's copy of the database it replaced
# (freeframe-<stamp>-before-rollback.dump, which holds a newer release's
# database) while an ordinary one is there. A name without a stamp (a copy
# named by hand) is never picked. Nothing when there is none.
_ff_backup_pick() {
  local d f n ord="" rb="" re='^freeframe-[0-9]{8}-[0-9]{6}(-before-rollback)?\.dump$'
  local LC_ALL=C
  for d in "$@"; do
    [[ -n $d ]] || continue
    while IFS= read -r f; do
      n=${f##*/}
      [[ $n =~ $re ]] || continue
      if [[ -n ${BASH_REMATCH[1]} ]]; then
        if [[ -z $rb || $n > ${rb##*/} ]]; then rb=$f; fi
      elif [[ -z $ord || $n > ${ord##*/} ]]; then
        ord=$f
      fi
    done < <(_ff_backup_dumps "$d")
  done
  printf '%s' "${ord:-$rb}"
}

# _ff_backup_count DIR...: how many different backups (by name, as
# _ff_backup_pick reads them) there are across DIRs.
_ff_backup_count() {
  local d f re='^freeframe-[0-9]{8}-[0-9]{6}(-before-rollback)?\.dump$'
  local -A seen=()
  for d in "$@"; do
    [[ -n $d ]] || continue
    while IFS= read -r f; do
      if [[ ${f##*/} =~ $re ]]; then seen[${f##*/}]=1; fi
    done < <(_ff_backup_dumps "$d")
  done
  printf '%s' "${#seen[@]}"
}

# _ff_backup_newest DIR: the newest backup in DIR (_ff_backup_pick).
_ff_backup_newest() { _ff_backup_pick "$1"; }

# _ff_is_pg_dump FILE: 0 when FILE is a pg_dump custom-format archive (it
# starts with PGDMP), which is what freeframe backup writes.
_ff_is_pg_dump() { [[ -r $1 && $(head -c 5 "$1" 2>/dev/null) == PGDMP ]]; }

# _ff_pg_names: FF_PG_USER and FF_PG_DB from .env.prod, with the defaults
# docker-compose.prod.yml and derive_env use.
_ff_pg_names() {
  local file
  file="$(ff_root)/.env.prod"
  FF_PG_USER=$(env_get "$file" POSTGRES_USER)
  FF_PG_DB=$(env_get "$file" POSTGRES_DB)
  FF_PG_USER=${FF_PG_USER:-freeframe}
  FF_PG_DB=${FF_PG_DB:-freeframe}
}

# _ff_need_root COMMAND / _ff_need_install: the refusals every command
# other than install shares.
_ff_need_root() {
  if ! ff_is_root; then
    _ff_stop 2 "Please run this as root." "put sudo in front of the command: sudo freeframe $1"
  fi
}

_ff_need_install() {
  local root
  root=$(ff_root)
  if [[ ! -f $root/.env.prod ]]; then
    _ff_stop 1 "FreeFrame is not installed on this server (there is no $root/.env.prod), so there is nothing to do." \
      "install it first: see $FF_GUIDE_URL"
  fi
}

# _ff_lock NAME: take the lock ($FF_ROOT/.freeframe.lock) that every
# command which changes the server holds (update, rollback, backup, restore,
# restart, configure, uninstall), without waiting. 1 when another of them holds it.
# The holder writes "NAME PID" into the file (_ff_lock_holder reads it).
# Without flock (not on a supported server) there is no lock.
# FF_BUSY: the start of the message when the lock is held, naming them all.
FF_BUSY="Another freeframe command (an update, rollback, backup, restore, restart, configure or uninstall) is running right now"

_ff_lock() {
  local root
  root=$(ff_root)
  command -v flock >/dev/null 2>&1 || return 0
  # Held already: by this process, or handed on by the update's re-exec (the
  # descriptor stays open across exec, and so does its lock). FF_LOCK_FD
  # counts only while it is open on the lock file itself: any other file
  # under that number would lock nothing.
  if [[ ${FF_LOCK_FD:-} =~ ^[0-9]+$ && /proc/self/fd/$FF_LOCK_FD -ef $root/.freeframe.lock ]] &&
    flock -n "$FF_LOCK_FD" 2>/dev/null; then
    return 0
  fi
  (umask 077 && : >>"$root/.freeframe.lock") || return 0
  exec {FF_LOCK_FD}>>"$root/.freeframe.lock"
  flock -n "$FF_LOCK_FD" || return 1
  # Written through a descriptor of its own: closing it keeps the lock,
  # which belongs to FF_LOCK_FD's.
  printf '%s %s\n' "${1:-freeframe}" "$$" >"$root/.freeframe.lock" 2>/dev/null || true
}

# _ff_unlock: let go of the lock. Only uninstall does, just before it removes
# the folder that holds the lock file; every other command keeps it until
# it exits.
_ff_unlock() {
  [[ ${FF_LOCK_FD:-} =~ ^[0-9]+$ ]] || return 0
  flock -u "$FF_LOCK_FD" 2>/dev/null || true
  exec {FF_LOCK_FD}>&-
  FF_LOCK_FD=""
}

# _ff_lock_holder: the name of the command that holds the lock, when the
# lock file names one whose process still runs; nothing otherwise (call it
# only once _ff_lock was refused).
_ff_lock_holder() {
  local name="" pid=""
  read -r name pid <"$(ff_root)/.freeframe.lock" 2>/dev/null || true
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 0
  printf '%s' "$name"
}

# _ff_lock_busy: 0 when another freeframe command holds the lock right now
# (status asks; it never keeps the lock).
_ff_lock_busy() {
  local f fd
  f="$(ff_root)/.freeframe.lock"
  command -v flock >/dev/null 2>&1 || return 1
  [[ -r $f ]] || return 1
  exec {fd}<"$f"
  if flock -n "$fd"; then
    flock -u "$fd"
    exec {fd}<&-
    return 1
  fi
  exec {fd}<&-
  return 0
}

# _ff_log_open COMMAND: write to install.log (mode 600) without copying the
# screen into it; for the nightly backup, whose own messages go to the
# journal.
_ff_log_open() {
  local root
  root=$(ff_root)
  FF_LOG="$root/install.log"
  if ! { (umask 077 && : >>"$FF_LOG") && chmod 600 "$FF_LOG"; }; then
    # No log (a full disk, say): the messages then do not mention one.
    FF_LOG=""
    return 0
  fi
  printf '\n===== freeframe %s, %s =====\n' "$1" "$(date '+%Y-%m-%d %H:%M:%S %z')" >>"$FF_LOG"
}

# _ff_backup_cleanup: remove what a backup that did not finish left behind.
_ff_backup_cleanup() {
  [[ -n ${FF_PARTIAL:-} ]] || return 0
  rm -f "$FF_PARTIAL.dump.partial" "$FF_PARTIAL.env.prod.partial"
  FF_PARTIAL=""
}

# _ff_log_lines LINE...: append LINEs to install.log, when the screen is not
# already copied into it (restore tees everything; backup does not). The
# lines are messages only, never a secret.
_ff_log_lines() {
  [[ -n ${FF_LOG:-} && -z ${FF_TERM_OUT:-} ]] || return 0
  printf '%s\n' "$@" >>"$FF_LOG" 2>/dev/null || true
}

# _ff_backup_refused LINE...: a backup that did not happen. Says so, and
# that the earlier backups are untouched, on the screen (or the journal) and
# in install.log.
_ff_backup_refused() {
  local line
  _ff_backup_cleanup
  # The log first, and a screen or journal that is gone (an ssh hangup, a
  # stopped journald) must not stop the rest, even under set -e.
  _ff_log_lines "$@" "No new backup was made; the earlier ones are untouched."
  for line in "$@"; do warn "$line" || true; done
  warn "No new backup was made; the earlier ones are untouched." || true
}

# backup_create prune|keep: save a backup of the database now (see the top of
# this section). Sets FF_BACKUP_MADE to the new .dump. With prune, only the
# newest FF_BACKUP_KEEP are kept afterwards; restore's safety copy uses keep,
# so it can never delete the backup being restored. Refuses when the disk has
# less free space than twice the last backup, or 1 GB. Prints its own
# message and returns 1 when no backup was made.
backup_create() {
  local mode=${1:-prune} root dir file base stamp last="" last_bytes=0 need free retry protect upd f
  local -a dumps=()
  root=$(ff_root)
  dir="$root/backups"
  file="$root/.env.prod"
  retry=${FF_RERUN:-sudo freeframe backup}
  FF_BACKUP_MADE="" FF_PARTIAL=""
  if ! { (umask 077 && mkdir -p "$dir") && chmod 700 "$dir"; }; then
    _ff_backup_refused "Cannot create the backups folder $dir." \
      "What to try: check that the disk is not full or read-only, then run: $retry"
    return 1
  fi
  # What a backup killed part-way (SIGKILL, power loss) left behind. Callers
  # hold the backup/restore lock, so no other backup is writing these.
  for f in "$dir"/freeframe-*.partial; do
    if [[ -e $f ]]; then
      rm -f -- "$f"
      printf 'backup: removed %s, left by a backup that did not finish\n' "$f" >>"${FF_LOG:-/dev/null}"
    fi
  done

  # The copy an unfinished restore can be undone with is kept out of the
  # size rule and out of pruning while it is recorded.
  protect=$(_restore_undo_path)
  upd=""
  if _update_undo_read; then upd=$FF_UNDO_BACKUP; fi
  mapfile -t dumps < <(_ff_backup_dumps "$dir")
  for f in ${dumps[@]+"${dumps[@]}"}; do
    if [[ $f != "$protect" && $f != "$upd" ]]; then last=$f; fi
  done
  if [[ -n $last ]]; then
    last_bytes=$(_ff_size_bytes "$last") || last_bytes=0
    [[ $last_bytes =~ ^[0-9]+$ ]] || last_bytes=0
  fi
  need=$(((2 * last_bytes + 1048575) / 1048576))
  ((need >= 1024)) || need=1024
  free=$(_ff_free_mb "$root") || free=""
  if [[ ! $free =~ ^[0-9]+$ ]]; then
    _ff_backup_refused "Could not check the free disk space under $root, so no backup was made." \
      "What to try: check the disk (df -h $(_ff_q "$root")), then run: $retry"
    return 1
  fi
  if ((free < need)); then
    _ff_backup_refused "There is not enough free disk space for a backup: $free MB free under $root, and a backup needs at least $need MB there (twice the size of the last backup, and never less than 1 GB)." \
      "What to try: make room on the disk, for example by copying older backups from $dir to another computer and deleting them here, then run: $retry"
    return 1
  fi

  _ff_pg_names
  # The nightly timer catches up at boot (Persistent=true), possibly before
  # Docker has started the database: give it a minute.
  if ! _ff_wait_for "${FF_BACKUP_DB_WAIT:-60}" 5 _ff_logged dc exec -T postgres pg_isready -U "$FF_PG_USER"; then
    _ff_backup_refused "FreeFrame's database is not running, so no backup was made." \
      "What to try: start FreeFrame (sudo freeframe restart), then run: $retry"
    return 1
  fi
  # FF_BACKUP_IF_DATA (freeframe backup): a database with no tables, as a
  # failed restore leaves it, is not backed up, so its copy never replaces a
  # real backup. FF_BACKUP_EMPTY tells the caller; it says so itself.
  if [[ -n ${FF_BACKUP_IF_DATA:-} && $(_restore_db_state || true) == empty ]]; then
    FF_BACKUP_EMPTY=1
    return 1
  fi
  stamp=$(_ff_stamp) || stamp=""
  while [[ $stamp =~ ^[0-9]{8}-[0-9]{6}$ ]] &&
    [[ -e $dir/freeframe-$stamp${FF_BACKUP_SUFFIX:-}.dump || -e $dir/freeframe-$stamp${FF_BACKUP_SUFFIX:-}.env.prod ]]; do
    sleep 1
    stamp=$(_ff_stamp) || stamp=""
  done
  if [[ ! $stamp =~ ^[0-9]{8}-[0-9]{6}$ ]]; then
    _ff_backup_refused "The backup could not be named: the server's date ('$stamp') is not usable." \
      "What to try: check the date with: date, then run: $retry"
    return 1
  fi
  # FF_BACKUP_SUFFIX: -before-rollback for the copy a rollback saves.
  base="$dir/freeframe-$stamp${FF_BACKUP_SUFFIX:-}"
  FF_PARTIAL=$base
  printf 'backup: writing %s.dump\n' "$base" >>"${FF_LOG:-/dev/null}"
  if ! (umask 077 && dc exec -T postgres pg_dump -Fc -U "$FF_PG_USER" "$FF_PG_DB" \
    >"$base.dump.partial" 2>>"${FF_LOG:-/dev/null}"); then
    _ff_backup_refused "The database could not be backed up: FreeFrame's database did not answer, or the copy stopped part-way." \
      "What to try: check that FreeFrame's database is running (sudo freeframe status), then run: $retry.${FF_LOG:+ The reason is at the end of $FF_LOG.}"
    return 1
  fi
  if ! _ff_is_pg_dump "$base.dump.partial"; then
    _ff_backup_refused "The database could not be backed up: what came back is not a database copy." \
      "What to try: run: $retry.${FF_LOG:+ The reason is at the end of $FF_LOG.}"
    return 1
  fi
  if ! { (umask 077 && cp "$file" "$base.env.prod.partial") && chmod 600 "$base.env.prod.partial"; }; then
    _ff_backup_refused "The settings could not be copied next to the backup." \
      "What to try: check that the disk is not full, then run: $retry"
    return 1
  fi
  # The settings copy first: a .dump that exists always has its settings.
  if ! { mv -f "$base.env.prod.partial" "$base.env.prod" && mv -f "$base.dump.partial" "$base.dump"; }; then
    rm -f "$base.env.prod"
    _ff_backup_refused "The backup could not be saved under its final name in $dir." \
      "What to try: check that the disk is not full, then run: $retry"
    return 1
  fi
  FF_PARTIAL=""
  FF_BACKUP_MADE="$base.dump"
  printf 'backup: saved %s.dump (%s)\n' "$base" "$(_ff_human_size "$(_ff_size_bytes "$base.dump")")" >>"${FF_LOG:-/dev/null}"
  if [[ $mode == prune ]] && ! backup_prune "$dir" "$FF_BACKUP_KEEP" "$protect" "$upd"; then
    warn "The backup was saved, but older backups could not be cleared away."
  fi
  return 0
}

# _backup_on_signal SIG: Ctrl-C, systemctl stop or a shutdown during a
# backup. The part-written files are removed (and a SIGKILL's are removed by
# the next backup).
_backup_on_signal() {
  # PIPE too: a write to a vanished reader then fails instead of killing.
  trap '' INT TERM HUP PIPE
  # To the saved stderr: a trap runs inside the redirection of the command
  # it interrupted.
  _ff_backup_refused "The backup was stopped (SIG$1) before it finished." 2>&"${FF_BACKUP_ERR:-2}"
  exit 1
}

# _backup_not_now NIGHTLY_REASON REASON TRY: the database may be empty, so
# no backup is made and none is pruned. The nightly run (--quiet) is skipped
# with one line and exit 0; a run by hand is refused (exit 1).
_backup_not_now() {
  local msg
  if [[ -n ${FF_QUIET:-} ]]; then
    msg="The nightly backup was skipped: $1. The backups already here were kept."
    say "$msg"
    _ff_log_lines "$msg"
    return 0
  fi
  msg="$2, and a backup of it could replace a real one. No backup was made."
  _ff_log_lines "$msg" "What to try: $3"
  _ff_stop 1 "$msg" "$3"
}

# cmd_backup: `freeframe backup [--quiet]`. --quiet (the nightly timer)
# prints nothing when the backup is saved, and a plain error when not.
cmd_backup() {
  local root base size holder
  root=$(ff_root)
  if ((${#FF_ARGS[@]})); then
    _ff_bad_usage "freeframe backup takes no file name: backups always go to $root/backups."
  fi
  _ff_need_root backup
  _ff_need_install
  FF_ACTOR="the backup"
  _ff_log_open backup
  if ! _ff_lock backup; then
    # The nightly run behind an update or a rollback is skipped, not failed:
    # both enable the timer again while they hold the lock, which fires a
    # missed run at once (Persistent=true), and an update takes a backup of
    # its own first. So is the one behind an uninstall, which backs up first
    # and then removes the timer. Anything else holding the lock (or a run by hand) is
    # refused, so a backup that was wanted and not made is never silent.
    holder=$(_ff_lock_holder)
    if [[ -n ${FF_QUIET:-} && ( $holder == update || $holder == rollback || $holder == uninstall ) ]]; then
      local skip="The nightly backup was skipped: a freeframe $holder is running right now."
      if [[ $holder == update ]]; then
        skip+=" The update saves a backup of the database of its own before it changes anything."
      elif [[ $holder == uninstall ]]; then
        skip+=" It saves a final backup of the database of its own before it removes anything."
      else
        skip+=" The next one runs as usual; for one sooner, run sudo freeframe backup once the rollback has finished."
      fi
      say "$skip"
      _ff_log_lines "$skip"
      return 0
    fi
    _ff_log_lines "$FF_BUSY, so this backup did not start."
    _ff_stop 1 "$FF_BUSY, so this backup did not start." \
      "wait a few minutes for it to finish, then run sudo freeframe backup again."
  fi
  # While a restore is unfinished the database may be empty: a copy of it
  # would push a real backup out of the newest 7 every night. Read under the
  # lock, which a running restore holds.
  if [[ -f $(_restore_undo_file) ]]; then
    _backup_not_now "a restore of the database did not finish, so the database may be empty" \
      "A restore of the database did not finish, so the database may be empty" \
      "$(_ff_unfinished_restore_try "$(_restore_undo_path)")"
    return 0
  fi
  exec {FF_BACKUP_ERR}>&2
  # No ERR trap: backup_create runs inside `if !`, where bash never fires
  # one, so every step in it is checked explicitly instead.
  trap '_backup_on_signal INT' INT
  trap '_backup_on_signal TERM' TERM
  trap '_backup_on_signal HUP' HUP
  FF_BACKUP_IF_DATA=1 FF_BACKUP_EMPTY=""
  if ! backup_create prune; then
    trap - INT TERM HUP
    if [[ -n $FF_BACKUP_EMPTY ]]; then
      _backup_not_now "FreeFrame's database is empty (it has no tables)" \
        "FreeFrame's database is empty (it has no tables)" \
        "if a restore failed, run it again: sudo freeframe restore"
      return 0
    fi
    exit 1
  fi
  trap - INT TERM HUP
  [[ -z ${FF_QUIET:-} ]] || return 0
  base=${FF_BACKUP_MADE%.dump}
  size=$(_ff_human_size "$(_ff_size_bytes "$FF_BACKUP_MADE")")
  say "Saved a backup of the database: $FF_BACKUP_MADE ($size),"
  say "with a copy of the settings next to it: ${base##*/}.env.prod"
  say "The newest $FF_BACKUP_KEEP backups are kept, and one is made every night at 3:00."
  say "They are on this server only, so they do not survive losing it: copy them somewhere else"
  say "now and then (the guide explains how: $FF_GUIDE_URL). Uploaded media is not in them."
}

# restore_list: the backups on this server, newest first, with dates and sizes.
restore_list() {
  local dir f name when i undo
  local -a dumps=()
  dir="$(ff_root)/backups"
  mapfile -t dumps < <(_ff_backup_dumps "$dir")
  if ((${#dumps[@]} == 0)); then
    say "There are no backups in $dir yet."
    say "To make one now, run: sudo freeframe backup"
    return 0
  fi
  say "Backups on this server, newest first:"
  for ((i = ${#dumps[@]} - 1; i >= 0; i--)); do
    f=${dumps[i]}
    name=${f##*/}
    when=$(_ff_stamp_date "$name")
    printf '  %-34s  %-19s  %s%s\n' "$name" "${when:-(no date)}" "$(_ff_human_size "$(_ff_size_bytes "$f")")" \
      "$([[ $name == *-before-rollback.dump ]] && printf '  (the database just before a rollback, from the newer release)')"
  done
  say ""
  say "To put one back, run for example (this replaces the current database, after saving a copy of it):"
  say "  sudo freeframe restore $(_ff_q "$(_ff_backup_newest "$dir")")"
  say "A backup copied from another server can be given by its path."
  undo=$(_restore_undo_path)
  if [[ -n $undo ]]; then
    say ""
    say "A restore did not finish. The copy of the database from before it is kept: $undo"
    say "To go back to it, run: sudo freeframe restore --yes $(_ff_q "$undo")"
  fi
}

# _restore_resolve ARG: the full path of the backup ARG names: a path, or a
# name in the backups folder. Stops when there is no such backup.
_restore_resolve() {
  local arg=$1 root path=""
  root=$(ff_root)
  if [[ -f $arg ]]; then
    path=$arg
  elif [[ $arg != */* && -f $root/backups/$arg ]]; then
    path="$root/backups/$arg"
  else
    _ff_stop 1 "There is no backup file '$arg', so nothing was changed." \
      "run sudo freeframe restore with no file name to see the backups on this server."
  fi
  if [[ $path != /* ]]; then path="$(cd "$(dirname "$path")" && pwd)/${path##*/}"; fi
  if ! _ff_is_pg_dump "$path"; then
    _ff_stop 1 "'$path' is not a FreeFrame database backup (one made by freeframe backup), so nothing was changed." \
      "pick one of the backups listed by: sudo freeframe restore. A .sql.gz backup from a manual setup is restored by hand, as the guide explains: $FF_GUIDE_URL"
  fi
  FF_RESTORE_FILE=$path
}

# The undo record ($FF_ROOT/.restore-undo, mode 600): the path of the safety
# copy taken by a restore whose database may now be empty or gone. A retry
# over an absent or empty database keeps pointing at it instead of copying
# that empty database; over a database with data a retry takes a fresh copy,
# which replaces the record. backup_create keeps the recorded copy out of
# pruning and the size rule. Cleared as soon as pg_restore succeeds (the
# database is whole again), and when the run that wrote it stops before the
# drop began.
_restore_undo_file() { printf '%s/.restore-undo' "$(ff_root)"; }

# _restore_undo_path: the recorded safety copy, when it still exists.
_restore_undo_path() {
  local f p=""
  f=$(_restore_undo_file)
  [[ -f $f ]] || return 0
  IFS= read -r p <"$f" || true
  if [[ -n $p && -f $p ]]; then printf '%s' "$p"; fi
  return 0
}

_restore_undo_set() {
  local f
  f=$(_restore_undo_file)
  (umask 077 && printf '%s\n' "$1" >"$f.tmp") && chmod 600 "$f.tmp" && mv -f "$f.tmp" "$f"
}

_restore_undo_clear() { rm -f "$(_restore_undo_file)"; }

# _restore_forget_new_record: this run recorded its own copy, then stopped
# before dropping the database. The database still has its data, so the
# record would only mislead a later restore.
_restore_forget_new_record() {
  if [[ -n ${FF_RECORD_NEW:-} && -z ${FF_DROP_STARTED:-} ]]; then _restore_undo_clear; fi
  return 0
}

# _restore_db_state: what is in FreeFrame's database now, asked through the
# maintenance database: absent, empty (no tables, as a failed restore leaves
# it) or data. Fails (1) when that cannot be found out.
_restore_db_state() {
  local n
  n=$(printf "SELECT count(*) FROM pg_database WHERE datname = :'db';\n" |
    dc exec -T postgres psql -U "$FF_PG_USER" -d postgres -v db="$FF_PG_DB" -Atq 2>>"${FF_LOG:-/dev/null}") || return 1
  case $n in
    0)
      printf 'absent'
      return 0
      ;;
    1) ;;
    *) return 1 ;;
  esac
  n=$(dc exec -T postgres psql -U "$FF_PG_USER" -d "$FF_PG_DB" -Atqc \
    "SELECT count(*) FROM pg_tables WHERE schemaname NOT IN ('pg_catalog', 'information_schema')" \
    2>>"${FF_LOG:-/dev/null}") || return 1
  [[ $n =~ ^[0-9]+$ ]] || return 1
  if ((n == 0)); then printf 'empty'; else printf 'data'; fi
}

# _restore_fail STATE MESSAGE WHAT_TO_TRY: a step failed; STATE says where
# that leaves the database and FreeFrame.
_restore_fail() {
  FF_STATE=$1
  if [[ -n ${FF_RESTORE_NO_START:-} ]]; then
    # Within a rollback the setup files and the version were changed
    # already (FF_STATE_PREFIX says so); only the database was not.
    local msg=${2//nothing was changed/the database was not changed}
    install_fail "${msg//before changing anything/before changing the database}" "$3"
  fi
  install_fail "$2" "$3"
}

# _restore_start_hint: how to get FreeFrame going after a restore stopped
# before the drop: restart, unless an earlier restore that did not finish
# left the database possibly empty (restart refuses then, and starting
# FreeFrame would open its setup page): then finish or undo that restore.
_restore_start_hint() {
  local undo
  # A rollback's own state line says what to do (FF_STATE_PREFIX).
  [[ -z ${FF_RESTORE_NO_START:-} ]] || return 0
  undo=$(_restore_undo_path)
  if [[ -z $undo ]]; then
    printf 'To start FreeFrame again as it was, run: sudo freeframe restart'
    return 0
  fi
  printf 'FreeFrame stays stopped: an earlier restore did not finish, so the database may be empty. To finish, run: %s' "$FF_RERUN"
  if [[ $undo != "${FF_RESTORE_FILE:-}" ]]; then
    printf '. To go back to the data as it was before that restore instead, run: sudo freeframe restore --yes %s' "$(_ff_q "$undo")"
  fi
}

# _restore_restart: start FreeFrame again after a step that changed nothing
# failed, and print the sentence that says whether that worked. While an
# earlier restore's undo record stands it starts nothing and says why.
_restore_restart() {
  # Rollback: the old version must not start on the database the update
  # left, so nothing is started (FF_STATE_PREFIX says what to do).
  [[ -z ${FF_RESTORE_NO_START:-} ]] || return 0
  if [[ -n $(_restore_undo_path) ]]; then
    _restore_start_hint
    return 0
  fi
  if _ff_logged dc up -d --no-build; then
    _uninstall_marker_cancel
    printf 'FreeFrame has been started again.'
  else
    printf 'FreeFrame could not be started again. To start it, run: sudo freeframe restart'
  fi
}

_restore_on_error() {
  local code=$?
  if ((BASH_SUBSHELL > 0)); then exit "$code"; fi
  trap - ERR
  _ff_backup_cleanup
  _restore_forget_new_record
  _restore_report "The restore stopped unexpectedly while ${FF_STEP:-restoring} (error $code)." \
    "look at the end of ${FF_LOG:-the output above} for the reason."
}

# _restore_report MESSAGE WHAT_TO_TRY: install_fail for the restore's traps.
# A trap runs inside the redirection of the command it interrupted (often
# `_ff_logged ...`, which writes to the log only), so the lines go through a
# pipe of their own to the terminal and the log, then the restore exits 1.
_restore_report() {
  if [[ -z ${FF_TERM_ERR:-} ]]; then install_fail "$1" "$2"; fi
  (
    FF_TERM_OUT=""
    install_fail "$1" "$2"
  ) 2>&1 | tee -a "${FF_LOG:-/dev/null}" >&"$FF_TERM_ERR" || true
  exit 1
}

# _restore_on_signal SIG: Ctrl-C, a closed terminal or a shutdown during a
# restore. Says what state the database is in and how to go on, like any
# other stop.
_restore_on_signal() {
  trap '' INT TERM HUP
  trap - ERR
  _ff_backup_cleanup
  _restore_forget_new_record
  _restore_report "The restore was stopped (SIG$1) while ${FF_STEP:-restoring}, before it finished." \
    "to finish it, run: $FF_RERUN"
}

# cmd_restore: `freeframe restore [FILE]` (spec goal 13). With no FILE it
# lists the backups. With FILE it asks first (unless --yes), stops every
# service except postgres and traefik, saves a safety copy of the current
# database as a normal backup, recreates the database, restores FILE into it
# with pg_restore --no-owner --no-acl in one transaction (so a backup from a
# server with another database user restores too), and starts FreeFrame
# again.
# If a step after the drop fails, FreeFrame stays stopped (on an empty
# database its setup page would be open to anyone) and the message says what
# state the database is in and the command that tries again.
cmd_restore() {
  local root dump when undo undo_cmd
  root=$(ff_root)
  if ((${#FF_ARGS[@]} > 1)); then
    _ff_bad_usage "freeframe restore takes one backup file, for example: sudo freeframe restore $(_ff_q "$root/backups/freeframe-20261026-030000.dump")"
  fi
  _ff_need_root restore
  _ff_need_install
  if ((${#FF_ARGS[@]} == 0)); then
    restore_list
    return 0
  fi
  _restore_resolve "${FF_ARGS[0]}"
  dump=$FF_RESTORE_FILE
  when=$(_ff_stamp_date "${dump##*/}")

  if [[ -z ${FF_YES:-} ]]; then
    if ! _ff_has_tty; then
      _ff_stop 2 "Restoring replaces everything in FreeFrame's database, so it needs a yes, and there is no terminal here to ask." \
        "run it in a terminal, or add --yes: sudo freeframe restore --yes $(_ff_q "$dump")"
    fi
    say "This replaces everything in FreeFrame's database with the backup${when:+ made $when}:"
    say "  $dump"
    say "Projects, comments, people and share links added or changed since then will be gone."
    say "A copy of the current database is saved first, so this can be undone. Uploaded media"
    say "files are not in the backup and stay as they are. FreeFrame is stopped while this runs."
    if ! confirm "Restore this backup now?" N; then
      say "Restore cancelled. Nothing was changed."
      exit 1
    fi
  fi

  if ! _ff_lock restore; then
    _ff_stop 1 "$FF_BUSY, so this restore did not start. Nothing was changed." \
      "wait a few minutes for it to finish, then run the command again."
  fi
  FF_ACTOR="the restore"
  FF_STOPPED=()
  FF_ADMIN_CREATED="" FF_PW_GENERATED=""
  FF_RERUN="sudo freeframe restore --yes $(_ff_q "$dump")"
  FF_STATE="Nothing has been changed."
  FF_RECORD_NEW="" FF_DROP_STARTED="" FF_RESTORE_NO_START="" FF_STATE_PREFIX=""
  _install_log_start restore
  trap _restore_on_error ERR
  trap '_restore_on_signal INT' INT
  trap '_restore_on_signal TERM' TERM
  trap '_restore_on_signal HUP' HUP
  restore_database "$dump"
  undo=$FF_RESTORE_UNDO undo_cmd=$FF_RESTORE_UNDO_CMD

  FF_STATE="The backup has been put back${undo:+ (the database as it was before is saved; to go back to it, run: $undo_cmd)}."
  FF_STEP="starting FreeFrame again"
  say "Starting FreeFrame again..."
  if ! _ff_logged dc up -d --no-build; then
    install_fail "The backup has been put back, but FreeFrame could not be started again." \
      "see why with: sudo freeframe logs, then run: sudo freeframe restart"
  fi
  _uninstall_marker_cancel
  if ! _ff_wait_for "${FF_API_WAIT:-600}" 5 _ff_logged dc exec -T api curl -fsS http://localhost:8000/health; then
    install_fail "The backup has been put back, but FreeFrame did not finish starting within $(((${FF_API_WAIT:-600} + 59) / 60)) minutes." \
      "see why with: sudo freeframe logs, then run: sudo freeframe restart"
  fi
  FF_STEP="checking that the worker can use the GPU"
  _gpu_worker_check
  _gpu_worker_say
  trap - ERR INT TERM HUP
  say ""
  say "The database is back as it was in $dump${when:+ (made $when)}."
  if [[ -n $undo ]]; then say "The database as it was before is saved; to go back to it, run: $undo_cmd"; fi
  _install_log_stop
}

# restore_database DUMP: put DUMP back as FreeFrame's database (spec goal
# 13). The caller holds the lock, logs and sets the traps, FF_RERUN (the
# command that tries again) and FF_RESTORE_FILE. Stops every service except
# postgres and traefik, saves a safety copy when the database has data
# (recorded in .restore-undo while the database may be empty), drops and
# recreates the database and restores DUMP in one transaction. FreeFrame is
# not started: the caller does that. An early failure starts FreeFrame again
# as it was, unless FF_RESTORE_NO_START (rollback: the old version must not
# start on the database the update left) or an earlier restore is
# unfinished. Sets FF_RESTORE_UNDO / FF_RESTORE_UNDO_CMD to the way back.
restore_database() {
  local root dump=$1 out s state recorded="" undo="" undo_cmd=""
  local -a all=() svcs=()
  root=$(ff_root)
  FF_RESTORE_UNDO="" FF_RESTORE_UNDO_CMD=""
  _ff_pg_names
  recorded=$(_restore_undo_path)
  if [[ -z $recorded && -f $(_restore_undo_file) ]]; then
    warn "The copy recorded by an earlier restore that did not finish is no longer there, so it cannot be used to undo."
    _restore_undo_clear
  fi

  FF_STEP="starting the database"
  say "Restoring the database from $dump"
  if ! _ff_logged dc up -d --no-build postgres ||
    ! _ff_wait_for "${FF_DB_WAIT:-120}" 2 _ff_logged dc exec -T postgres pg_isready -U "$FF_PG_USER"; then
    _restore_fail "" "FreeFrame's database did not start, so nothing was changed." \
      "see why with: sudo freeframe logs postgres, then run: $FF_RERUN"
  fi

  FF_STEP="stopping FreeFrame"
  out=$(dc config --services 2>>"$FF_LOG") ||
    _restore_fail "" "The setup files in $root could not be read, so nothing was changed." \
      "run: $FF_RERUN. The reason is at the end of the log."
  mapfile -t all <<<"$out"
  for s in "${all[@]}"; do
    if [[ -n $s && $s != postgres && $s != traefik ]]; then svcs+=("$s"); fi
  done
  say "Stopping FreeFrame (its web address shows an error until the restore is done)..."
  FF_STATE="FreeFrame may be partly stopped; the database has not been changed. $(_restore_start_hint)"
  if ((${#svcs[@]})) && ! _ff_logged dc stop "${svcs[@]}"; then
    _restore_fail "$(_restore_restart)" "FreeFrame could not be stopped, so nothing was changed." \
      "run: $FF_RERUN. The reason is at the end of the log."
  fi
  FF_STATE="FreeFrame is stopped and the database has not been changed. $(_restore_start_hint)"

  # Whether a copy is needed is asked through the maintenance database: an
  # absent or empty database has nothing to save, and one that exists but
  # cannot be checked is never dropped without a copy.
  FF_STEP="checking the current database"
  if ! state=$(_restore_db_state); then
    _restore_fail "$(_restore_restart)" "The current database could not be checked, so the restore stopped before changing anything (it will not replace a database it cannot copy first)." \
      "the reason is at the end of $FF_LOG. Then run: $FF_RERUN"
  fi
  FF_STEP="saving a copy of the current database"
  if [[ $state == data ]]; then
    say "Saving a copy of the current database first..."
    if ! backup_create keep; then
      _restore_fail "$(_restore_restart)" "No copy of the current database could be saved, so the restore stopped before changing anything." \
        "fix what the message above says, then run: $FF_RERUN"
    fi
    # The database has data, so this copy is the way back: it replaces any
    # record left by an earlier restore (whose database is no longer the
    # one there now). Flagged first: a signal while it is written must
    # still drop it.
    FF_RECORD_NEW=1
    if ! _restore_undo_set "$FF_BACKUP_MADE"; then
      _restore_fail "$(_restore_restart)" "The copy of the current database ($FF_BACKUP_MADE) could not be recorded, so the restore stopped before changing anything." \
        "check that the disk is not full, then run: $FF_RERUN"
    fi
    say "Saved the current database as $FF_BACKUP_MADE"
    if [[ -n $recorded && $recorded != "$dump" ]]; then
      say "An earlier restore had not finished; its copy ($recorded) is an ordinary backup again."
    fi
    recorded=$FF_BACKUP_MADE
  elif [[ -n $recorded ]]; then
    say "The database is empty after an earlier restore that did not finish, so there is nothing new to save."
    say "The copy from before that restore is kept: $recorded"
  else
    say "The current database is empty or not there, so there is nothing to save before the restore."
  fi
  # Restoring the recorded copy itself is the undo: then there is nothing
  # further to go back to. A rollback offers none: the copy holds what the
  # update left, which the old version must not start on.
  if [[ -n $recorded && $recorded != "$dump" && -z ${FF_RESTORE_NO_START:-} ]]; then
    undo=$recorded
    undo_cmd="sudo freeframe restore --yes $(_ff_q "$undo")"
  fi

  FF_STEP="removing the current database"
  say "Replacing the database with the backup..."
  FF_DROP_STARTED=1
  FF_STATE="The database may already have been removed. FreeFrame is stopped, so nothing can write to it. To try again, run: $FF_RERUN${undo:+. To go back to the data as it was before this restore instead, run: $undo_cmd}"
  if ! _ff_logged dc exec -T postgres dropdb -U "$FF_PG_USER" --if-exists --force "$FF_PG_DB"; then
    # DROP DATABASE either happens or not, but dropdb can fail after it did
    # (a broken connection), so ask what is there now instead of assuming.
    state=$(_restore_db_state) || state=unknown
    if [[ $state == data ]]; then
      FF_DROP_STARTED=""
      _restore_forget_new_record
      _restore_fail "$(_restore_restart)" "The current database could not be removed, so it is unchanged." \
        "the reason is at the end of $FF_LOG. Then run: $FF_RERUN"
    fi
    # Possibly gone: keep the record and keep FreeFrame stopped (on an empty
    # database its setup page would be open to anyone).
    install_fail "The current database could not be replaced, and it may already have been removed." \
      "the reason is at the end of $FF_LOG."
  fi
  FF_STATE="The database has been removed and is not back yet. FreeFrame is stopped, so nothing can write to it. To try again, run: $FF_RERUN${undo:+. To go back to the data as it was before this restore instead, run: $undo_cmd}"
  FF_STEP="creating the database again"
  if ! _ff_logged dc exec -T postgres createdb -U "$FF_PG_USER" -O "$FF_PG_USER" "$FF_PG_DB"; then
    install_fail "The database could not be created again." "the reason is at the end of $FF_LOG."
  fi
  FF_STATE="The database is empty now and FreeFrame is stopped, so nothing can write to it. To try again, run: $FF_RERUN${undo:+. To go back to the data as it was before this restore instead, run: $undo_cmd}"
  FF_STEP="putting the backup back"
  if ! _ff_logged dc exec -T postgres pg_restore -U "$FF_PG_USER" -d "$FF_PG_DB" --no-owner --no-acl --single-transaction <"$dump"; then
    _restore_fail "The database is empty now: the backup goes back in one piece or not at all, so nothing from it was half applied. FreeFrame is stopped, so nothing can write to it. To try again, run: $FF_RERUN${undo:+. To go back to the data as it was before this restore instead, run: $undo_cmd}" \
      "The backup could not be put back into the database." "the reason is at the end of $FF_LOG."
  fi
  # The database is whole again: the record has done its job. The messages
  # below still name this run's copy as the way back.
  _restore_undo_clear
  FF_RESTORE_UNDO=$undo FF_RESTORE_UNDO_CMD=$undo_cmd
}

