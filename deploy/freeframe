# Status, logs and restart (spec goal 14)
# ------------------------------------------------------------

# _ff_disk_line LABEL PATH: used, total and free space of the filesystem
# holding PATH (or its nearest existing parent).
_ff_disk_line() {
  local label=$1 p=$2 u t a
  while [[ ! -e $p && $p != / ]]; do p=$(dirname "$p"); done
  read -r u t a < <(df -Pk "$p" 2>/dev/null | awk 'NR == 2 { print $3, $2, $4 }') || true
  if [[ $u =~ ^[0-9]+$ && $t =~ ^[0-9]+$ && $a =~ ^[0-9]+$ ]]; then
    say "  $label: $(_ff_human_size $((u * 1024))) used of $(_ff_human_size $((t * 1024))), $(_ff_human_size $((a * 1024))) free"
  else
    say "  $label: the free space could not be read"
  fi
}

_ff_mount_of() {
  local p=$1
  while [[ ! -e $p && $p != / ]]; do p=$(dirname "$p"); done
  df -Pk "$p" 2>/dev/null | awk 'NR == 2 { print $6 }'
}

# _status_gpu FILE: where video is processed, as it is in effect: with
# FREEFRAME_GPU=nvidia the worker container itself is asked whether it sees
# the GPU (nvidia-smi -L, as the transcoder checks), and when it does not,
# the reason and the fix are given.
_status_gpu() {
  local file=$1 root out name forced pre="  Video:        "
  root=$(ff_root)
  if [[ $(env_get "$file" FREEFRAME_GPU) != nvidia ]]; then
    detect_gpu
    if _gpu_usable; then
      say "${pre}processed on the CPU. This server's NVIDIA GPU ($FF_GPU_NAME) is not used; to use it, run: sudo freeframe configure"
    else
      _gpu_cpu_reason
      say "${pre}processed on the CPU ($FF_GPU_WHY)"
    fi
    return 0
  fi
  if [[ ! -f $root/docker-compose.gpu.yml ]]; then
    say "${pre}on the CPU: the GPU is chosen (FREEFRAME_GPU=nvidia), but docker-compose.gpu.yml is missing from $root, so the worker runs without it. To fetch it, run: sudo freeframe update"
    return 0
  fi
  if out=$(dc_bounded 30 exec -T worker nvidia-smi -L 2>/dev/null) && [[ $out == "GPU "* ]]; then
    name=$(_gpu_list_name "$out")
    forced=$(_status_gpu_forced_off "$file")
    if [[ -n $forced ]]; then
      say "${pre}processed on the CPU: $forced in $file keeps video off the GPU (the worker sees $name). To use the GPU, delete that line, then run: sudo freeframe restart"
      return 0
    fi
    say "${pre}processed on the GPU ($name), with the CPU as a fallback"
    return 0
  fi
  detect_gpu
  if [[ -z $(dc_bounded 30 ps -q --status running worker 2>/dev/null) ]]; then
    if [[ $FF_GPU_STATE == ready ]]; then
      say "${pre}set to the GPU, but the worker that processes video is not running. Start it with: sudo freeframe restart"
    else
      say "${pre}set to the GPU, but the worker that processes video is not running: $(_status_gpu_why)"
    fi
    return 0
  fi
  say "${pre}on the CPU: the GPU is chosen (FREEFRAME_GPU=nvidia), but the worker does not see it: $(_status_gpu_why)"
}

# _status_gpu_forced_off FILE: the transcoder setting in FILE that keeps
# video off the GPU although the worker has one, as KEY=VALUE (nothing when
# none does). The GPU file sets TRANSCODER_PIPELINE=NVIDIA only when FILE
# leaves it out; under Auto, the older TRANSCODER_BACKEND still decides.
_status_gpu_forced_off() {
  local p b
  p=$(env_get "$1" TRANSCODER_PIPELINE)
  case ${p,,} in
    "" | nvidia) return 0 ;;
    auto)
      b=$(env_get "$1" TRANSCODER_BACKEND)
      case ${b,,} in
        "" | auto | nvenc | nvidia) return 0 ;;
        *) printf 'TRANSCODER_BACKEND=%s' "$b" ;;
      esac
      ;;
    *) printf 'TRANSCODER_PIPELINE=%s' "$p" ;;
  esac
}

# _status_gpu_why: why the worker cannot have the GPU, and the fix.
_status_gpu_why() {
  case $FF_GPU_STATE in
    ready) printf 'Docker can use the GPU now. To start the worker again with the GPU, run: sudo freeframe restart' ;;
    notoolkit | noruntime) printf 'the NVIDIA container toolkit is not set up for Docker. To set it up, run: sudo freeframe configure --yes --gpu nvidia' ;;
    nodriver) printf 'the NVIDIA driver on this server does not answer. To use the GPU, %s' "$(_gpu_driver_hint "run sudo freeframe restart" | tr '\n' ' ')" ;;
    *) printf 'this server has no NVIDIA GPU. To process video on the CPU, run: sudo freeframe configure --yes --gpu off' ;;
  esac
}

cmd_status() {
  local root file ch ver pinned url mode host storage latest line svc state st s found end smtp
  local next timer dir last n bytes undo healthy=0
  local -a all=() rows=() dumps=()
  root=$(ff_root)
  file="$root/.env.prod"
  if ((${#FF_ARGS[@]})); then _ff_bad_usage "freeframe status takes no other words."; fi
  _ff_need_root status
  _ff_need_install
  ch=$(ff_channel "$file")
  _ff_check_channel "$ch"
  ver=$(ff_version)
  pinned=$(env_get "$file" FREEFRAME_VERSION)
  url=$(env_get "$file" FRONTEND_URL)
  host=$(_ff_url_host "$url")
  mode=$(env_get "$file" FREEFRAME_HTTPS)
  mode=${mode:-off}
  storage=$(env_get "$file" FREEFRAME_STORAGE)

  say "FreeFrame on this server"
  if [[ -n $pinned ]]; then
    say "  Version:      $ver (pinned in $file), $ch channel"
  else
    say "  Version:      $ver, from the $ch channel"
  fi
  if latest=$(remote_version "$ch"); then
    if _ff_version_gt "$latest" "$ver"; then
      say "  Updates:      $latest is available on the $ch channel. To move to it, run: sudo freeframe update"
      if [[ -n $pinned ]]; then
        say "                (first delete the FREEFRAME_VERSION line from $file, which keeps this server on $pinned)"
      fi
    elif [[ ! $ver =~ ^v?[0-9] ]]; then
      say "  Updates:      could not read the version this server runs, so it cannot be compared with the $ch channel ($latest)"
    elif _ff_version_gt "$ver" "$latest"; then
      say "  Updates:      none; this server runs $ver, ahead of the $ch channel ($latest)"
      if [[ $ch != latest ]]; then
        say "                To follow the newest releases, run: sudo freeframe update --channel latest"
      fi
    else
      say "  Updates:      none; this is the newest release on the $ch channel"
    fi
  else
    say "  Updates:      Could not check for a newer release (GitHub did not answer)."
  fi
  if _update_undo_read; then
    # The record also stands while an update or a rollback of it runs; the
    # lock tells them apart from one that stopped, not from each other.
    if _ff_lock_busy; then
      say "                A freeframe update or rollback is running right now (the update began ${FF_UNDO_TIME:-a moment ago}). Check again once it has finished."
    else
      say "                An update did not finish. To go back to ${FF_UNDO_VERSION:-the version from before}, run: sudo freeframe rollback"
    fi
  fi
  say "  Web address:  $url"
  if probe_health "$mode" "$host"; then
    healthy=1
    say "  Health:       FreeFrame answers at its web address"
  else
    say "  Health:       FreeFrame does not answer at its web address (see why with: sudo freeframe logs)"
  fi
  if [[ $mode != off ]]; then
    if end=$(cert_expiry "$host"); then
      say "  Certificate:  valid until $end"
    elif ((!healthy)); then
      say "  Certificate:  not checked: FreeFrame's web entrance (Traefik) is not answering. Start it with: sudo freeframe restart"
    else
      say "  Certificate:  not issued yet, so browsers show a warning. Check that the DNS records point here, then run: sudo freeframe restart"
    fi
  fi
  if [[ $storage == bundled ]]; then
    say "  Footage:      kept on this server"
  else
    say "  Footage:      in the S3 bucket $(env_get "$file" S3_BUCKET)"
  fi
  smtp=$(env_get "$file" SMTP_HOST)
  if [[ -n $smtp ]]; then
    say "  Email:        sent through $smtp"
  else
    say "  Email:        not set up, so sign-in codes and invitations are not sent (sudo freeframe configure)"
  fi
  _status_gpu "$file"

  say ""
  say "Parts of FreeFrame:"
  if st=$(dc ps -a --format '{{.Service}}|{{.State}}|{{.Status}}' 2>/dev/null) &&
    s=$(dc config --services 2>/dev/null); then
    mapfile -t rows <<<"$st"
    mapfile -t all <<<"$s"
    for svc in "${all[@]}"; do
      [[ -n $svc ]] || continue
      found=""
      for line in ${rows[@]+"${rows[@]}"}; do
        if [[ ${line%%|*} == "$svc" ]]; then found=$line; fi
      done
      if [[ -n $found ]]; then
        state=${found#*|}
        printf '  %-20s %-9s %s\n' "$svc" "${state%%|*}" "${state#*|}"
      else
        printf '  %-20s %s\n' "$svc" "not created"
      fi
    done
  else
    say "  Docker does not answer, so the state of each part is not known."
    say "  What to try: sudo systemctl start docker, then sudo freeframe restart"
  fi

  say ""
  say "Disk:"
  _ff_disk_line "$root" "$root"
  if [[ $(_ff_mount_of /var/lib/docker) != "$(_ff_mount_of "$root")" ]]; then
    _ff_disk_line "Docker's data (/var/lib/docker)" /var/lib/docker
  fi

  say ""
  say "Backups (of the database, in $root/backups):"
  dir="$root/backups"
  mapfile -t dumps < <(_ff_backup_dumps "$dir")
  n=${#dumps[@]}
  if ((n == 0)); then
    say "  Last:         none yet (to make one now: sudo freeframe backup)"
  else
    last=$(_ff_backup_newest "$dir")
    bytes=$(_ff_size_bytes "$last") || bytes=0
    say "  Last:         $(_ff_stamp_date "${last##*/}") (${last##*/}, $(_ff_human_size "$bytes")); $n kept"
  fi
  timer=$(systemctl show -p ActiveState --value freeframe-backup.timer 2>/dev/null) || timer=""
  if [[ $timer == active ]]; then
    next=$(systemctl show -p NextElapseUSecRealtime --value freeframe-backup.timer 2>/dev/null) || next=""
    say "  Next:         ${next:-tonight at about 3:00}"
  else
    say "  Next:         none: the nightly backup is off. To turn it on, run: sudo systemctl enable --now freeframe-backup.timer"
  fi
  undo=$(_restore_undo_path)
  if [[ -n $undo ]]; then
    say "  A restore did not finish. To go back to the database as it was before it, run: sudo freeframe restore --yes $(_ff_q "$undo")"
  fi
  say "  These backups are on this server only, so they do not survive losing it. Copy them somewhere"
  say "  else now and then; the guide explains how: $FF_GUIDE_URL"
}

# cmd_logs: `freeframe logs [PART]`: the last 200 lines, then new ones as
# they come (Ctrl-C to stop).
cmd_logs() {
  local svc out s ok=0
  local -a all=()
  if ((${#FF_ARGS[@]} > 1)); then
    _ff_bad_usage "freeframe logs takes at most one part of FreeFrame, for example: sudo freeframe logs api"
  fi
  _ff_need_root logs
  _ff_need_install
  svc=${FF_ARGS[0]:-}
  if [[ -z $svc ]]; then
    dc logs -f --tail 200
    return
  fi
  if out=$(dc config --services 2>/dev/null); then
    mapfile -t all <<<"$out"
    for s in "${all[@]}"; do
      if [[ $s == "$svc" ]]; then ok=1; fi
    done
    if ((!ok)); then
      _ff_stop 2 "FreeFrame has no part called '$svc'." "use one of: ${all[*]}; or leave it out to see them all."
    fi
  fi
  dc logs -f --tail 200 "$svc"
}

# _ff_manage_stop CODE MESSAGE WHAT_TO_TRY: _ff_stop, with the lines also in
# install.log (restart does not copy the screen into the log).
_ff_manage_stop() {
  _ff_log_lines "$2" "What to try: $3"
  _ff_stop "$1" "$2" "$3"
}

# cmd_restart: `freeframe restart`: every container recreated from the
# images already here (dc up -d --no-build --force-recreate), then a wait
# until FreeFrame answers. An unfinished restore's undo record is left alone.
cmd_restart() {
  local root url
  root=$(ff_root)
  if ((${#FF_ARGS[@]})); then _ff_bad_usage "freeframe restart takes no other words."; fi
  _ff_need_root restart
  _ff_need_install
  _ff_need_finished_install restart
  FF_ACTOR="the restart"
  _ff_log_open restart
  # The lock first: a restore that is running has the same undo record as
  # one that stopped part-way, and only the lock tells them apart.
  if ! _ff_lock restart; then
    _ff_manage_stop 1 "$FF_BUSY, so FreeFrame was not restarted." \
      "wait a few minutes for it to finish, then run sudo freeframe restart again."
  fi
  _ff_refuse_unfinished_restore restart
  _gpu_start_check
  say "Restarting FreeFrame..."
  if ! _ff_logged dc up -d --no-build --force-recreate; then
    _ff_manage_stop 1 "FreeFrame could not be restarted." \
      "the reason is at the end of ${FF_LOG:-the output above}. Then run sudo freeframe restart again."
  fi
  _uninstall_marker_cancel
  say "Waiting for FreeFrame to finish starting..."
  if ! _ff_wait_for "${FF_API_WAIT:-600}" 5 _ff_logged dc exec -T api curl -fsS http://localhost:8000/health; then
    _ff_manage_stop 1 "FreeFrame was restarted but did not finish starting within $(((${FF_API_WAIT:-600} + 59) / 60)) minutes." \
      "see why with: sudo freeframe logs"
  fi
  # Every container was just created and nothing reloaded systemd, so a
  # worker that does not see the GPU is not created again here.
  FF_STEP="checking that the worker can use the GPU"
  _gpu_worker_check norecreate
  _gpu_worker_say
  url=$(env_get "$root/.env.prod" FRONTEND_URL)
  say "FreeFrame is running again: $url"
}

# ------------------------------------------------------------
# Uninstall
#
# `freeframe uninstall` takes off this server what the installer set up: the
# containers and network of compose project freeframe, the nightly backup,
# $FF_ROOT and the freeframe command, in that order, the command last (this
# script goes on running from the file it has open). Before anything is
# removed it saves a final backup of the database and moves it, every backup
# in $FF_ROOT/backups, install.log and a copy of .env.prod to
# $FF_ROOT_HOME/freeframe-removed-<stamp> (FF_ROOT_HOME is /root; the folder
# is 700, the files 600); when that fails, nothing is removed. The Docker
# volumes (the database, footage kept on this server, the certificates) are
# kept, so the installer run with the saved settings puts FreeFrame back
# with its data. --delete-data deletes them too, once delete is typed (or
# with --yes --confirm-delete-data). Docker, its images, NVIDIA's toolkit,
# the apt sources, swap and ufw rules are left alone, with a word on how to
# remove each. --dry-run prints the plan and changes nothing.
# ------------------------------------------------------------

FF_PROJECT_FILTER=label=com.docker.compose.project=freeframe

_uninstall_home() { printf '%s' "${FF_ROOT_HOME:-/root}"; }

# _uninstall_list container|network|volume: the IDs (names, for volumes,
# sorted) of compose project freeframe's objects, one per line.
_uninstall_list() {
  case $1 in
    container) docker ps -aq --filter "$FF_PROJECT_FILTER" ;;
    network) docker network ls -q --filter "$FF_PROJECT_FILTER" ;;
    volume) docker volume ls -q --filter "$FF_PROJECT_FILTER" | LC_ALL=C sort ;;
  esac
}

# _uninstall_read ARRAY WHAT: _uninstall_list WHAT into ARRAY, without empty
# lines. 1 when Docker did not answer.
_uninstall_read() {
  local -n _ur_arr=$1
  local out line
  _ur_arr=()
  out=$(_uninstall_list "$2" 2>>"${FF_LOG:-/dev/null}") || return 1
  while IFS= read -r line; do
    if [[ -n $line ]]; then _ur_arr+=("$line"); fi
  done <<<"$out"
}

# _uninstall_vol_what NAME: what a volume of the compose files holds.
_uninstall_vol_what() {
  case $1 in
    *_pgdata) printf 'the database' ;;
    *_miniodata) printf 'footage kept on this server' ;;
    *_letsencrypt) printf 'the HTTPS certificates' ;;
    *_redisdata) printf 'the job queue' ;;
    *) printf 'FreeFrame data' ;;
  esac
}

# _ff_and_list WORD...: "a", "a and b", "a, b and c".
_ff_and_list() {
  local out="" i
  for ((i = 1; i <= $#; i++)); do
    if ((i == 1)); then
      out=${!i}
    elif ((i == $#)); then
      out+=" and ${!i}"
    else
      out+=", ${!i}"
    fi
  done
  printf '%s' "$out"
}

# _ff_plural N ONE MANY: "1 backup", "3 backups".
_ff_plural() { if (($1 == 1)); then printf '1 %s' "$2"; else printf '%s %s' "$1" "$3"; fi; }

# _uninstall_units_dir / _uninstall_has_units: the nightly backup's units.
_uninstall_units_dir() { printf '%s' "${FF_SYSTEMD_DIR:-/etc/systemd/system}"; }
_uninstall_has_units() {
  local d
  d=$(_uninstall_units_dir)
  [[ -e $d/freeframe-backup.timer || -e $d/freeframe-backup.service || -L $d/timers.target.wants/freeframe-backup.timer ]]
}

# _uninstall_saved_folders: the folders earlier uninstalls saved their files
# in, oldest first.
_uninstall_saved_folders() {
  local d
  local LC_ALL=C
  for d in "$(_uninstall_home)"/freeframe-removed-*; do
    if [[ -d $d ]]; then printf '%s\n' "$d"; fi
  done
}

# _uninstall_saved_settings: the settings copy the newest uninstall saved.
_uninstall_saved_settings() {
  local d f=""
  while IFS= read -r d; do
    if [[ -f $d/.env.prod ]]; then f=$d/.env.prod; fi
  done < <(_uninstall_saved_folders)
  printf '%s' "$f"
}

# The marker ($FF_ROOT/.uninstall-saved, mode 600), written as soon as the
# final backup and the settings are saved: the folder they are in and the
# final backup's name. A run that finds it finishes an uninstall that
# stopped part-way, in the same folder. Whether that run backs up is decided
# from the server, not the marker: only when the database's volume is gone
# (_uninstall_db_state) is no backup made. It goes with
# .env.prod, and every command that starts FreeFrame again removes it
# (_uninstall_marker_cancel), so it stands only while an uninstall is really
# unfinished. Nothing in it is trusted beyond _uninstall_saved_ok.
_uninstall_marker_file() { printf '%s/.uninstall-saved' "$(ff_root)"; }

# _uninstall_resume: FF_U_RESUME (a marker is there), FF_U_PREV_SAVED and
# FF_U_PREV_FINAL (its folder and final backup's name) and FF_U_PREV_OK (the
# folder is still there).
# _uninstall_saved_name_ok PATH: 0 for a name an uninstall gives its folder:
# $(_uninstall_home)/freeframe-removed-<stamp>, nothing more.
_uninstall_saved_name_ok() {
  [[ ${1%/*} == "$(_uninstall_home)" && ${1##*/} =~ ^freeframe-removed-[0-9]{8}-[0-9]{6}(-[0-9]+)?$ ]]
}

# _uninstall_saved_ok PATH: that, and a real folder (not a symbolic link)
# outside $FF_ROOT.
_uninstall_saved_ok() {
  local p=$1 rr rp
  _uninstall_saved_name_ok "$p" || return 1
  [[ -d $p && ! -L $p ]] || return 1
  rr=$(_ff_real "$(ff_root)") || return 1
  rp=$(_ff_real "$p") || return 1
  [[ $rp != "$rr" && $rp != "$rr"/* ]]
}

# _uninstall_resume: FF_U_RESUME (a marker is there) and what it says:
# FF_U_PREV_SAVED (its folder, only when that is a name an uninstall gives
# its folder), FF_U_PREV_OK (that folder is there and can be used),
# FF_U_PREV_FINAL_NAME (the final backup it names) and FF_U_PREV_FINAL (the
# same, only when it is still in that folder).
_uninstall_resume() {
  local f line saved="" final=""
  f=$(_uninstall_marker_file)
  FF_U_RESUME="" FF_U_PREV_SAVED="" FF_U_PREV_FINAL="" FF_U_PREV_FINAL_NAME="" FF_U_PREV_OK=""
  [[ -f $f ]] || return 0
  FF_U_RESUME=1
  while IFS= read -r line || [[ -n $line ]]; do
    case $line in
      saved=*) saved=${line#saved=} ;;
      final=*) final=${line#final=} ;;
    esac
  done <"$f"
  # Anything else counts as a folder that is gone.
  if _uninstall_saved_name_ok "$saved"; then FF_U_PREV_SAVED=$saved; fi
  if [[ -n $FF_U_PREV_SAVED ]] && _uninstall_saved_ok "$FF_U_PREV_SAVED"; then FF_U_PREV_OK=1; fi
  if [[ $final =~ ^freeframe-[0-9]{8}-[0-9]{6}\.dump$ ]]; then FF_U_PREV_FINAL_NAME=$final; fi
  if [[ -n $FF_U_PREV_OK && -n $FF_U_PREV_FINAL_NAME && -f $FF_U_PREV_SAVED/$FF_U_PREV_FINAL_NAME && ! -L $FF_U_PREV_SAVED/$FF_U_PREV_FINAL_NAME ]]; then
    FF_U_PREV_FINAL=$FF_U_PREV_FINAL_NAME
  fi
  return 0
}

# _uninstall_db_state ROOT: FF_U_DB_GONE when an uninstall that stopped
# part-way has already deleted the database's volume (freeframe_pgdata):
# only then does the run that finishes it make no backup; otherwise it
# backs up as a first run does (an empty database is then passed over, not
# saved). FF_U_SETUP_GONE when the setup files that start the database are
# missing: a backup cannot be made then, so the run stops before removing
# anything (_uninstall_check_backup) unless this run has --skip-backup.
_uninstall_db_state() {
  local root=$1
  FF_U_DB_GONE="" FF_U_SETUP_GONE=""
  if [[ ! -f $root/docker-compose.prod.yml || ! -f $root/docker-compose.images.yml ]]; then FF_U_SETUP_GONE=1; fi
  [[ -n ${FF_U_RESUME:-} ]] || return 0
  if [[ " ${FF_U_VOLUMES[*]} " != *" freeframe_pgdata "* ]]; then FF_U_DB_GONE=1; fi
  return 0
}

# _uninstall_none_words: FF_U_NONE and FF_U_NONE_YET, what has been removed
# so far in the words every failure uses (an earlier run may have removed
# part of FreeFrame already).
_uninstall_none_words() {
  if [[ -n ${FF_U_RESUME:-} ]]; then
    FF_U_NONE="nothing more was removed (an earlier uninstall had already removed part of FreeFrame)"
    FF_U_NONE_YET="An earlier uninstall already removed part of FreeFrame; this run has removed nothing more yet"
  else
    FF_U_NONE="nothing was removed"
    FF_U_NONE_YET="Nothing has been removed yet"
  fi
}

# _uninstall_setup_gone_msg: why no backup can be made while the database's
# setup files are missing, in plain words.
_uninstall_setup_gone_msg() {
  local msg root
  root=$(ff_root)
  msg="The setup files in $root are gone, so FreeFrame's database cannot be backed up"
  if [[ " ${FF_U_VOLUMES[*]} " == *" freeframe_pgdata "* ]]; then
    msg+=", although its volume (freeframe_pgdata) is still there"
  fi
  msg+="."
  if [[ -n ${FF_U_PREV_FINAL:-} ]]; then
    msg+=" The final backup the earlier uninstall made ($FF_U_PREV_FINAL) is in $FF_U_PREV_SAVED."
  fi
  printf '%s' "$msg"
}

# _uninstall_check_backup: a backup that cannot be made stops the run here,
# before anything (more) is removed; only --skip-backup on this run goes on.
_uninstall_check_backup() {
  _uninstall_backup_made || return 0
  [[ -n ${FF_U_SETUP_GONE:-} ]] || return 0
  _uninstall_none_words
  _ff_stop 1 "$(_uninstall_setup_gone_msg) So the uninstall stopped, and $FF_U_NONE." "$(_uninstall_skip_hint)"
}

# _uninstall_skip_hint: the command that goes on without a final backup,
# with this run's --delete-data, and what that means for the database.
_uninstall_skip_hint() {
  if [[ -n ${FF_DELETE_DATA:-} ]]; then
    printf '%s' "to remove FreeFrame without a final backup, run: sudo freeframe uninstall --skip-backup --delete-data. That deletes the database's volume too, with no final backup of it."
  else
    printf '%s' "to remove FreeFrame without a final backup, run: sudo freeframe uninstall --skip-backup (the database stays in its volume unless --delete-data is given too)"
  fi
}
# _uninstall_marker_cancel: FreeFrame was started again, so an uninstall
# that stopped part-way is not unfinished any more: its marker goes, with
# one line (on stderr, as some callers print into a sentence).
_uninstall_marker_cancel() {
  local f saved=""
  f=$(_uninstall_marker_file)
  [[ -f $f ]] || return 0
  saved=$(sed -n 's/^saved=//p' "$f" 2>/dev/null | head -n 1) || saved=""
  _uninstall_saved_ok "$saved" || saved=""
  rm -f -- "$f" || return 0
  warn "An earlier freeframe uninstall that did not finish is cancelled, as FreeFrame is running here again.${saved:+ The backups it saved stay in $saved.}"
  return 0
}

# _uninstall_newest_dump: the backup that is newest by _ff_backup_pick's
# rule in $FF_ROOT/backups and in the earlier uninstall's folder: what the
# summary names to restore once they are in one folder.
_uninstall_newest_dump() {
  _ff_backup_pick "$(ff_root)/backups" "${FF_U_PREV_OK:+$FF_U_PREV_SAVED}"
}
# _uninstall_backup_made: 0 when this run makes a final backup (as far as
# can be told before it tries).
_uninstall_backup_made() { [[ -z ${FF_SKIP_BACKUP:-} && -z ${FF_U_DB_GONE:-} ]]; }

# _uninstall_db_copy: what copy of the database is left once its volume is
# deleted, as it really is.
# _uninstall_dump_count: how many backups there are, in $FF_ROOT/backups and
# in the earlier uninstall's folder (one name counted once).
_uninstall_dump_count() {
  _ff_backup_count "$(ff_root)/backups" "${FF_U_PREV_OK:+$FF_U_PREV_SAVED}"
}
_uninstall_db_copy() {
  local newest name when what
  if _uninstall_backup_made; then
    printf 'a final backup is made first%s, and is then the newest copy of the database' "${FF_U_RESUME:+ (if the database still has data)}"
    return 0
  fi
  newest=$(_uninstall_newest_dump)
  if [[ -z $newest ]]; then
    printf 'no backup of the database exists at all, so nothing can bring it back'
    return 0
  fi
  name=${newest##*/}
  when=$(_ff_stamp_date "$name")
  if [[ $name == "${FF_U_PREV_FINAL:-}" ]]; then
    what="the final backup the earlier uninstall made ($name)"
  elif [[ $name == *-before-rollback.dump ]]; then
    what="the backup $name${when:+ (made $when)}, the database from just before a rollback, from the newer release"
  else
    what="the backup $name${when:+ (made $when)}"
  fi
  if [[ $(_uninstall_dump_count) == 1 ]]; then
    printf 'no final backup is made now, so %s is then the only copy of the database' "$what"
  else
    printf 'no final backup is made now, so the newest copy of the database is %s, and anything changed since then is lost' "$what"
  fi
}
_uninstall_marker_set() {
  local f
  f=$(_uninstall_marker_file)
  (umask 077 && printf 'saved=%s\nfinal=%s\n' "$1" "$2" >"$f.tmp") && chmod 600 "$f.tmp" && mv -f "$f.tmp" "$f"
}

# _ff_real PATH: PATH with symbolic links, . and .. resolved, also when its
# last parts do not exist yet.
_ff_real() {
  local p=$1 rest="" out
  while [[ ! -d $p ]]; do
    rest="/${p##*/}$rest"
    p=$(dirname -- "$p")
  done
  p=$(cd -P -- "$p" && pwd -P) || return 1
  [[ $p != / ]] || p=""
  out="$p$rest"
  printf '%s' "${out:-/}"
}

# _uninstall_root_ok ROOT: 0 for a folder uninstall may remove: an absolute
# path that is not /, not /. or //, and not its own parent once resolved.
_uninstall_root_ok() {
  local root=$1 real parent
  case $root in
    "" | / | /. | // | *"/.."* | [!/]*) return 1 ;;
  esac
  real=$(_ff_real "$root") || return 1
  parent=$(_ff_real "$(dirname -- "$root")") || return 1
  [[ $real != / && $real != "$parent" ]]
}

# _uninstall_check_paths ROOT HOME: refused before anything changes when
# ROOT is not a folder to remove, or HOME (where the backups go) is in it.
_uninstall_check_paths() {
  local root=$1 home=$2 rr rh
  if ! _uninstall_root_ok "$root"; then
    _ff_stop 1 "'$root' is not a folder freeframe uninstall can remove, so nothing was changed." \
      "leave FF_ROOT unset (FreeFrame lives in /opt/freeframe), or set it to the folder FreeFrame was installed in."
  fi
  rr=$(_ff_real "$root")
  rh=$(_ff_real "$home")
  if [[ $rh == "$rr" || $rh == "$rr"/* ]]; then
    _ff_stop 1 "The folder the backups would be saved in ($home) is inside $root, which is removed, so nothing was changed." \
      "leave FF_ROOT_HOME unset (the backups go to /root), or set it to a folder outside $root."
  fi
}

# _uninstall_survey ROOT: what is there to remove and keep: FF_U_CONTAINERS,
# FF_U_NETWORKS and FF_U_VOLUMES (compose project freeframe), FF_U_DUMPS (the
# backups in ROOT/backups), FF_U_LAST (the newest), FF_U_STORAGE and
# FF_U_BUCKET, and FF_U_HAD_UNITS (the nightly backup is there). Stops when
# Docker does not answer.
_uninstall_survey() {
  local root=$1 file=$1/.env.prod
  FF_U_CONTAINERS=() FF_U_NETWORKS=() FF_U_VOLUMES=() FF_U_DUMPS=() FF_U_HAD_UNITS=""
  if _uninstall_has_units; then FF_U_HAD_UNITS=1; fi
  if command -v docker >/dev/null 2>&1; then
    if ! _uninstall_read FF_U_CONTAINERS container || ! _uninstall_read FF_U_NETWORKS network ||
      ! _uninstall_read FF_U_VOLUMES volume; then
      _ff_stop 1 "Docker did not answer, so freeframe uninstall stopped before changing anything." \
        "sudo systemctl start docker, then run the command again."
    fi
  fi
  mapfile -t FF_U_DUMPS < <(_ff_backup_dumps "$root/backups")
  FF_U_LAST=$(_ff_backup_newest "$root/backups")
  FF_U_STORAGE=$(env_get "$file" FREEFRAME_STORAGE)
  FF_U_BUCKET=$(env_get "$file" S3_BUCKET)
}

# _uninstall_check_foreign: never touch a FreeFrame set up by hand. A clone
# in a folder named freeframe shares this install's compose project name and
# volume names, so while one is here neither is removed.
_uninstall_check_foreign() {
  local rc=0
  detect_foreign_install || rc=$?
  case $rc in
    0)
      _ff_stop 3 "This server runs a FreeFrame that was set up by hand, not with this installer. freeframe uninstall does not touch it, so nothing was changed." \
        "remove that FreeFrame by hand, as the guide explains: $FF_GUIDE_URL. While it is here, this command cannot tell the two apart, so it removes neither."
      ;;
    1) ;;
    *) _ff_stop 1 "freeframe uninstall could not check this server for a FreeFrame set up by hand, so it stopped before changing anything." ;;
  esac
}

# _uninstall_nothing ROOT BIN: no FreeFrame from this installer is here.
# Says so, points at what earlier uninstalls kept, and names what an install
# that stopped before writing its settings left behind. Changes nothing.
_uninstall_nothing() {
  local root=$1 bin=$2 d
  local -a left=()
  say "FreeFrame is not installed on this server by this installer (there is no $root/.env.prod), so there is nothing to remove. Nothing was changed."
  while IFS= read -r d; do
    say "An earlier freeframe uninstall saved its backups and settings in $d"
  done < <(_uninstall_saved_folders)
  if [[ -n $(_ff_backup_dumps "$root/backups") ]]; then
    say "$root is still here and holds backups ($root/backups), so it was left as it is."
    return 0
  fi
  # Never offer to delete a FreeFrame set up by hand (a clone in the folder,
  # or one this cannot rule out).
  if [[ -d $root/.git ]]; then return 0; fi
  local rc=0
  detect_foreign_install >/dev/null 2>&1 || rc=$?
  ((rc == 1)) || return 0
  if [[ -d $root ]] && _uninstall_root_ok "$root"; then left+=("$root"); fi
  if [[ -e $bin ]]; then left+=("$bin"); fi
  ((${#left[@]})) || return 0
  local q="" p
  for p in "${left[@]}"; do q+=" $(_ff_q "$p")"; done
  say "Left by an install that stopped before it wrote its settings: $(_ff_and_list "${left[@]}")."
  say "To remove them: sudo rm -rf$q"
}

# _uninstall_notes ROOT: an unfinished restore or update does not stop an
# uninstall (it is a way out of both), but what is lost is said first.
_uninstall_notes() {
  local root=$1 undo
  if [[ -n ${FF_U_RESUME:-} ]]; then
    local where how
    if [[ -n ${FF_U_PREV_OK:-} ]]; then
      where="in $FF_U_PREV_SAVED. This run finishes it and saves into the same folder."
    elif [[ -n ${FF_U_PREV_SAVED:-} ]]; then
      where="in $FF_U_PREV_SAVED, which is no longer there. This run finishes it; anything still in $root/backups and a copy of the settings go to a new folder."
    else
      where="in a folder that is no longer there. This run finishes it; anything still in $root/backups and a copy of the settings go to a new folder."
    fi
    if [[ -n ${FF_U_DB_GONE:-} ]]; then
      how="It makes no new backup: the earlier run already deleted the database's volume (freeframe_pgdata), and starting the database now would only make an empty one."
    elif [[ -n ${FF_SKIP_BACKUP:-} && -n ${FF_U_SETUP_GONE:-} ]]; then
      how="$(_uninstall_setup_gone_msg) With --skip-backup this run goes on without a final backup."
    elif [[ -n ${FF_SKIP_BACKUP:-} ]]; then
      how="FreeFrame's database is still there; with --skip-backup no final backup of it is made."
    elif [[ -n ${FF_U_SETUP_GONE:-} ]]; then
      how="$(_uninstall_setup_gone_msg) So the uninstall stops before removing anything more, unless --skip-backup is given."
    else
      how="FreeFrame's database is still there, so a final backup of it is made first, as in a first run."
    fi
    say "An earlier freeframe uninstall stopped part-way, after it saved the backups and a copy of the settings $where $how"
    say ""
  fi
  # A first run whose setup files are missing (a re-run says it above).
  if [[ -z ${FF_U_RESUME:-} && -n ${FF_U_SETUP_GONE:-} ]] && _uninstall_backup_made; then
    say "$(_uninstall_setup_gone_msg) So the uninstall stops before removing anything, unless --skip-backup is given."
    say ""
  fi
  if [[ -f $(_restore_undo_file) ]]; then
    undo=$(_restore_undo_path)
    if ! _uninstall_backup_made; then
      say "A restore of the database did not finish, so the database may be empty."
    else
      if [[ -n ${FF_U_RESUME:-} ]]; then
        say "A restore of the database did not finish, so the database may be empty. An empty database is not backed up: this run then goes on without a final backup."
      else
        say "A restore of the database did not finish, so the database may be empty. An empty database is not backed up: the uninstall then stops before removing anything, and --skip-backup goes on without a final backup."
      fi
    fi
    if [[ -n $undo && ${undo%/*} == "$root/backups" ]]; then
      say "The copy of the database from before that restore (${undo##*/}) is kept with the other backups."
    elif [[ -n $undo ]]; then
      say "The copy of the database from before that restore is not in the backups folder and is left where it is: $undo"
    fi
    say ""
  fi
  if _update_undo_read; then
    say "An update did not finish. Uninstalling removes its way back to ${FF_UNDO_VERSION:-the version from before} (sudo freeframe rollback): the setup files saved before the update go with $root."
    if [[ $FF_UNDO_PHASE == started ]] && _uninstall_backup_made; then
      say "The final backup is of the database as the update left it."
    fi
    if [[ -f $FF_UNDO_BACKUP && ${FF_UNDO_BACKUP%/*} == "$root/backups" ]]; then
      say "The backup taken just before the update (${FF_UNDO_BACKUP##*/}) is kept with the other backups."
    fi
    say ""
  fi
}

# _uninstall_plan ROOT BIN: what is removed and what is kept, from the
# survey and the options.
_uninstall_plan() {
  local root=$1 bin=$2 v n last_size="" home
  local -a parts=()
  home=$(_uninstall_home)
  say "This removes FreeFrame from this server:"
  n=${#FF_U_CONTAINERS[@]}
  if ((n)); then parts+=("its $(_ff_plural "$n" container containers)"); fi
  if ((${#FF_U_NETWORKS[@]})); then parts+=("its network"); fi
  if ((${#parts[@]})); then say "  - $(_ff_and_list "${parts[@]}") (Docker project freeframe)"; fi
  if _uninstall_has_units; then say "  - the nightly backup (freeframe-backup.timer and freeframe-backup.service)"; fi
  say "  - $root, with the setup files and the settings file in it"
  if [[ -e $bin ]]; then say "  - the freeframe command ($bin)"; fi
  if [[ -n ${FF_DELETE_DATA:-} ]] && ((${#FF_U_VOLUMES[@]})); then
    say "  - FreeFrame's data, deleted for good (--delete-data): its Docker volumes"
    for v in "${FF_U_VOLUMES[@]}"; do printf '      %-24s %s\n' "$v" "$(_uninstall_vol_what "$v")"; done
    if [[ -z ${FF_CONFIRM_DELETE_DATA:-} ]]; then say "    (you are asked to type delete first)"; fi
  fi
  say "It keeps:"
  if [[ -n ${FF_U_PREV_OK:-} ]]; then
    say "  - in $FF_U_PREV_SAVED/ (saved by the earlier uninstall), readable by root only:"
    if [[ -n $FF_U_PREV_FINAL ]]; then
      say "      the final backup the earlier uninstall made: $FF_U_PREV_FINAL"
    elif [[ -n $FF_U_PREV_FINAL_NAME ]]; then
      say "      the final backup the earlier uninstall made ($FF_U_PREV_FINAL_NAME) is no longer there"
    else
      say "      the earlier uninstall made no final backup"
    fi
  else
    say "  - in $home/freeframe-removed-<date>-<time>/, readable by root only:"
  fi
  if [[ -n ${FF_U_DB_GONE:-} ]]; then
    say "      no new backup: the earlier uninstall already deleted the database's volume"
  elif [[ -n ${FF_SKIP_BACKUP:-} ]]; then
    say "      no final backup (--skip-backup)"
  elif [[ -n ${FF_U_SETUP_GONE:-} ]]; then
    say "      no final backup can be made: the setup files that start the database are gone"
    say "      (so the uninstall stops here; --skip-backup goes on without one)"
  else
    if [[ -n $FF_U_LAST ]]; then last_size=$(_ff_human_size "$(_ff_size_bytes "$FF_U_LAST")"); fi
    say "      a final backup of the database, made before anything is removed${FF_U_RESUME:+, if the database still has data}${last_size:+ (the last one was $last_size)}"
  fi
  n=${#FF_U_DUMPS[@]}
  if ((n)); then say "      the $(_ff_plural "$n" backup backups) in $root/backups"; fi
  say "      a copy of the settings file (.env.prod) and install.log"
  if [[ -z ${FF_DELETE_DATA:-} ]] && ((${#FF_U_VOLUMES[@]})); then
    say "  - FreeFrame's data, in its Docker volumes:"
    for v in "${FF_U_VOLUMES[@]}"; do printf '      %-24s %s\n' "$v" "$(_uninstall_vol_what "$v")"; done
  fi
  if [[ $FF_U_STORAGE != bundled && -n $FF_U_BUCKET ]]; then
    say "  - the footage in the S3 bucket $FF_U_BUCKET (it is not touched)"
  fi
  say "  - Docker and its images, and the rest of the server: NVIDIA's toolkit, swap, firewall rules and"
  say "    apt sources are not touched"
}

# _uninstall_left_alone: how to remove what uninstall leaves, each part only
# when it is on this server (Docker always is).
_uninstall_left_alone() {
  say "Left as they are, and how to remove them too if you want:"
  say "  Docker images:     sudo docker image prune -a   (every image no container uses, FreeFrame's among them)"
  say "  Docker:            sudo apt remove docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin"
  say "                     (only if nothing else here uses it), then its apt source, if the installer added it:"
  say "                     sudo rm /etc/apt/sources.list.d/docker.sources /etc/apt/keyrings/docker.asc"
  if _gpu_has_toolkit; then
    say "  NVIDIA's toolkit:  sudo apt remove nvidia-container-toolkit, take the nvidia runtime out of"
    say "                     /etc/docker/daemon.json, then its apt source: sudo rm /etc/apt/sources.list.d/nvidia-container-toolkit.list"
  fi
  if grep -qs '^/swapfile[[:space:]]' "${FF_FSTAB:-/etc/fstab}"; then
    say "  Swap file:         sudo swapoff /swapfile && sudo rm /swapfile /etc/sysctl.d/30-freeframe-swap.conf,"
    say "                     then delete the /swapfile line in /etc/fstab"
  fi
  if ufw_active; then
    say "  Firewall rules:    sudo ufw delete allow 80/tcp && sudo ufw delete allow 443/tcp (keep the SSH rule)"
  fi
}

# _uninstall_typed_ok ANSWER HOST: 0 for the web address (with or without
# http:// or https:// and a trailing slash, in any case) or remove.
_uninstall_typed_ok() {
  local a=${1,,} h=${2,,}
  a=${a#http://}
  a=${a#https://}
  a=${a%/}
  [[ $a == remove || (-n $h && $a == "$h") ]]
}

_uninstall_cancel() {
  say "Uninstall cancelled. Nothing was changed."
  exit 1
}

# _uninstall_ask QUESTION WORD: ask on the terminal; cancel unless the
# answer is WORD (in any case).
_uninstall_ask() {
  local question=$1 answer=""
  ask answer "$question" "" || _uninstall_cancel
  answer=${answer,,}
  [[ $answer == "$2" ]] || _uninstall_cancel
}

# _uninstall_backup: the final backup, with the database started on its own
# when it is not running. Stops with nothing removed when it fails.
_uninstall_backup() {
  local started=""
  local try
  try="fix what the message above says, then run $FF_RERUN again. Or, $(_uninstall_skip_hint)"
  if [[ -n ${FF_U_DB_GONE:-} ]]; then
    if [[ -n ${FF_U_PREV_FINAL:-} ]]; then
      say "No new backup: the earlier uninstall already deleted the database's volume. Its final backup ($FF_U_PREV_FINAL) is kept in $FF_U_PREV_SAVED."
    else
      say "No backup was made: the earlier uninstall already deleted the database's volume, and made no final backup that is still here."
    fi
    _ff_log_lines "uninstall: finishing an earlier uninstall; the database is gone, no new backup"
    return 0
  fi
  if [[ -n ${FF_SKIP_BACKUP:-} ]]; then
    say "No final backup was made (--skip-backup)."
    _ff_log_lines "uninstall: no final backup (--skip-backup)"
    return 0
  fi
  FF_STEP="saving a final backup of the database"
  _ff_pg_names
  if ! _ff_logged dc exec -T postgres pg_isready -U "$FF_PG_USER"; then
    say "Starting FreeFrame's database on its own, to back it up..."
    if ! _ff_logged dc up -d --no-build postgres; then
      _ff_manage_stop 1 "FreeFrame's database could not be started, so no final backup was made and $FF_U_NONE." "$try"
    fi
    started=1
  fi
  # Into a reused folder: never under the name of a backup already there.
  if [[ -n ${FF_U_PREV_OK:-} ]]; then
    while [[ -e $FF_U_PREV_SAVED/freeframe-$(_ff_stamp).dump ]]; do sleep 1; done
  fi
  say "Saving a final backup of the database..."
  # An empty database (a restore that failed part-way) is never saved as
  # the final backup: the backups from before are the ones that count.
  FF_BACKUP_IF_DATA=1 FF_BACKUP_EMPTY=""
  if ! backup_create keep; then
    FF_BACKUP_IF_DATA=""
    if [[ -n $started ]]; then _ff_logged dc stop postgres || true; fi
    if [[ -n $FF_BACKUP_EMPTY && -n ${FF_U_RESUME:-} ]]; then
      say "FreeFrame's database is empty (it has no tables), so no final backup was made of it; this run goes on without one."
      _ff_log_lines "uninstall: the database is empty, no final backup"
      return 0
    fi
    if [[ -n $FF_BACKUP_EMPTY ]]; then
      _ff_manage_stop 1 "FreeFrame's database is empty (it has no tables), so no final backup was made of it, and nothing was removed." \
        "if a restore did not finish, finish it first (sudo freeframe restore). To remove FreeFrame without a final backup instead, run: sudo freeframe uninstall --skip-backup (the backups already here are kept)"
    fi
    _ff_manage_stop 1 "The final backup could not be made, so $FF_U_NONE." "$try"
  fi
  FF_BACKUP_IF_DATA=""
  FF_U_FINAL=$FF_BACKUP_MADE
  say "Saved: ${FF_BACKUP_MADE##*/} ($(_ff_human_size "$(_ff_size_bytes "$FF_BACKUP_MADE")"))"
}

# _uninstall_save ROOT: FF_U_SAVED, the new folder in /root, with every
# backup moved into it, a copy of the settings and install.log (where the
# log goes on from here). Nothing has been removed when this fails.
_uninstall_save() {
  local root=$1 home stamp saved n=1 f
  home=$(_uninstall_home)
  FF_STEP="saving the backups and the settings"
  local -a mine=()
  if [[ -n ${FF_U_PREV_OK:-} ]]; then
    saved=$FF_U_PREV_SAVED
  else
    stamp=$(_ff_stamp)
    saved="$home/freeframe-removed-$stamp"
    while [[ -e $saved ]]; do
      saved="$home/freeframe-removed-$stamp-$n"
      n=$((n + 1))
    done
    if ! { mkdir -p -- "$home" && mkdir -m 700 -- "$saved"; }; then
      install_fail "The folder $saved for the backups and the settings could not be made, so $FF_U_NONE." \
        "check that the disk holding $home is not full or read-only, then run $FF_RERUN again."
    fi
  fi
  FF_U_SAVED=$saved
  FF_STATE="$FF_U_NONE_YET. The backups moved so far are in $saved; any others are still in $root/backups. Running $FF_RERUN again is safe."
  for f in "$root/backups"/* "$root/backups"/.[!.]*; do
    [[ -e $f || -L $f ]] || continue
    if ! mv -f -- "$f" "$saved/"; then
      install_fail "The backups could not all be moved to $saved, so $FF_U_NONE." \
        "check that the disk holding $home is not full, then run $FF_RERUN again."
    fi
    mine+=("$saved/${f##*/}")
  done
  # The newest dump really made: this run's final backup, else the earlier
  # run's when it is still there (else the summary takes the newest).
  if [[ -n ${FF_U_FINAL:-} ]]; then
    FF_U_FINAL="$saved/${FF_U_FINAL##*/}" FF_U_FINAL_EARLIER=""
  elif [[ -n ${FF_U_PREV_FINAL:-} ]]; then
    FF_U_FINAL="$saved/$FF_U_PREV_FINAL" FF_U_FINAL_EARLIER=1
  fi
  if [[ -f $root/.env.prod && ! -f $saved/.env.prod ]]; then
    if ! { (umask 077 && cp -- "$root/.env.prod" "$saved/.env.prod") && chmod 600 "$saved/.env.prod"; }; then
      install_fail "The settings could not be copied to $saved, so $FF_U_NONE." \
        "check that the disk holding $home is not full, then run $FF_RERUN again."
    fi
  fi
  if [[ -f $root/install.log && $FF_LOG == "$root/install.log" ]]; then
    if mv -f -- "$root/install.log" "$saved/install.log"; then
      FF_LOG="$saved/install.log"
      mine+=("$FF_LOG")
    fi
  elif [[ -f $root/install.log ]] && cat -- "$root/install.log" >>"$saved/install.log"; then
    rm -f -- "$root/install.log" || true
  fi
  # Only what this run put there.
  for f in ${mine[@]+"${mine[@]}"}; do
    if [[ -f $f && ! -L $f ]]; then chmod 600 -- "$f" || true; fi
  done
  if ! _uninstall_marker_set "$saved" "${FF_U_FINAL##*/}"; then
    install_fail "Where the backups were saved ($saved) could not be noted in $root, so $FF_U_NONE." \
      "check that the disk is not full, then run $FF_RERUN again."
  fi
  say "Saved the backups and a copy of the settings in $saved"
  FF_STATE="$FF_U_NONE_YET; the backups and a copy of the settings are in $saved. Running $FF_RERUN again is safe."
}

# _uninstall_containers: compose down, with the same files as every other
# command; when they do not parse, by the project's label, as rollback does.
_uninstall_containers() {
  local -a ids=()
  FF_STEP="removing FreeFrame's containers"
  say "Removing FreeFrame's containers and network..."
  if _ff_logged dc config -q; then
    if _ff_logged dc_bounded "${FF_DOWN_WAIT:-300}" down --remove-orphans; then return 0; fi
  elif _uninstall_read ids container &&
    { ((${#ids[@]} == 0)) || _ff_logged docker rm -f "${ids[@]}"; } &&
    _uninstall_read ids network &&
    { ((${#ids[@]} == 0)) || _ff_logged docker network rm "${ids[@]}"; }; then
    return 0
  fi
  install_fail "FreeFrame's containers could not all be removed." \
    "the reason is at the end of $FF_LOG. Then run $FF_RERUN again."
}

# _uninstall_volumes: --delete-data. Every volume of project freeframe, also
# one the current files no longer name (bundled storage given up for S3).
_uninstall_volumes() {
  local -a vols=()
  [[ -n ${FF_DELETE_DATA:-} ]] || return 0
  FF_STEP="deleting FreeFrame's data volumes"
  if ! _uninstall_read vols volume; then
    install_fail "Docker did not say which volumes are FreeFrame's, so none was deleted." \
      "the reason is at the end of $FF_LOG. Then run $FF_RERUN again."
  fi
  ((${#vols[@]})) || return 0
  say "Deleting FreeFrame's data volumes: $(_ff_and_list "${vols[@]}")..."
  if ! _ff_logged docker volume rm "${vols[@]}"; then
    install_fail "FreeFrame's data volumes could not be deleted ($(_ff_and_list "${vols[@]}"))." \
      "the reason is at the end of $FF_LOG. Then run $FF_RERUN again, or delete them yourself: sudo docker volume rm ${vols[*]}"
  fi
  FF_U_DELETED=("${vols[@]}")
}

# _uninstall_timer: the nightly backup's units, turned off and removed.
_uninstall_timer() {
  local d
  d=$(_uninstall_units_dir)
  _uninstall_has_units || return 0
  FF_STEP="removing the nightly backup"
  say "Removing the nightly backup..."
  if ! _ff_logged systemctl disable --now freeframe-backup.timer; then
    warn "The nightly backup timer could not be turned off cleanly; its files are removed anyway. The reason is at the end of $FF_LOG."
  fi
  if ! rm -f -- "$d/freeframe-backup.timer" "$d/freeframe-backup.service" "$d/timers.target.wants/freeframe-backup.timer"; then
    install_fail "The nightly backup's files in $d could not be removed." \
      "check the disk, then run $FF_RERUN again."
  fi
  if ! _ff_logged systemctl daemon-reload; then
    warn "systemd could not be told that the nightly backup is gone (systemctl daemon-reload); it will notice at the next boot."
  fi
  _ff_logged systemctl reset-failed freeframe-backup.timer freeframe-backup.service || true
}

# _uninstall_root ROOT: everything in ROOT, the settings file last, so that
# an uninstall stopped part-way still finds it and can be run again.
# The lock file goes last of all, once the lock has been let go.
_uninstall_root() {
  local root=$1 f
  local -a items=()
  if ! _uninstall_root_ok "$root"; then
    install_fail "'$root' is not a folder freeframe uninstall removes." "remove it yourself."
  fi
  FF_STEP="removing $root"
  say "Removing $root..."
  for f in "$root"/* "$root"/.[!.]* "$root"/..?*; do
    [[ -e $f || -L $f ]] || continue
    case ${f##*/} in
      .env.prod | .installed | .uninstall-saved | .freeframe.lock) ;;
      *) items+=("$f") ;;
    esac
  done
  if ! { { ((${#items[@]} == 0)) || rm -rf -- "${items[@]}"; } &&
    rm -f -- "$root/.installed" && rm -f -- "$root/.env.prod" "$(_uninstall_marker_file)" &&
    _ff_unlock && rm -rf -- "$root"; }; then
    install_fail "$root could not be removed completely." \
      "check the disk, then run $FF_RERUN again (with $root/.env.prod gone, remove what is left with: sudo rm -rf $(_ff_q "$root"))."
  fi
}

# _uninstall_command: the freeframe command, last of all.
_uninstall_command() {
  local dir=${FF_BIN_DIR:-/usr/local/bin}
  if [[ -e $dir/.freeframe.new ]]; then rm -f -- "$dir/.freeframe.new" || true; fi
  [[ -e $dir/freeframe || -L $dir/freeframe ]] || return 0
  FF_STEP="removing the freeframe command"
  if ! rm -f -- "$dir/freeframe"; then
    install_fail "The freeframe command ($dir/freeframe) could not be removed; everything else is." \
      "remove it yourself: sudo rm $(_ff_q "$dir/freeframe")"
  fi
}

# _uninstall_summary ROOT BOOTSTRAP: what was removed, what was kept and
# where, and the next steps.
_uninstall_summary() {
  local root=$1 bootstrap=$2 saved=$FF_U_SAVED v dump label n
  local -a back=() others=()
  say ""
  local -a removed=("its containers and network")
  say "FreeFrame has been removed from this server."
  if [[ -n ${FF_U_RESUME:-} ]]; then say "This finished an uninstall that had stopped part-way."; fi
  if [[ -n ${FF_U_HAD_UNITS:-} ]]; then removed+=("the nightly backup"); fi
  removed+=("$root" "the freeframe command")
  say "Removed: $(_ff_and_list "${removed[@]}")."
  if ((${#FF_U_DELETED[@]})); then
    say "Deleted for good: the Docker volumes $(_ff_and_list "${FF_U_DELETED[@]}")."
  fi
  say ""
  say "Kept in $saved (readable by root only):"
  if [[ -n ${FF_U_FINAL:-} && -n ${FF_U_FINAL_EARLIER:-} ]]; then
    printf '  %-36s %s\n' "${FF_U_FINAL##*/}" "the final backup the earlier uninstall made"
  elif [[ -n ${FF_U_FINAL:-} ]]; then
    printf '  %-36s %s\n' "${FF_U_FINAL##*/}" "the final backup of the database"
  fi
  mapfile -t others < <(_ff_backup_dumps "$saved")
  n=0
  for v in ${others[@]+"${others[@]}"}; do
    if [[ $v != "${FF_U_FINAL:-}" ]]; then n=$((n + 1)); fi
  done
  if ((n)); then printf '  %-36s %s\n' "$(_ff_plural "$n" "earlier backup" "earlier backups")" "each with a copy of the settings it was made with"; fi
  if [[ -f $saved/.env.prod ]]; then printf '  %-36s %s\n' ".env.prod" "a copy of the settings (it holds the passwords)"; fi
  if [[ -f $saved/install.log ]]; then printf '  %-36s %s\n' "install.log" "what the installer and the freeframe command did"; fi
  if ((${#FF_U_DELETED[@]} == 0)) && ((${#FF_U_VOLUMES[@]})); then
    say ""
    say "Kept in Docker, FreeFrame's data volumes:"
    for v in "${FF_U_VOLUMES[@]}"; do printf '  %-24s %s\n' "$v" "$(_uninstall_vol_what "$v")"; done
    # What comes back with them, in the order that matters most.
    for v in pgdata miniodata letsencrypt; do
      if [[ " ${FF_U_VOLUMES[*]} " == *"_$v "* ]]; then back+=("$(_uninstall_vol_what "_$v")"); fi
    done
    say "To delete them later (this cannot be undone):"
    say "  sudo docker volume rm ${FF_U_VOLUMES[*]}"
  fi
  # This run's final backup; otherwise the newest in the folder, which is
  # the earlier run's final one only when nothing newer is there.
  dump="" label="the final backup"
  if [[ -n ${FF_U_FINAL:-} && -z ${FF_U_FINAL_EARLIER:-} ]]; then dump=$FF_U_FINAL; fi
  if [[ -z $dump ]]; then
    dump=$(_ff_backup_newest "$saved")
    label="the newest backup"
    if [[ -n $dump && $dump == "${FF_U_FINAL:-}" ]]; then label="the earlier uninstall's final backup"; fi
  fi
  if [[ -f $saved/.env.prod ]]; then
    say ""
    if ((${#back[@]})); then
      say "To put FreeFrame back later with this data, put the saved settings back and run the installer:"
    else
      say "To set FreeFrame up again with the same settings, put them back and run the installer:"
    fi
    say "  sudo mkdir -p $(_ff_q "$root")"
    say "  sudo install -m 600 $(_ff_q "$saved/.env.prod") $(_ff_q "$root/.env.prod")"
    say "  $bootstrap"
    if ((${#back[@]})); then
      say "It uses the saved settings and the kept volumes, so $(_ff_and_list "${back[@]}") come back."
      say "The database already has its admin account, so none is made: sign in as before (with --yes, no admin answers are needed)."
      if [[ -n $dump ]]; then
        say "If the volumes have been deleted by then, it starts with an empty database; then put $label back:"
        say "  sudo freeframe restore $(_ff_q "$dump")"
      fi
    elif [[ -n $dump ]]; then
      say "It starts with an empty database; then put $label back:"
      say "  sudo freeframe restore $(_ff_q "$dump")"
    fi
    if [[ $FF_U_STORAGE == bundled && -n $dump ]]; then
      if ((${#FF_U_DELETED[@]})); then
        say "A backup holds the database only: footage kept on this server was deleted with its volume."
      else
        say "A backup holds the database only: footage kept on this server is in its Docker volume, not in a backup."
      fi
    fi
  fi
  say ""
  _uninstall_left_alone
  say ""
  say "What this uninstall did is written to $FF_LOG."
}

# cmd_uninstall: `freeframe uninstall [--dry-run] [--skip-backup]
# [--delete-data [--confirm-delete-data]] [--yes]` (see the top of this
# section). The questions come before the lock, so nothing waits on an
# answer; under the lock the install is checked again.
cmd_uninstall() {
  local root file bin home url host answers flags="" bootstrap
  root=$(ff_root)
  file="$root/.env.prod"
  bin="${FF_BIN_DIR:-/usr/local/bin}/freeframe"
  home=$(_uninstall_home)
  FF_U_FINAL="" FF_U_FINAL_EARLIER="" FF_U_SAVED="" FF_U_DELETED=()
  if ((${#FF_ARGS[@]})); then
    _ff_bad_usage "freeframe uninstall takes no other words. To see what it would do, run: sudo freeframe uninstall --dry-run"
  fi
  if [[ -n ${FF_CONFIRM_DELETE_DATA:-} && -z ${FF_DELETE_DATA:-} ]]; then
    _ff_bad_usage "--confirm-delete-data goes with --delete-data, which was not given, so nothing was changed."
  fi
  # In a terminal, delete is always typed; the option is for unattended runs.
  if [[ -n ${FF_CONFIRM_DELETE_DATA:-} && -z ${FF_YES:-} ]]; then
    _ff_bad_usage "--confirm-delete-data is for unattended runs and goes with --yes (sudo freeframe uninstall --yes --delete-data --confirm-delete-data), so nothing was changed. In a terminal, leave it out and type delete when asked."
  fi
  _ff_need_root uninstall
  answers=$(_ff_given_answers)
  if [[ -n $answers ]]; then
    _ff_stop 2 "freeframe uninstall takes no answers ($answers was given), so nothing was changed." \
      "to see what it would do, run: sudo freeframe uninstall --dry-run"
  fi
  if [[ -n ${FF_DELETE_DATA:-} ]]; then flags+=" --delete-data"; fi
  if [[ -n ${FF_SKIP_BACKUP:-} ]]; then flags+=" --skip-backup"; fi
  if [[ ! -f $file && ! -f $root/.installed ]]; then
    _uninstall_nothing "$root" "$bin"
    return 0
  fi
  _uninstall_check_paths "$root" "$home"
  _uninstall_check_foreign
  _uninstall_resume
  url=$(env_get "$file" FRONTEND_URL)
  host=$(_ff_url_host "$url")
  _uninstall_survey "$root"
  _uninstall_db_state "$root"

  if [[ -n ${FF_DRY_RUN:-} ]]; then
    say "Dry run: nothing was changed. This is what sudo freeframe uninstall$flags would do."
    say ""
    _uninstall_notes "$root"
    _uninstall_plan "$root" "$bin"
    say ""
    _uninstall_left_alone
    if _ff_lock_busy; then
      say ""
      say "$FF_BUSY; until it has finished, sudo freeframe uninstall would not start."
    fi
    say ""
    if [[ -n ${FF_U_SETUP_GONE:-} ]] && _uninstall_backup_made; then
      say "To remove FreeFrame without a final backup, run: sudo freeframe uninstall$flags --skip-backup"
    else
      say "To remove FreeFrame, run: sudo freeframe uninstall$flags"
    fi
    return 0
  fi

  # Refused before the explanation when there is no way to answer.
  if [[ -z ${FF_YES:-} ]] && ! _ff_has_tty; then
    _ff_stop 2 "Removing FreeFrame needs a yes, and there is no terminal here to ask." \
      "run it in a terminal, or add --yes: sudo freeframe uninstall --yes$flags (to see first what it does: sudo freeframe uninstall --dry-run$flags)"
  fi
  if [[ -n ${FF_DELETE_DATA:-} && -z ${FF_CONFIRM_DELETE_DATA:-} ]] && ! _ff_has_tty; then
    _ff_stop 2 "--delete-data deletes FreeFrame's data for good, so it asks you to type delete first, and there is no terminal here to ask. Nothing was changed." \
      "to delete it without a question, add --confirm-delete-data: sudo freeframe uninstall --yes --delete-data --confirm-delete-data"
  fi
  _uninstall_check_backup
  _uninstall_notes "$root"
  _uninstall_plan "$root" "$bin"
  say ""
  if [[ -z ${FF_YES:-} ]]; then
    local answer=""
    if [[ -n $host ]]; then
      ask answer "To remove FreeFrame, type its web address ($host) or the word remove" "" || _uninstall_cancel
    else
      ask answer "To remove FreeFrame, type the word remove" "" || _uninstall_cancel
    fi
    _uninstall_typed_ok "$answer" "$host" || _uninstall_cancel
    if [[ -n ${FF_SKIP_BACKUP:-} && -z ${FF_U_DB_GONE:-} ]]; then
      say "No final backup of the database is made (--skip-backup); the backups already here are still kept."
      _uninstall_ask "To go ahead without one, type: no backup" "no backup"
    fi
  fi
  if [[ -n ${FF_DELETE_DATA:-} && -z ${FF_CONFIRM_DELETE_DATA:-} ]]; then
    say "--delete-data deletes FreeFrame's Docker volumes for good; $(_uninstall_db_copy)."
    if [[ $FF_U_STORAGE == bundled ]]; then say "Footage kept on this server is not in any backup: it is gone with them."; fi
    _uninstall_ask "To delete them for good, type: delete" "delete"
  fi

  if ! _ff_lock uninstall; then
    _ff_stop 1 "$FF_BUSY, so the uninstall did not start. Nothing was changed." \
      "wait a few minutes for it to finish, then run sudo freeframe uninstall$flags again."
  fi
  # Another uninstall may have finished while this one asked.
  if [[ ! -f $file && ! -f $root/.installed ]]; then
    say "While this uninstall was getting ready, FreeFrame was removed, so nothing was changed."
    return 0
  fi
  # Read again under the lock: another uninstall may have got further.
  _uninstall_resume
  _uninstall_survey "$root"
  _uninstall_db_state "$root"
  FF_ACTOR="the uninstall"
  FF_STOPPED=()
  FF_ADMIN_CREATED="" FF_PW_GENERATED=""
  FF_RERUN="sudo freeframe uninstall$flags"
  _uninstall_check_backup
  _uninstall_none_words
  FF_STATE="$FF_U_NONE_YET."
  FF_STATE_PREFIX="" FF_RECORD_NEW="" FF_DROP_STARTED="" FF_UPDATE_PHASE=""
  # Read now: it names the channel kept in the settings, which go away.
  bootstrap=$(_ff_bootstrap_cmd)
  bootstrap=${bootstrap% }
  if [[ -n $FF_U_PREV_OK ]]; then
    # The log goes on where the earlier run left it.
    FF_LOG="$FF_U_PREV_SAVED/install.log"
    if (umask 077 && printf '\n===== freeframe uninstall (finishing), %s =====\n' "$(date '+%Y-%m-%d %H:%M:%S %z')" >>"$FF_LOG"); then
      chmod 600 "$FF_LOG" || true
    else
      FF_LOG=""
      _ff_log_open uninstall
    fi
  else
    _ff_log_open uninstall
  fi
  _ff_cmd_traps
  _uninstall_backup
  _uninstall_save "$root"
  _uninstall_containers
  FF_STATE="FreeFrame's containers are removed. The backups and a copy of the settings are in $FF_U_SAVED. Still here: $root, the nightly backup and the freeframe command; running $FF_RERUN again finishes the job."
  _uninstall_volumes
  _uninstall_timer
  FF_STATE="FreeFrame's containers and its nightly backup are removed. The backups and a copy of the settings are in $FF_U_SAVED. Still here: $root and the freeframe command; running $FF_RERUN again finishes the job."
  _uninstall_root "$root"
  FF_STATE="FreeFrame is removed apart from the freeframe command. The backups and a copy of the settings are in $FF_U_SAVED."
  _uninstall_command
  trap - ERR INT TERM HUP
  _ff_log_lines "uninstall: FreeFrame removed; kept in $FF_U_SAVED"
  _uninstall_summary "$root" "$bootstrap"
}

# ------------------------------------------------------------
# Commands
# ------------------------------------------------------------

usage() {
  cat <<'EOF'
freeframe: install and look after FreeFrame on this server.

Usage: sudo freeframe <command> [options]

Commands:
  install     Set up FreeFrame on this server (asks a few questions)
  update      Back up, then move to the newest release on your channel
              (updates this command first; --channel picks another channel)
  rollback    After an update that did not come up: go back to the version
              from before, with the database as it was just before it
  configure   Change the answers you gave (web address, email, storage,
              and whether video is processed on the GPU or the CPU);
              with --yes, give only the new answers as options
  backup      Save a copy of the database to /opt/freeframe/backups now
              (this also runs every night at 3:00; the newest 7 are kept)
  restore     List the backups; restore FILE puts one back (replaces the
              current database, after saving a copy of it)
  status      Show the version, whether everything is running, where video
              is processed (GPU or CPU), disk space, backups and whether a
              newer release is out
  logs        Show FreeFrame's recent messages and follow new ones (Ctrl-C
              stops); logs api shows one part only
  restart     Restart every part of FreeFrame and wait until it answers
  uninstall   Remove FreeFrame from this server: saves a final backup of the
              database first (to /root/freeframe-removed-<date>-<time>) and
              keeps its data (the Docker volumes) unless --delete-data
  help        Show this list

Answers can be given ahead of time as options or environment variables, for
example --domain review.yourstudio.com or FREEFRAME_DOMAIN=review.yourstudio.com.
Options: --domain --https --acme-email --storage --s3-endpoint --s3-bucket
  --s3-access-key --s3-secret-key --s3-region --smtp-host --smtp-port
  --smtp-user --smtp-password --smtp-from --admin-name --admin-email
  --admin-password --channel --gpu --yes
  --gpu       (install, configure) nvidia: process video on this server's
              NVIDIA GPU, setting up NVIDIA's container toolkit if needed
              (the driver must already work); off: on the CPU. Without it,
              install uses a GPU Docker can already use, and asks about one
              it cannot use yet (unattended runs stay on the CPU)
  --quiet     (backup) print nothing unless something goes wrong
  --dry-run   (uninstall) show what would be removed and kept; change nothing
  --skip-backup
              (uninstall) make no final backup of the database
  --delete-data
              (uninstall) also delete FreeFrame's data for good: its Docker
              volumes (the database, footage kept on this server and the
              certificates). Asks you to type delete, even with --yes
  --confirm-delete-data
              (uninstall) with --yes --delete-data: delete without asking,
              for unattended runs (refused without --yes)

Passwords and keys (--admin-password, --smtp-password, --s3-secret-key) are
better given as FREEFRAME_ADMIN_PASSWORD, FREEFRAME_SMTP_PASSWORD and
FREEFRAME_S3_SECRET_KEY, or typed when asked: options on the command line can
be seen by other users of this server (for example with ps), and variables
cannot.
EOF
}

main() {
  # Kept for update, which runs its new copy with the same arguments.
  FF_ORIG_ARGS=("$@")
  parse_args "$@"
  if [[ $FF_CMD != uninstall ]]; then
    local o v
    for o in DRY_RUN DELETE_DATA CONFIRM_DELETE_DATA SKIP_BACKUP; do
      v="FF_$o"
      o=${o,,}
      if [[ -n ${!v:-} ]]; then _ff_bad_usage "--${o//_/-} is an option of freeframe uninstall only."; fi
    done
  fi
  case $FF_CMD in
    help) usage ;;
    install) cmd_install ;;
    backup) cmd_backup ;;
    restore) cmd_restore ;;
    update) cmd_update ;;
    rollback) cmd_rollback ;;
    configure) cmd_configure ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    restart) cmd_restart ;;
    uninstall) cmd_uninstall ;;
    *)
      warn "Unknown command: $FF_CMD"
      warn "What to try: run $(_ff_help_cmd) to see the commands."
      return 2
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if ((BASH_VERSINFO[0] < 4)); then
    echo "freeframe needs bash 4 or newer (this is bash $BASH_VERSION)." >&2
    if [[ $(uname -s 2>/dev/null) == Darwin ]]; then
      echo "It runs on the Linux server (Ubuntu 22.04, 24.04 or 26.04, or Debian 12 or 13), not on a Mac." >&2
      echo "What to try: run it on the server. To run FreeFrame on this Mac, use Docker Desktop and the manual setup: https://github.com/Techiebutler/freeframe/blob/main/docs/deployment.md#quick-setup" >&2
    else
      echo "What to try: run it on the Ubuntu or Debian server, not on this computer." >&2
    fi
    exit 1
  fi
  set -Eeuo pipefail
  main "$@"
fi
